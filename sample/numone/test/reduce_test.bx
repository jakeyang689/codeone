// numone test/reduce — reductions and buffer copies.

extern @numone_sum(a: *f32, n: i32) -> f32
extern @numone_dot(x: *f32, y: *f32, n: i32) -> f32
extern @numone_copy(dst: *f32, src: *f32, n: i32) -> void
extern @numone_fill(a: *f32, n: i32, v: f32) -> void
extern @numone_equal(a: *f32, b: *f32, n: i32) -> i32

extern @numone_report(name: *i8, ok: i32) -> i32
extern @numone_seq(a: *f32, start: f32, step: f32, n: i32) -> void

fun @numone_test_sum() -> i32 {
  @entry:
    %a = let [f32, 4]
    %e = let [f32, 1]
    %ap = gep f32, *%a, 0
    %ep = gep f32, *%e, 0
    call @numone_seq(%ap, 1.0, 1.0, 4)
    call @numone_fill(%ep, 1, 10.0)
    %s = call @numone_sum(%ap, 4)
    %res = let f32
    store f32 %s, *%res
    %ok = call @numone_equal(%res, %ep, 1)
    %r0 = call @numone_report("sum [1,2,3,4]", %ok)
    ret i32 %r0
}

fun @numone_test_dot() -> i32 {
  @entry:
    %x = let [f32, 3]
    %y = let [f32, 3]
    %e = let [f32, 1]
    %xp = gep f32, *%x, 0
    %yp = gep f32, *%y, 0
    %ep = gep f32, *%e, 0
    call @numone_seq(%xp, 10.0, 10.0, 3)
    call @numone_seq(%yp, 1.0, 1.0, 3)
    call @numone_fill(%ep, 1, 140.0)
    %d = call @numone_dot(%xp, %yp, 3)
    %res = let f32
    store f32 %d, *%res
    %ok = call @numone_equal(%res, %ep, 1)
    %r1 = call @numone_report("dot [10,20,30].[1,2,3]", %ok)
    ret i32 %r1
}

fun @numone_test_copy() -> i32 {
  @entry:
    %src = let [f32, 4]
    %dst = let [f32, 4]
    %sp = gep f32, *%src, 0
    %dp = gep f32, *%dst, 0
    call @numone_seq(%sp, 1.0, 1.0, 4)
    call @numone_copy(%dp, %sp, 4)
    %ok = call @numone_equal(%dp, %sp, 4)
    %r2 = call @numone_report("copy 4 elements", %ok)
    ret i32 %r2
}
