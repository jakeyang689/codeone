// Numeric checks for math.bx and nn.bx, against values computed with doubles.
// Each check prints PASS/FAIL; @main returns the failure count.

extern @printf(fmt: *i8, ...) -> i32

extern @llmone_expf(x: f32) -> f32
extern @llmone_logf(x: f32) -> f32
extern @llmone_sqrtf(x: f32) -> f32
extern @llmone_tanhf(x: f32) -> f32
extern @llmone_gelu(x: f32) -> f32
extern @llmone_gelu_bwd(x: f32) -> f32
extern @llmone_softmax(p: *f32, rows: i32, cols: i32) -> void
extern @llmone_ln_stats(x: *f32, rows: i32, cols: i32, inv_n: f32, mean: *f32, rstd: *f32) -> void
extern @llmone_ln_apply(x: *f32, g: *f32, b: *f32, rows: i32, cols: i32, mean: *f32, rstd: *f32, out: *f32) -> void
extern @llmone_ln_bwd(dy: *f32, x: *f32, g: *f32, rows: i32, cols: i32, inv_n: f32, mean: *f32, rstd: *f32, dx: *f32, dg: *f32, db: *f32) -> void
extern @llmone_ce(logits: *f32, tgt: *i32, rows: i32, cols: i32, dlogits: *f32, loss: *f32) -> void
extern @llmone_causal_mask(p: *f32, rows: i32, cols: i32) -> void

fun @near(a: f32, b: f32, eps: f32) -> i32 {
  @entry:
    %d = sub f32 %a, %b
    %neg = slt f32 %d, 0.0
    br %neg, @flip, @cmp

  @flip:
    %z = sub f32 0.0, %d
    %ok0 = slt f32 %z, %eps
    br %ok0, @yes, @no

  @cmp:
    %ok1 = slt f32 %d, %eps
    br %ok1, @yes, @no

  @yes:
    ret i32 1

  @no:
    ret i32 0
}

fun @report(name: *i8, ok: i32) -> i32 {
  @entry:
    %pass = eq i32 %ok, 1
    br %pass, @p, @f

  @p:
    call @printf("PASS %s\n", %name)
    ret i32 0

  @f:
    call @printf("FAIL %s\n", %name)
    ret i32 1
}

fun @main() -> i32 {
  @entry:
    %fails = let i32
    %x3 = let [f32, 3]
    %x6 = let [f32, 6]
    %mean = let [f32, 2]
    %rstd = let [f32, 2]
    %out6 = let [f32, 6]
    %g3 = let [f32, 3]
    %b3 = let [f32, 3]
    %dy3 = let [f32, 3]
    %dx3 = let [f32, 3]
    %dg3 = let [f32, 3]
    %db3 = let [f32, 3]
    %logits = let [f32, 4]
    %tgt = let [i32, 2]
    %dl = let [f32, 4]
    %loss = let f32
    %cm = let [f32, 9]
    store i32 0, *%fails

    // ---- expf ----
    %e0 = call @llmone_expf(0.0)
    %e0o = call @near(%e0, 1.0, 0.00001)
    %f0 = call @report("exp(0)", %e0o)
    %nv0 = load i32, *%fails
    %nf0 = add i32 %nv0, %f0
    store i32 %nf0, *%fails

    %e1 = call @llmone_expf(1.0)
    %e1o = call @near(%e1, 2.7182818, 0.0001)
    %f1 = call @report("exp(1)", %e1o)
    %nv1 = load i32, *%fails
    %nf1 = add i32 %nv1, %f1
    store i32 %nf1, *%fails

    %e2 = call @llmone_expf(-1.0)
    %e2o = call @near(%e2, 0.3678794, 0.0001)
    %f2 = call @report("exp(-1)", %e2o)
    %nv2 = load i32, *%fails
    %nf2 = add i32 %nv2, %f2
    store i32 %nf2, *%fails

    %e3 = call @llmone_expf(5.0)
    %e3o = call @near(%e3, 148.41316, 0.01)
    %f3 = call @report("exp(5)", %e3o)
    %nv3 = load i32, *%fails
    %nf3 = add i32 %nv3, %f3
    store i32 %nf3, *%fails

    // ---- logf ----
    %l0 = call @llmone_logf(1.0)
    %l0o = call @near(%l0, 0.0, 0.00001)
    %lf0 = call @report("log(1)", %l0o)
    %nv4 = load i32, *%fails
    %nf4 = add i32 %nv4, %lf0
    store i32 %nf4, *%fails

    %l1 = call @llmone_logf(10.0)
    %l1o = call @near(%l1, 2.3025851, 0.0001)
    %lf1 = call @report("log(10)", %l1o)
    %nv5 = load i32, *%fails
    %nf5 = add i32 %nv5, %lf1
    store i32 %nf5, *%fails

    %l2 = call @llmone_logf(0.5)
    %l2o = call @near(%l2, -0.6931472, 0.0001)
    %lf2 = call @report("log(0.5)", %l2o)
    %nv6 = load i32, *%fails
    %nf6 = add i32 %nv6, %lf2
    store i32 %nf6, *%fails

    %l3 = call @llmone_logf(2.7182818)
    %l3o = call @near(%l3, 1.0, 0.0001)
    %lf3 = call @report("log(e)", %l3o)
    %nv7 = load i32, *%fails
    %nf7 = add i32 %nv7, %lf3
    store i32 %nf7, *%fails

    // ---- sqrtf ----
    %s0 = call @llmone_sqrtf(4.0)
    %s0o = call @near(%s0, 2.0, 0.000001)
    %sf0 = call @report("sqrt(4)", %s0o)
    %nv8 = load i32, *%fails
    %nf8 = add i32 %nv8, %sf0
    store i32 %nf8, *%fails

    %s1 = call @llmone_sqrtf(2.0)
    %s1o = call @near(%s1, 1.4142136, 0.000001)
    %sf1 = call @report("sqrt(2)", %s1o)
    %nv9 = load i32, *%fails
    %nf9 = add i32 %nv9, %sf1
    store i32 %nf9, *%fails

    %s2 = call @llmone_sqrtf(0.25)
    %s2o = call @near(%s2, 0.5, 0.000001)
    %sf2 = call @report("sqrt(0.25)", %s2o)
    %nv10 = load i32, *%fails
    %nf10 = add i32 %nv10, %sf2
    store i32 %nf10, *%fails

    // ---- tanhf / gelu ----
    %t0 = call @llmone_tanhf(1.0)
    %t0o = call @near(%t0, 0.7615942, 0.0001)
    %tf0 = call @report("tanh(1)", %t0o)
    %nv11 = load i32, *%fails
    %nf11 = add i32 %nv11, %tf0
    store i32 %nf11, *%fails

    %t1 = call @llmone_tanhf(-3.0)
    %t1o = call @near(%t1, -0.9950547, 0.0001)
    %tf1 = call @report("tanh(-3)", %t1o)
    %nv12 = load i32, *%fails
    %nf12 = add i32 %nv12, %tf1
    store i32 %nf12, *%fails

    %g0 = call @llmone_gelu(1.0)
    %g0o = call @near(%g0, 0.8411920, 0.0001)
    %gf0 = call @report("gelu(1)", %g0o)
    %nv13 = load i32, *%fails
    %nf13 = add i32 %nv13, %gf0
    store i32 %nf13, *%fails

    %g1 = call @llmone_gelu(-1.0)
    %g1o = call @near(%g1, -0.1588080, 0.0001)
    %gf1 = call @report("gelu(-1)", %g1o)
    %nv14 = load i32, *%fails
    %nf14 = add i32 %nv14, %gf1
    store i32 %nf14, *%fails

    %g2 = call @llmone_gelu_bwd(0.0)
    %g2o = call @near(%g2, 0.5, 0.0001)
    %gf2 = call @report("gelu'(0)", %g2o)
    %nv15 = load i32, *%fails
    %nf15 = add i32 %nv15, %gf2
    store i32 %nf15, *%fails

    // ---- softmax of [1, 2, 3] ----
    %x30 = gep f32, *%x3, 0
    %x31 = gep f32, *%x3, 1
    %x32 = gep f32, *%x3, 2
    store f32 1.0, *%x30
    store f32 2.0, *%x31
    store f32 3.0, *%x32
    call @llmone_softmax(%x3, 1, 3)
    %p0 = load f32, *%x30
    %p1 = load f32, *%x31
    %p2 = load f32, *%x32
    %p0o = call @near(%p0, 0.09003057, 0.00001)
    %p1o = call @near(%p1, 0.24472847, 0.00001)
    %p2o = call @near(%p2, 0.66524096, 0.00001)
    %pm = mul i32 %p0o, %p1o
    %pm2 = mul i32 %pm, %p2o
    %smf = call @report("softmax", %pm2)
    %nv16 = load i32, *%fails
    %nf16 = add i32 %nv16, %smf
    store i32 %nf16, *%fails

    // ---- layernorm stats on rows [1,2,3] and [4,5,6] ----
    %y0 = gep f32, *%x6, 0
    %y1 = gep f32, *%x6, 1
    %y2 = gep f32, *%x6, 2
    %y3 = gep f32, *%x6, 3
    %y4 = gep f32, *%x6, 4
    %y5 = gep f32, *%x6, 5
    store f32 1.0, *%y0
    store f32 2.0, *%y1
    store f32 3.0, *%y2
    store f32 4.0, *%y3
    store f32 5.0, *%y4
    store f32 6.0, *%y5
    call @llmone_ln_stats(%x6, 2, 3, 0.33333333, %mean, %rstd)
    %m0p = gep f32, *%mean, 0
    %m1p = gep f32, *%mean, 1
    %r0p = gep f32, *%rstd, 0
    %r1p = gep f32, *%rstd, 1
    %mv0 = load f32, *%m0p
    %mv1 = load f32, *%m1p
    %rv0 = load f32, *%r0p
    %rv1 = load f32, *%r1p
    %mo0 = call @near(%mv0, 2.0, 0.00001)
    %mo1 = call @near(%mv1, 5.0, 0.00001)
    %ro0 = call @near(%rv0, 1.2247449, 0.0001)
    %ro1 = call @near(%rv1, 1.2247449, 0.0001)
    %mm = mul i32 %mo0, %mo1
    %mm2 = mul i32 %mm, %ro0
    %mm3 = mul i32 %mm2, %ro1
    %lnf = call @report("ln_stats", %mm3)
    %nv17 = load i32, *%fails
    %nf17 = add i32 %nv17, %lnf
    store i32 %nf17, *%fails

    // ---- layernorm apply with g=1, b=0 ----
    %gv0 = gep f32, *%g3, 0
    %gv1 = gep f32, *%g3, 1
    %gv2 = gep f32, *%g3, 2
    store f32 1.0, *%gv0
    store f32 1.0, *%gv1
    store f32 1.0, *%gv2
    %bv0 = gep f32, *%b3, 0
    %bv1 = gep f32, *%b3, 1
    %bv2 = gep f32, *%b3, 2
    store f32 0.0, *%bv0
    store f32 0.0, *%bv1
    store f32 0.0, *%bv2
    call @llmone_ln_apply(%x6, %g3, %b3, 2, 3, %mean, %rstd, %out6)
    %o0p = gep f32, *%out6, 0
    %o2p = gep f32, *%out6, 2
    %o3p = gep f32, *%out6, 3
    %o0 = load f32, *%o0p
    %o2 = load f32, *%o2p
    %o3 = load f32, *%o3p
    %oa = call @near(%o0, -1.2247449, 0.0001)
    %ob = call @near(%o2, 1.2247449, 0.0001)
    %oc = call @near(%o3, -1.2247449, 0.0001)
    %om = mul i32 %oa, %ob
    %om2 = mul i32 %om, %oc
    %lnf2 = call @report("ln_apply", %om2)
    %nv18 = load i32, *%fails
    %nf18 = add i32 %nv18, %lnf2
    store i32 %nf18, *%fails

    // ---- layernorm backward: one row [1,2,3], dy=[1,2,3], g=1 ----
    %d0 = gep f32, *%dy3, 0
    %d1 = gep f32, *%dy3, 1
    %d2 = gep f32, *%dy3, 2
    store f32 1.0, *%d0
    store f32 0.0, *%d1
    store f32 3.0, *%d2
    %zg0 = gep f32, *%dg3, 0
    %zg1 = gep f32, *%dg3, 1
    %zg2 = gep f32, *%dg3, 2
    store f32 0.0, *%zg0
    store f32 0.0, *%zg1
    store f32 0.0, *%zg2
    %zb0 = gep f32, *%db3, 0
    %zb1 = gep f32, *%db3, 1
    %zb2 = gep f32, *%db3, 2
    store f32 0.0, *%zb0
    store f32 0.0, *%zb1
    store f32 0.0, *%zb2
    store f32 1.0, *%x30
    store f32 2.0, *%x31
    store f32 3.0, *%x32
    call @llmone_ln_bwd(%dy3, %x3, %g3, 1, 3, 0.33333333, %mean, %rstd, %dx3, %dg3, %db3)
    %q0p = gep f32, *%dx3, 0
    %q1p = gep f32, *%dx3, 1
    %q2p = gep f32, *%dx3, 2
    %q0 = load f32, *%q0p
    %q1 = load f32, *%q1p
    %q2 = load f32, *%q2p
    %qa = call @near(%q0, 0.816488, 0.0001)
    %qb = call @near(%q1, -1.632976, 0.0001)
    %qc = call @near(%q2, 0.816488, 0.0001)
    %qm = mul i32 %qa, %qb
    %qm2 = mul i32 %qm, %qc
    %qg0 = load f32, *%zg0
    %qg1 = load f32, *%zg1
    %qg2 = load f32, *%zg2
    %qga = call @near(%qg0, -1.2247321, 0.0001)
    %qgb = call @near(%qg1, 0.0, 0.0001)
    %qgc = call @near(%qg2, 3.6741963, 0.0001)
    %qgm = mul i32 %qga, %qgb
    %qgm2 = mul i32 %qgm, %qgc
    %qb0 = load f32, *%zb0
    %qb1 = load f32, *%zb1
    %qb2 = load f32, *%zb2
    %qba = call @near(%qb0, 1.0, 0.00001)
    %qbb = call @near(%qb1, 0.0, 0.00001)
    %qbc = call @near(%qb2, 3.0, 0.00001)
    %qbm = mul i32 %qba, %qbb
    %qbm2 = mul i32 %qbm, %qbc
    %qall0 = mul i32 %qm2, %qgm2
    %qall = mul i32 %qall0, %qbm2
    %lnf3 = call @report("ln_bwd", %qall)
    %nv19 = load i32, *%fails
    %nf19 = add i32 %nv19, %lnf3
    store i32 %nf19, *%fails

    // ---- cross entropy on all-zero logits, 2 rows, 2 classes ----
    %lp0 = gep f32, *%logits, 0
    %lp1 = gep f32, *%logits, 1
    %lp2 = gep f32, *%logits, 2
    %lp3 = gep f32, *%logits, 3
    store f32 0.0, *%lp0
    store f32 0.0, *%lp1
    store f32 0.0, *%lp2
    store f32 0.0, *%lp3
    %t0p = gep i32, *%tgt, 0
    %t1p = gep i32, *%tgt, 1
    store i32 0, *%t0p
    store i32 1, *%t1p
    store f32 0.0, *%loss
    call @llmone_ce(%logits, %tgt, 2, 2, %dl, %loss)
    %lv = load f32, *%loss
    %lo = call @near(%lv, 1.3862944, 0.0001)
    %dl0p = gep f32, *%dl, 0
    %dl1p = gep f32, *%dl, 1
    %dl0 = load f32, *%dl0p
    %dl1 = load f32, *%dl1p
    %do0 = call @near(%dl0, -0.5, 0.00001)
    %do1 = call @near(%dl1, 0.5, 0.00001)
    %dom = mul i32 %do0, %do1
    %com = mul i32 %lo, %dom
    %cef = call @report("cross_entropy", %com)
    %nv20 = load i32, *%fails
    %nf20 = add i32 %nv20, %cef
    store i32 %nf20, *%fails

    // ---- causal mask on a 3x3 score matrix ----
    %cm0 = gep f32, *%cm, 0
    %cm1 = gep f32, *%cm, 1
    %cm2 = gep f32, *%cm, 2
    %cm3 = gep f32, *%cm, 3
    %cm4 = gep f32, *%cm, 4
    %cm5 = gep f32, *%cm, 5
    %cm6 = gep f32, *%cm, 6
    %cm7 = gep f32, *%cm, 7
    %cm8 = gep f32, *%cm, 8
    store f32 1.0, *%cm0
    store f32 2.0, *%cm1
    store f32 3.0, *%cm2
    store f32 4.0, *%cm3
    store f32 5.0, *%cm4
    store f32 6.0, *%cm5
    store f32 7.0, *%cm6
    store f32 8.0, *%cm7
    store f32 9.0, *%cm8
    call @llmone_causal_mask(%cm, 3, 3)
    %cma = load f32, *%cm0
    %cmb = load f32, *%cm1
    %cmc = load f32, *%cm2
    %cmd = load f32, *%cm3
    %cme = load f32, *%cm4
    %cmf = load f32, *%cm5
    %cmg = load f32, *%cm6
    %cmh = load f32, *%cm7
    %cmi = load f32, *%cm8
    %ck0 = call @near(%cma, 1.0, 0.00001)
    %ck1 = call @near(%cmb, -1000000.0, 0.5)
    %ck2 = call @near(%cmc, -1000000.0, 0.5)
    %ck3 = call @near(%cmd, 4.0, 0.00001)
    %ck4 = call @near(%cme, 5.0, 0.00001)
    %ck5 = call @near(%cmf, -1000000.0, 0.5)
    %ck6 = call @near(%cmg, 7.0, 0.00001)
    %ck7 = call @near(%cmh, 8.0, 0.00001)
    %cki = call @near(%cmi, 9.0, 0.00001)
    %ckm0 = mul i32 %ck0, %ck1
    %ckm1 = mul i32 %ckm0, %ck2
    %ckm2 = mul i32 %ckm1, %ck3
    %ckm3 = mul i32 %ckm2, %ck4
    %ckm4 = mul i32 %ckm3, %ck5
    %ckm5 = mul i32 %ckm4, %ck6
    %ckm6 = mul i32 %ckm5, %ck7
    %ckm7 = mul i32 %ckm6, %cki
    %ckr = call @report("causal_mask", %ckm7)
    %nv21 = load i32, *%fails
    %nf21 = add i32 %nv21, %ckr
    store i32 %nf21, *%fails

    %fv = load i32, *%fails
    call @printf("kernel_test: %d failure(s)\n", %fv)
    ret i32 %fv
}
