// vfs.bx - path resolution, file descriptor table, dispatch to the ramfs backend

extern @ramfs_init() -> void
extern @ramfs_root() -> i32
extern @ramfs_lookup(parent: i32, name: *i8) -> i32
extern @ramfs_create(parent: i32, name: *i8, type: i32) -> i32
extern @ramfs_read(ino: i32, off: i64, buf: *i8, len: i64) -> i64
extern @ramfs_write(ino: i32, off: i64, buf: *i8, len: i64) -> i64
extern @ramfs_readdir(dir: i32, idx: i32) -> i32
extern @ramfs_get_name(ino: i32) -> *i8
extern @ramfs_type(ino: i32) -> i32
extern @ramfs_size(ino: i32) -> i64
extern @ramfs_remove(ino: i32) -> i32
extern @ramfs_rename(ino: i32, newparent: i32, newname: *i8) -> i32

const @vfs_FILE: i32 = 1
const @vfs_DIR: i32 = 2

// 0 used, 1 ino, 2 off, 3 flags
struct @vfs_Fd {
  @used: i32,
  @ino: i32,
  @off: i64,
  @flags: i32
}

struct @vfs_Table {
  @fds: [@vfs_Fd, 16],
  @inited: i32
}

global @vfs_table: @vfs_Table

fun @vfs_fd(fd: i32) -> *@vfs_Fd {
  @entry:
    %arr = field @vfs_Table, *@vfs_table, 0
    %p = gep @vfs_Fd, *%arr, %fd
    ret *@vfs_Fd %p
}

fun @vfs_init() -> void {
  @entry:
    call @ramfs_init()
    %i = let i32
    store i32 0, *%i
    jmp @cond
  @cond:
    %iv = load i32, *%i
    %done = sge i32 %iv, 16
    br %done, @end, @body
  @body:
    %fp = call @vfs_fd(%iv)
    %up = field @vfs_Fd, *%fp, 0
    store i32 0, *%up
    %n = add i32 %iv, 1
    store i32 %n, *%i
    jmp @cond
  @end:
    ret void
}

fun @vfs_alloc_fd(ino: i32, flags: i32) -> i32 {
  @entry:
    %i = let i32
    store i32 0, *%i
    jmp @cond
  @cond:
    %iv = load i32, *%i
    %over = sge i32 %iv, 16
    br %over, @none, @body
  @body:
    %fp = call @vfs_fd(%iv)
    %up = field @vfs_Fd, *%fp, 0
    %uv = load i32, *%up
    %free = eq i32 %uv, 0
    br %free, @take, @next
  @take:
    %fp2 = call @vfs_fd(%iv)
    %u2 = field @vfs_Fd, *%fp2, 0
    store i32 1, *%u2
    %ip = field @vfs_Fd, *%fp2, 1
    store i32 %ino, *%ip
    %op = field @vfs_Fd, *%fp2, 2
    store i64 0, *%op
    %gp = field @vfs_Fd, *%fp2, 3
    store i32 %flags, *%gp
    ret i32 %iv
  @next:
    %n = add i32 %iv, 1
    store i32 %n, *%i
    jmp @cond
  @none:
    ret i32 -1
}

fun @vfs_lookup(path: *i8) -> i32 {
  @entry:
    %buf = let [i8, 32]
    %i = let i32
    %j = let i32
    %cur = let i32
    store i32 0, *%i
    store i32 0, *%j
    %root = call @ramfs_root()
    store i32 %root, *%cur
    jmp @cond
  @cond:
    %iv = load i32, *%i
    %cp = gep i8, *%path, %iv
    %ch = load i8, *%cp
    %end = eq i8 %ch, 0
    br %end, @done, @body
  @body:
    %isslash = eq i8 %ch, 47
    br %isslash, @skip, @comp
  @skip:
    %n = add i32 %iv, 1
    store i32 %n, *%i
    jmp @cond
  @comp:
    store i32 0, *%j
    jmp @copy_cond
  @copy_cond:
    %jv = load i32, *%j
    %over = sge i32 %jv, 31
    br %over, @copy_end, @copy_chk
  @copy_chk:
    %iv2 = load i32, *%i
    %cp2 = gep i8, *%path, %iv2
    %ch2 = load i8, *%cp2
    %z = eq i8 %ch2, 0
    br %z, @copy_end, @chk_slash
  @chk_slash:
    %sl = eq i8 %ch2, 47
    br %sl, @copy_end, @copy_byte
  @copy_byte:
    %bp = gep i8, *%buf, %jv
    store i8 %ch2, *%bp
    %jn = add i32 %jv, 1
    store i32 %jn, *%j
    %in2 = add i32 %iv2, 1
    store i32 %in2, *%i
    jmp @copy_cond
  @copy_end:
    %jv2 = load i32, *%j
    %tp = gep i8, *%buf, %jv2
    store i8 0, *%tp
    %empty = eq i32 %jv2, 0
    br %empty, @done, @look
  @look:
    %bufp = gep i8, *%buf, 0
    %curv = load i32, *%cur
    %found = call @ramfs_lookup(%curv, %bufp)
    %nf = slt i32 %found, 0
    br %nf, @miss, @hit
  @hit:
    store i32 %found, *%cur
    jmp @cond
  @miss:
    ret i32 -1
  @done:
    %rv = load i32, *%cur
    ret i32 %rv
}

// Split path before its final component: copy the parent prefix into pbuf and
// return the index of the final '/', or -1 when path has no '/'.
fun @vfs_split(path: *i8, pbuf: *i8) -> i32 {
  @entry:
    %i = let i32
    %last = let i32
    %k = let i32
    store i32 0, *%i
    store i32 -1, *%last
    jmp @scan
  @scan:
    %iv = load i32, *%i
    %cp = gep i8, *%path, %iv
    %ch = load i8, *%cp
    %end = eq i8 %ch, 0
    br %end, @scan_done, @scan_body
  @scan_body:
    %sl = eq i8 %ch, 47
    br %sl, @mark, @next
  @mark:
    store i32 %iv, *%last
    jmp @next
  @next:
    %n = add i32 %iv, 1
    store i32 %n, *%i
    jmp @scan
  @scan_done:
    %lv = load i32, *%last
    %none = slt i32 %lv, 0
    br %none, @ret, @copy_init
  @copy_init:
    store i32 0, *%k
    jmp @copy_cond
  @copy_cond:
    %kv = load i32, *%k
    %lv2 = load i32, *%last
    %done = sge i32 %kv, %lv2
    br %done, @copy_end, @copy_body
  @copy_body:
    %sp = gep i8, *%path, %kv
    %c = load i8, *%sp
    %dp = gep i8, *%pbuf, %kv
    store i8 %c, *%dp
    %kn = add i32 %kv, 1
    store i32 %kn, *%k
    jmp @copy_cond
  @copy_end:
    %kv2 = load i32, *%k
    %tp = gep i8, *%pbuf, %kv2
    store i8 0, *%tp
    jmp @ret
  @ret:
    %rv = load i32, *%last
    ret i32 %rv
}

// Returns 0 on success, -1 not found, -2 not empty, -3 invalid path.
fun @vfs_remove(path: *i8) -> i32 {
  @entry:
    %pbuf = let [i8, 128]
    %pb = gep i8, *%pbuf, 0
    %last = call @vfs_split(%path, %pb)
    %nolast = slt i32 %last, 0
    br %nolast, @invalid, @chkname
  @chkname:
    %ni = add i32 %last, 1
    %name = gep i8, *%path, %ni
    %nc = load i8, *%name
    %empty = eq i8 %nc, 0
    br %empty, @invalid, @parent
  @parent:
    %isroot = eq i32 %last, 0
    br %isroot, @useroot, @lookup
  @useroot:
    %r = call @ramfs_root()
    jmp @gotparent
  @lookup:
    %p2 = call @vfs_lookup(%pb)
    jmp @gotparent
  @gotparent:
    %parent = phi i32 [%r, @useroot], [%p2, @lookup]
    %pbad = slt i32 %parent, 0
    br %pbad, @notfound, @lookupchild
  @lookupchild:
    %ino = call @ramfs_lookup(%parent, %name)
    %missing = slt i32 %ino, 0
    br %missing, @notfound, @remove
  @remove:
    %rc = call @ramfs_remove(%ino)
    ret i32 %rc
  @invalid:
    ret i32 -3
  @notfound:
    ret i32 -1
}

// Returns 0 on success, -1 source or target parent missing, -2 target exists,
// -3 invalid path or a directory moved into its own subtree.
fun @vfs_rename(oldpath: *i8, newpath: *i8) -> i32 {
  @entry:
    %obuf = let [i8, 128]
    %nbuf = let [i8, 128]
    %opb = gep i8, *%obuf, 0
    %olast = call @vfs_split(%oldpath, %opb)
    %obad = slt i32 %olast, 0
    br %obad, @invalid, @ochk
  @ochk:
    %oni = add i32 %olast, 1
    %oname = gep i8, *%oldpath, %oni
    %onc = load i8, *%oname
    %onempty = eq i8 %onc, 0
    br %onempty, @invalid, @oparent
  @oparent:
    %oroot = eq i32 %olast, 0
    br %oroot, @orootv, @olookup
  @orootv:
    %orr = call @ramfs_root()
    jmp @ogot
  @olookup:
    %opv = call @vfs_lookup(%opb)
    jmp @ogot
  @ogot:
    %oparent = phi i32 [%orr, @orootv], [%opv, @olookup]
    %opbad = slt i32 %oparent, 0
    br %opbad, @notfound, @ochild
  @ochild:
    %sino = call @ramfs_lookup(%oparent, %oname)
    %smiss = slt i32 %sino, 0
    br %smiss, @notfound, @dexists
  @dexists:
    %dino = call @vfs_lookup(%newpath)
    %hasexists = sge i32 %dino, 0
    br %hasexists, @exists, @nsplit
  @nsplit:
    %npb = gep i8, *%nbuf, 0
    %nlast = call @vfs_split(%newpath, %npb)
    %nbad = slt i32 %nlast, 0
    br %nbad, @invalid, @nchk
  @nchk:
    %nni = add i32 %nlast, 1
    %nname = gep i8, *%newpath, %nni
    %nnc = load i8, *%nname
    %nnempty = eq i8 %nnc, 0
    br %nnempty, @invalid, @nparent
  @nparent:
    %nroot = eq i32 %nlast, 0
    br %nroot, @nrootv, @nlookup
  @nrootv:
    %nrr = call @ramfs_root()
    jmp @ngot
  @nlookup:
    %npv = call @vfs_lookup(%npb)
    jmp @ngot
  @ngot:
    %nparent = phi i32 [%nrr, @nrootv], [%npv, @nlookup]
    %npbad = slt i32 %nparent, 0
    br %npbad, @nodest, @nchktype
  @nchktype:
    %nty = call @vfs_type(%nparent)
    %ntydir = eq i32 %nty, 2
    br %ntydir, @rename, @invalid
  @rename:
    %rc = call @ramfs_rename(%sino, %nparent, %nname)
    ret i32 %rc
  @exists:
    ret i32 -2
  @nodest:
    ret i32 -4
  @notfound:
    ret i32 -1
  @invalid:
    ret i32 -3
}

fun @vfs_create(path: *i8, type: i32) -> i32 {
  @entry:
    %pbuf = let [i8, 128]
    %i = let i32
    %last = let i32
    %k = let i32
    store i32 0, *%i
    store i32 -1, *%last
    store i32 0, *%k
    jmp @scan
  @scan:
    %iv = load i32, *%i
    %cp = gep i8, *%path, %iv
    %ch = load i8, *%cp
    %end = eq i8 %ch, 0
    br %end, @scan_done, @scan_body
  @scan_body:
    %sl = eq i8 %ch, 47
    br %sl, @mark, @next
  @mark:
    store i32 %iv, *%last
    jmp @next
  @next:
    %n = add i32 %iv, 1
    store i32 %n, *%i
    jmp @scan
  @scan_done:
    %lv = load i32, *%last
    %has = sge i32 %lv, 0
    br %has, @with_parent, @no_parent
  @no_parent:
    %root = call @ramfs_root()
    %namep = gep i8, *%path, 0
    %ino = call @ramfs_create(%root, %namep, %type)
    ret i32 %ino
  @with_parent:
    %lv2 = load i32, *%last
    %ni = add i32 %lv2, 1
    %namep2 = gep i8, *%path, %ni
    %nc = load i8, *%namep2
    %nz = eq i8 %nc, 0
    br %nz, @bad, @copy_parent
  @bad:
    ret i32 -1
  @copy_parent:
    store i32 0, *%k
    jmp @cp_cond
  @cp_cond:
    %kv = load i32, *%k
    %lv3 = load i32, *%last
    %done = sge i32 %kv, %lv3
    br %done, @cp_end, @cp_body
  @cp_body:
    %sp = gep i8, *%path, %kv
    %ch2 = load i8, *%sp
    %dp = gep i8, *%pbuf, %kv
    store i8 %ch2, *%dp
    %kn = add i32 %kv, 1
    store i32 %kn, *%k
    jmp @cp_cond
  @cp_end:
    %kv2 = load i32, *%k
    %tp = gep i8, *%pbuf, %kv2
    store i8 0, *%tp
    %lv4 = load i32, *%last
    %isroot = eq i32 %lv4, 0
    br %isroot, @use_root, @use_lookup
  @use_root:
    %r2 = call @ramfs_root()
    jmp @create_it
  @use_lookup:
    %pb = gep i8, *%pbuf, 0
    %p2 = call @vfs_lookup(%pb)
    jmp @create_it
  @create_it:
    %parent = phi i32 [%r2, @use_root], [%p2, @use_lookup]
    %badp = slt i32 %parent, 0
    br %badp, @bad2, @mk
  @mk:
    %lv5 = load i32, *%last
    %ni2 = add i32 %lv5, 1
    %namep3 = gep i8, *%path, %ni2
    %ino2 = call @ramfs_create(%parent, %namep3, %type)
    ret i32 %ino2
  @bad2:
    ret i32 -1
}

fun @vfs_open(path: *i8, flags: i32) -> i32 {
  @entry:
    %ino = call @vfs_lookup(%path)
    %ok = sge i32 %ino, 0
    br %ok, @found, @try_create
  @found:
    %fd = call @vfs_alloc_fd(%ino, %flags)
    ret i32 %fd
  @try_create:
    %cflag = and i32 %flags, 1
    %want = eq i32 %cflag, 1
    br %want, @create, @fail
  @create:
    %ni = call @vfs_create(%path, 1)
    %cok = sge i32 %ni, 0
    br %cok, @found2, @fail
  @found2:
    %fd2 = call @vfs_alloc_fd(%ni, %flags)
    ret i32 %fd2
  @fail:
    ret i32 -1
}

fun @vfs_read(fd: i32, buf: *i8, len: i64) -> i64 {
  @entry:
    %lo = sge i32 %fd, 0
    %hi = slt i32 %fd, 16
    %inr = and i1 %lo, %hi
    br %inr, @ok, @fail
  @fail:
    ret i64 0
  @ok:
    %fp = call @vfs_fd(%fd)
    %up = field @vfs_Fd, *%fp, 0
    %uv = load i32, *%up
    %used = eq i32 %uv, 1
    br %used, @go, @fail2
  @fail2:
    ret i64 0
  @go:
    %ip = field @vfs_Fd, *%fp, 1
    %ino = load i32, *%ip
    %op = field @vfs_Fd, *%fp, 2
    %off = load i64, *%op
    %n = call @ramfs_read(%ino, %off, %buf, %len)
    %noff = add i64 %off, %n
    store i64 %noff, *%op
    ret i64 %n
}

fun @vfs_write(fd: i32, buf: *i8, len: i64) -> i64 {
  @entry:
    %lo = sge i32 %fd, 0
    %hi = slt i32 %fd, 16
    %inr = and i1 %lo, %hi
    br %inr, @ok, @fail
  @fail:
    ret i64 0
  @ok:
    %fp = call @vfs_fd(%fd)
    %up = field @vfs_Fd, *%fp, 0
    %uv = load i32, *%up
    %used = eq i32 %uv, 1
    br %used, @go, @fail2
  @fail2:
    ret i64 0
  @go:
    %ip = field @vfs_Fd, *%fp, 1
    %ino = load i32, *%ip
    %op = field @vfs_Fd, *%fp, 2
    %off = load i64, *%op
    %n = call @ramfs_write(%ino, %off, %buf, %len)
    %noff = add i64 %off, %n
    store i64 %noff, *%op
    ret i64 %n
}

fun @vfs_close(fd: i32) -> i32 {
  @entry:
    %lo = sge i32 %fd, 0
    %hi = slt i32 %fd, 16
    %inr = and i1 %lo, %hi
    br %inr, @ok, @fail
  @fail:
    ret i32 -1
  @ok:
    %fp = call @vfs_fd(%fd)
    %up = field @vfs_Fd, *%fp, 0
    store i32 0, *%up
    ret i32 0
}

fun @vfs_readdir(fd: i32, idx: i32) -> i32 {
  @entry:
    %lo = sge i32 %fd, 0
    %hi = slt i32 %fd, 16
    %inr = and i1 %lo, %hi
    br %inr, @ok, @fail
  @fail:
    ret i32 -1
  @ok:
    %fp = call @vfs_fd(%fd)
    %ip = field @vfs_Fd, *%fp, 1
    %ino = load i32, *%ip
    %c = call @ramfs_readdir(%ino, %idx)
    ret i32 %c
}

fun @vfs_name(ino: i32) -> *i8 {
  @entry:
    %p = call @ramfs_get_name(%ino)
    ret *i8 %p
}

fun @vfs_type(ino: i32) -> i32 {
  @entry:
    %t = call @ramfs_type(%ino)
    ret i32 %t
}

fun @vfs_size(ino: i32) -> i64 {
  @entry:
    %s = call @ramfs_size(%ino)
    ret i64 %s
}

fun @vfs_mkdir(path: *i8) -> i32 {
  @entry:
    %r = call @vfs_create(%path, 2)
    ret i32 %r
}
