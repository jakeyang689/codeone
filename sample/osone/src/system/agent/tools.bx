    %r = call @dhcp_acquire()
    %ok = eq i32 %r, 1
    br %ok, @yes, @no
  @yes:
    call @agtools_puts(%out, %len, %cap, "ok\n")
    %rv26 = load i32, *%len
    ret i32 %rv26
  @no:
    call @agtools_err(%out, %len, %cap, "dhcp failed")
    %rv27 = load i32, *%len
    ret i32 %rv27
}

fun @agtools_net_dns(args: *i8, out: *i8, cap: i32) -> i32 {
  @entry:
    %len = let i32
    %host = let [i8, 160]
    %hp = gep i8, *%host, 0
    store i32 0, *%len
    %ar = call @agtools_arg(%args, "name", %hp, 160)
    %no = slt i32 %ar, 0
    br %no, @tryhost, @run
  @tryhost:
    %ar2 = call @agtools_arg(%args, "host", %hp, 160)
    %no2 = slt i32 %ar2, 0
    br %no2, @badargs, @run
  @badargs:
    call @agtools_err(%out, %len, %cap, "missing name")
    %rv28 = load i32, *%len
    ret i32 %rv28
  @run:
    %ip = call @dns_resolve(%hp, 1500)
    %ok = ne i32 %ip, 0
    br %ok, @yes, @no
  @yes:
    call @agtools_putip(%out, %len, %cap, %ip)
    call @agtools_putc(%out, %len, %cap, 10)
    %rv29 = load i32, *%len
    ret i32 %rv29
  @no:
    call @agtools_err(%out, %len, %cap, "resolve failed")
    %rv30 = load i32, *%len
    ret i32 %rv30
}

fun @agtools_net_ping(args: *i8, out: *i8, cap: i32) -> i32 {
  @entry:
    %len = let i32
    %host = let [i8, 160]
    %hp = gep i8, *%host, 0
    store i32 0, *%len
    %ar = call @agtools_arg(%args, "host", %hp, 160)
    %no = slt i32 %ar, 0
    br %no, @badargs, @parse
  @badargs:
    call @agtools_err(%out, %len, %cap, "missing host")
    %rv31 = load i32, *%len
    ret i32 %rv31
  @parse:
    %lit = call @net_parse_ip(%hp)
    %isip = ne i32 %lit, 0
    br %isip, @have, @resolve
  @resolve:
    %rip = call @dns_resolve(%hp, 1500)
    %rok = ne i32 %rip, 0
    br %rok, @have2, @nores
  @nores:
    call @agtools_err(%out, %len, %cap, "resolve failed")
    %rv32 = load i32, *%len
    ret i32 %rv32
  @have2:
    %ip2 = phi i32 [%rip, @resolve]
    jmp @ping
  @have:
    %ip = phi i32 [%lit, @parse]
    jmp @ping
  @ping:
    %addr = phi i32 [%ip2, @have2], [%ip, @have]
    call @agtools_puts(%out, %len, %cap, "ping ")
    call @agtools_putip(%out, %len, %cap, %addr)
    call @agtools_puts(%out, %len, %cap, ": ")
    %r = call @icmp_ping(%addr, 1, 1000)
    %one = eq i32 %r, 1
    br %one, @up, @chkfail
  @up:
    call @agtools_puts(%out, %len, %cap, "ok\n")
    %rv33 = load i32, *%len
    ret i32 %rv33
  @chkfail:
    %zero = eq i32 %r, 0
    br %zero, @down, @sendfail
  @down:
    call @agtools_puts(%out, %len, %cap, "timeout\n")
    %rv34 = load i32, *%len
    ret i32 %rv34
  @sendfail:
    call @agtools_puts(%out, %len, %cap, "send failed\n")
    %rv35 = load i32, *%len
    ret i32 %rv35
}

fun @agtools_sys_info(args: *i8, out: *i8, cap: i32) -> i32 {
  @entry:
    %len = let i32
    store i32 0, *%len
    call @agtools_puts(%out, %len, %cap, "os=osone arch=aarch64\n")
    call @agtools_puts(%out, %len, %cap, "uptime=")
    %now = call @timer_now()
    %freq = call @timer_freq()
    %fz = eq i64 %freq, 0
    br %fz, @notime, @uptime
  @uptime:
    %secs = udiv i64 %now, %freq
    call @agtools_putdec(%out, %len, %cap, %secs)
    jmp @aftertime
  @notime:
    call @agtools_putc(%out, %len, %cap, 48)
    jmp @aftertime
  @aftertime:
    call @agtools_puts(%out, %len, %cap, "s\nmem_used=")
    %u = call @kmem_used()
    %uk = udiv i64 %u, 1024
    call @agtools_putdec(%out, %len, %cap, %uk)
    call @agtools_puts(%out, %len, %cap, "KB mem_total=")
    %t = call @kmem_total()
    %tk = udiv i64 %t, 1024
    call @agtools_putdec(%out, %len, %cap, %tk)
    call @agtools_puts(%out, %len, %cap, "KB\n")
    %rd = call @net_ready()
    %rd64 = sext i32 %rd to i64
    call @agtools_puts(%out, %len, %cap, "net_ready=")
    call @agtools_putdec(%out, %len, %cap, %rd64)
    call @agtools_putc(%out, %len, %cap, 10)
    %rv36 = load i32, *%len
    ret i32 %rv36
}

