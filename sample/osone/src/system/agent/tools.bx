}

fun @agtools_fs_remove(args: *i8, out: *i8, cap: i32) -> i32 {
  @entry:
    %len = let i32
    %path = let [i8, 160]
    %pp = gep i8, *%path, 0
    store i32 0, *%len
    %ar = call @agtools_arg(%args, "path", %pp, 160)
    %no = slt i32 %ar, 0
    br %no, @badargs, @run
  @badargs:
    call @agtools_err(%out, %len, %cap, "missing path")
    %rv20 = load i32, *%len
    ret i32 %rv20
  @run:
    %r = call @vfs_remove(%pp)
    %z = eq i32 %r, 0
    br %z, @ok, @notz
  @ok:
    call @agtools_puts(%out, %len, %cap, "ok\n")
    %rv21 = load i32, *%len
    ret i32 %rv21
  @notz:
    %m1 = eq i32 %r, -1
    br %m1, @nf, @chk2
  @nf:
    call @agtools_err(%out, %len, %cap, "not found")
    %rv22 = load i32, *%len
    ret i32 %rv22
  @chk2:
    %m2 = eq i32 %r, -2
    br %m2, @ne, @bad
  @ne:
    call @agtools_err(%out, %len, %cap, "directory not empty")
    %rv23 = load i32, *%len
    ret i32 %rv23
  @bad:
    call @agtools_err(%out, %len, %cap, "cannot remove")
    %rv24 = load i32, *%len
    ret i32 %rv24
}

fun @agtools_net_status(args: *i8, out: *i8, cap: i32) -> i32 {
  @entry:
    %len = let i32
    store i32 0, *%len
    call @agtools_puts(%out, %len, %cap, "ip=")
    %ip = call @net_my_ip()
    call @agtools_putip(%out, %len, %cap, %ip)
    call @agtools_putc(%out, %len, %cap, 10)
    call @agtools_puts(%out, %len, %cap, "netmask=")
    %nm = call @net_netmask()
    call @agtools_putip(%out, %len, %cap, %nm)
    call @agtools_putc(%out, %len, %cap, 10)
    call @agtools_puts(%out, %len, %cap, "gateway=")
    %gw = call @net_gateway()
    call @agtools_putip(%out, %len, %cap, %gw)
    call @agtools_putc(%out, %len, %cap, 10)
    call @agtools_puts(%out, %len, %cap, "dns=")
    %dns = call @net_dns()
    call @agtools_putip(%out, %len, %cap, %dns)
    call @agtools_putc(%out, %len, %cap, 10)
    call @agtools_puts(%out, %len, %cap, "mac=")
    %mac = call @net_my_mac()
    call @agtools_putmac(%out, %len, %cap, %mac)
    call @agtools_putc(%out, %len, %cap, 10)
    call @agtools_puts(%out, %len, %cap, "ready=")
    %rd = call @net_ready()
    %rd64 = sext i32 %rd to i64
    call @agtools_putdec(%out, %len, %cap, %rd64)
    call @agtools_putc(%out, %len, %cap, 10)
    %rv25 = load i32, *%len
    ret i32 %rv25
}

