fun @agtools_call(name: *i8, args: *i8, out: *i8, cap: i32) -> i32 {
  @entry:
    %lvl = call @agtools_level(%name)
    %pol = call @agtools_get_policy()
    %deny = sgt i32 %lvl, %pol
    br %deny, @denied, @dispatch
  @denied:
    %len0 = let i32
    store i32 0, *%len0
    call @agtools_puts(%out, %len0, %cap, "error: ")
    call @agtools_puts(%out, %len0, %cap, %name)
    call @agtools_puts(%out, %len0, %cap, " denied by policy\n")
    %rvd = load i32, *%len0
    ret i32 %rvd
  @dispatch:
    %n1 = call @agtools_streq(%name, "fs.list")
    %b1 = eq i32 %n1, 1
    br %b1, @d_list, @c2
  @d_list:
    %r1 = call @agtools_fs_list(%args, %out, %cap)
    ret i32 %r1
  @c2:
    %n2 = call @agtools_streq(%name, "fs.read")
    %b2 = eq i32 %n2, 1
    br %b2, @d_read, @c3
  @d_read:
    %r2 = call @agtools_fs_read(%args, %out, %cap)
    ret i32 %r2
  @c3:
    %n3 = call @agtools_streq(%name, "fs.stat")
    %b3 = eq i32 %n3, 1
    br %b3, @d_stat, @c4
  @d_stat:
    %r3 = call @agtools_fs_stat(%args, %out, %cap)
    ret i32 %r3
  @c4:
    %n4 = call @agtools_streq(%name, "fs.write")
    %b4 = eq i32 %n4, 1
    br %b4, @d_write, @c5
  @d_write:
    %r4 = call @agtools_fs_write(%args, %out, %cap)
    ret i32 %r4
  @c5:
    %n5 = call @agtools_streq(%name, "fs.mkdir")
    %b5 = eq i32 %n5, 1
    br %b5, @d_mkdir, @c6
  @d_mkdir:
    %r5 = call @agtools_fs_mkdir(%args, %out, %cap)
    ret i32 %r5
  @c6:
    %n6 = call @agtools_streq(%name, "fs.remove")
    %b6 = eq i32 %n6, 1
    br %b6, @d_remove, @c7
  @d_remove:
    %r6 = call @agtools_fs_remove(%args, %out, %cap)
    ret i32 %r6
  @c7:
    %n7 = call @agtools_streq(%name, "net.status")
    %b7 = eq i32 %n7, 1
    br %b7, @d_status, @c8
  @d_status:
    %r7 = call @agtools_net_status(%args, %out, %cap)
    ret i32 %r7
  @c8:
    %n8 = call @agtools_streq(%name, "net.dhcp")
    %b8 = eq i32 %n8, 1
    br %b8, @d_dhcp, @c9
  @d_dhcp:
    %r8 = call @agtools_net_dhcp(%args, %out, %cap)
    ret i32 %r8
  @c9:
    %n9 = call @agtools_streq(%name, "net.dns")
    %b9 = eq i32 %n9, 1
    br %b9, @d_dns, @c10
  @d_dns:
    %r9 = call @agtools_net_dns(%args, %out, %cap)
    ret i32 %r9
  @c10:
    %n10 = call @agtools_streq(%name, "net.ping")
    %b10 = eq i32 %n10, 1
    br %b10, @d_ping, @c11
  @d_ping:
    %r10 = call @agtools_net_ping(%args, %out, %cap)
    ret i32 %r10
  @c11:
    %n11 = call @agtools_streq(%name, "sys.info")
    %b11 = eq i32 %n11, 1
    br %b11, @d_info, @c12
  @d_info:
    %r11 = call @agtools_sys_info(%args, %out, %cap)
    ret i32 %r11
  @c12:
    %n12 = call @agtools_streq(%name, "sys.reboot")
    %b12 = eq i32 %n12, 1
    br %b12, @d_reboot, @c13
  @d_reboot:
    %r12 = call @agtools_sys_reboot(%args, %out, %cap)
    ret i32 %r12
  @c13:
    %n13 = call @agtools_streq(%name, "sys.poweroff")
    %b13 = eq i32 %n13, 1
    br %b13, @d_power, @unknown
  @d_power:
    %r13 = call @agtools_sys_poweroff(%args, %out, %cap)
    ret i32 %r13
  @unknown:
    %lenu = let i32
    store i32 0, *%lenu
    call @agtools_err(%out, %lenu, %cap, "unknown tool")
    %rvu = load i32, *%lenu
    ret i32 %rvu
}
