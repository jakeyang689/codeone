// AES-128 encryption/decryption
// 128-bit block, 128-bit key, 10 rounds
// State: column-major 4x4 byte array

// Platform dependencies (libc + hardware crypto)
extern @memset(s: *i8, c: i32, n: i64) -> *i8
extern @memcpy(dst: *i8, src: *i8, n: i64) -> *i8
extern @c1_random_buf(buf: *i8, len: i64) -> void
extern @c1_cpu_features() -> i64
extern @c1_aes128_encrypt_block(in: *i8, key: *i8, out: *i8) -> void
extern @c1_aes128_decrypt_block(in: *i8, key: *i8, out: *i8) -> void
extern @c1_aes256_encrypt_block(in: *i8, key: *i8, out: *i8) -> void
extern @c1_aes256_decrypt_block(in: *i8, key: *i8, out: *i8) -> void
extern @c1_aes128_cbc_encrypt(in: *i8, len: i32, key: *i8, iv: *i8, out: *i8) -> void
extern @c1_aes128_cbc_decrypt(in: *i8, len: i32, key: *i8, iv: *i8, out: *i8) -> void
extern @c1_aes256_cbc_encrypt(in: *i8, len: i32, key: *i8, iv: *i8, out: *i8) -> void
extern @c1_aes256_cbc_decrypt(in: *i8, len: i32, key: *i8, iv: *i8, out: *i8) -> void
extern @c1_aes128_gcm_encrypt(pt: *i8, pt_len: i32, aad: *i8, aad_len: i32, key: *i8, iv: *i8, ct: *i8, tag: *i8) -> i32
extern @c1_aes128_gcm_decrypt(ct: *i8, ct_len: i32, aad: *i8, aad_len: i32, key: *i8, iv: *i8, tag: *i8, pt: *i8) -> i32
extern @c1_aes256_gcm_encrypt(pt: *i8, pt_len: i32, aad: *i8, aad_len: i32, key: *i8, iv: *i8, ct: *i8, tag: *i8) -> i32
extern @c1_aes256_gcm_decrypt(ct: *i8, ct_len: i32, aad: *i8, aad_len: i32, key: *i8, iv: *i8, tag: *i8, pt: *i8) -> i32

// ============================================================
// Constants
// ============================================================

