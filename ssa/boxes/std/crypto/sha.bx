// Public API: compute SHA-256 digest of input data.
// data: input byte array, len: length in bytes, digest: 32-byte output buffer
// Dispatches to the hardware compression when SHA-256 extensions exist.
fun @std_crypto_sha256_transform(aptr: *i32, bptr: *i32, cptr: *i32, dptr: *i32,
                                  eptr: *i32, fptr: *i32, gptr: *i32, hptr: *i32,
                                  block: *i8) -> void {
  @entry:
    %f = call @c1_cpu_features()
    %b = and i64 %f, 2
    %hw = ne i64 %b, 0
    br %hw, @hw_path, @sw_path
  @hw_path:
    call @c1_sha256_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %block)
    ret void
  @sw_path:
    call @_sha256_transform_sw(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %block)
    ret void
}

fun @std_crypto_sha256_compute(data: *i8, len: i32, digest: *i8) -> void {
  @entry:
    // Allocate hash state (8 i32)
    %aptr = let i32
    %bptr = let i32
    %cptr = let i32
    %dptr = let i32
    %eptr = let i32
    %fptr = let i32
    %gptr = let i32
    %hptr = let i32

    // Initialize state (SHA-256 magic constants)
    store i32 0x6A09E667, *%aptr
    store i32 0xBB67AE85, *%bptr
    store i32 0x3C6EF372, *%cptr
    store i32 0xA54FF53A, *%dptr
    store i32 0x510E527F, *%eptr
    store i32 0x9B05688C, *%fptr
    store i32 0x1F83D9AB, *%gptr
    store i32 0x5BE0CD19, *%hptr

    // Allocate scratch buffers for padding
    %buf1 = let [i8, 64]
    %buf2 = let [i8, 64]

    // Zero the buffers (let does NOT zero-initialize)
    %bp1m = gep i8, *%buf1, 0
    %bp2m = gep i8, *%buf2, 0
    %nm64 = let i64
    store i64 64, *%nm64
    %nm64v = load i64, *%nm64
    call @memset(%bp1m, 0, %nm64v)
    call @memset(%bp2m, 0, %nm64v)

    // Loop counter and offset tracking
    %offset = let i32
    %iptr = let i32
    store i32 0, *%offset
    jmp @block_cond

    // Process all full 64-byte blocks
  @block_cond:
    %off = load i32, *%offset
    %next_off = add i32 %off, 64
    %has_block = sle i32 %next_off, %len
    br %has_block, @process_block, @pad_start

  @process_block:
    %bp = gep i8, *%data, %off
    call @std_crypto_sha256_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %bp)
    store i32 %next_off, *%offset
    jmp @block_cond

    // Handle padding (tail bytes + 0x80 + length)
  @pad_start:
    %off_val = load i32, *%offset
    %rem = sub i32 %len, %off_val
    %needs_two = sge i32 %rem, 56
    br %needs_two, @pad_two_setup, @pad_one_setup

  @pad_one_setup:
    store i32 0, *%iptr
    jmp @copy_cond

  @pad_two_setup:
    store i32 0, *%iptr
    jmp @copy_cond

  @copy_cond:
    %ci = load i32, *%iptr
    %copy_done = slt i32 %ci, %rem
    br %copy_done, @copy_body, @copy_done_label

  @copy_body:
    %src_off = add i32 %off_val, %ci
    %src_p = gep i8, *%data, %src_off
    %byte = load i8, *%src_p
    %dst_p = gep i8, *%buf1, %ci
    store i8 %byte, *%dst_p
    %ci_next = add i32 %ci, 1
    store i32 %ci_next, *%iptr
    jmp @copy_cond

  @copy_done_label:
    // Add 0x80 padding byte at position rem
    %pad80_p = gep i8, *%buf1, %rem
    store i8 0x80, *%pad80_p

    // Check one-block vs two-block
    %is_one_block = slt i32 %rem, 56
    br %is_one_block, @process_one_block, @process_two_block_a

    // One block: set length (big-endian 64-bit) and transform
  @process_one_block:
    // Bit length in big-endian format at bytes 56-63
    // For len < 2^29 bytes: high 32 bits (bytes 56-59) = 0
    %bl = mul i32 %len, 8
    // Byte 60: bits 31-24 of bit length
    %bl_s24 = lshr i32 %bl, 24
    %bl_b24 = trunc i32 %bl_s24 to i8
    // Byte 61: bits 23-16
    %bl_s16 = lshr i32 %bl, 16
    %bl_b16 = trunc i32 %bl_s16 to i8
    // Byte 62: bits 15-8
    %bl_s8 = lshr i32 %bl, 8
    %bl_b8 = trunc i32 %bl_s8 to i8
    // Byte 63: bits 7-0
    %bl_b0 = trunc i32 %bl to i8

    %p60 = gep i8, *%buf1, 60
    store i8 %bl_b24, *%p60
    %p61 = gep i8, *%buf1, 61
    store i8 %bl_b16, *%p61
    %p62 = gep i8, *%buf1, 62
    store i8 %bl_b8, *%p62
    %p63 = gep i8, *%buf1, 63
    store i8 %bl_b0, *%p63
    // Bytes 56-59 = 0 (from memset), bytes 60-63 = big-endian bit length

    %buf1_p = gep i8, *%buf1, 0
    call @std_crypto_sha256_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf1_p)
    jmp @write_digest

    // Two blocks: first block (data + 0x80)
  @process_two_block_a:
    %buf1_p2 = gep i8, *%buf1, 0
    call @std_crypto_sha256_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf1_p2)

    // Second block: zeros + big-endian length in buf2
    %bl2 = mul i32 %len, 8
    %bl2_s24 = lshr i32 %bl2, 24
    %bl2_b24 = trunc i32 %bl2_s24 to i8
    %bl2_s16 = lshr i32 %bl2, 16
    %bl2_b16 = trunc i32 %bl2_s16 to i8
    %bl2_s8 = lshr i32 %bl2, 8
    %bl2_b8 = trunc i32 %bl2_s8 to i8
    %bl2_b0 = trunc i32 %bl2 to i8

    %p60_2 = gep i8, *%buf2, 60
    store i8 %bl2_b24, *%p60_2
    %p61_2 = gep i8, *%buf2, 61
    store i8 %bl2_b16, *%p61_2
    %p62_2 = gep i8, *%buf2, 62
    store i8 %bl2_b8, *%p62_2
    %p63_2 = gep i8, *%buf2, 63
    store i8 %bl2_b0, *%p63_2

    %buf2_p = gep i8, *%buf2, 0
    call @std_crypto_sha256_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf2_p)
    jmp @write_digest

    // Write final digest bytes (H0-H7 in big-endian)
  @write_digest:
    %a_val = load i32, *%aptr
    %b_val = load i32, *%bptr
    %c_val = load i32, *%cptr
    %d_val = load i32, *%dptr
    %e_val = load i32, *%eptr
    %f_val = load i32, *%fptr
    %g_val = load i32, *%gptr
    %h_val = load i32, *%hptr

    // A bytes 0-3 (big-endian)
    %a_b0 = trunc i32 %a_val to i8
    %a_s8 = lshr i32 %a_val, 8
    %a_b1 = trunc i32 %a_s8 to i8
    %a_s16 = lshr i32 %a_val, 16
    %a_b2 = trunc i32 %a_s16 to i8
    %a_s24 = lshr i32 %a_val, 24
    %a_b3 = trunc i32 %a_s24 to i8

    %da0 = gep i8, *%digest, 0
    store i8 %a_b3, *%da0
    %da1 = gep i8, *%digest, 1
    store i8 %a_b2, *%da1
    %da2 = gep i8, *%digest, 2
    store i8 %a_b1, *%da2
    %da3 = gep i8, *%digest, 3
    store i8 %a_b0, *%da3

    // B bytes 4-7 (big-endian)
    %b_b0 = trunc i32 %b_val to i8
    %b_s8 = lshr i32 %b_val, 8
    %b_b1 = trunc i32 %b_s8 to i8
    %b_s16 = lshr i32 %b_val, 16
    %b_b2 = trunc i32 %b_s16 to i8
    %b_s24 = lshr i32 %b_val, 24
    %b_b3 = trunc i32 %b_s24 to i8

    %db0 = gep i8, *%digest, 4
    store i8 %b_b3, *%db0
    %db1 = gep i8, *%digest, 5
    store i8 %b_b2, *%db1
    %db2 = gep i8, *%digest, 6
    store i8 %b_b1, *%db2
    %db3 = gep i8, *%digest, 7
    store i8 %b_b0, *%db3

    // C bytes 8-11 (big-endian)
    %c_b0 = trunc i32 %c_val to i8
    %c_s8 = lshr i32 %c_val, 8
    %c_b1 = trunc i32 %c_s8 to i8
    %c_s16 = lshr i32 %c_val, 16
    %c_b2 = trunc i32 %c_s16 to i8
    %c_s24 = lshr i32 %c_val, 24
    %c_b3 = trunc i32 %c_s24 to i8

    %dc0 = gep i8, *%digest, 8
    store i8 %c_b3, *%dc0
    %dc1 = gep i8, *%digest, 9
    store i8 %c_b2, *%dc1
    %dc2 = gep i8, *%digest, 10
    store i8 %c_b1, *%dc2
    %dc3 = gep i8, *%digest, 11
    store i8 %c_b0, *%dc3

    // D bytes 12-15 (big-endian)
    %d_b0 = trunc i32 %d_val to i8
    %d_s8 = lshr i32 %d_val, 8
    %d_b1 = trunc i32 %d_s8 to i8
    %d_s16 = lshr i32 %d_val, 16
    %d_b2 = trunc i32 %d_s16 to i8
    %d_s24 = lshr i32 %d_val, 24
    %d_b3 = trunc i32 %d_s24 to i8

    %dd0 = gep i8, *%digest, 12
    store i8 %d_b3, *%dd0
    %dd1 = gep i8, *%digest, 13
    store i8 %d_b2, *%dd1
    %dd2 = gep i8, *%digest, 14
    store i8 %d_b1, *%dd2
    %dd3 = gep i8, *%digest, 15
    store i8 %d_b0, *%dd3

    // E bytes 16-19 (big-endian)
    %e_b0 = trunc i32 %e_val to i8
    %e_s8 = lshr i32 %e_val, 8
    %e_b1 = trunc i32 %e_s8 to i8
    %e_s16 = lshr i32 %e_val, 16
    %e_b2 = trunc i32 %e_s16 to i8
    %e_s24 = lshr i32 %e_val, 24
    %e_b3 = trunc i32 %e_s24 to i8

    %de0 = gep i8, *%digest, 16
    store i8 %e_b3, *%de0
    %de1 = gep i8, *%digest, 17
    store i8 %e_b2, *%de1
    %de2 = gep i8, *%digest, 18
    store i8 %e_b1, *%de2
    %de3 = gep i8, *%digest, 19
    store i8 %e_b0, *%de3

    // F bytes 20-23 (big-endian)
    %f_b0 = trunc i32 %f_val to i8
    %f_s8 = lshr i32 %f_val, 8
    %f_b1 = trunc i32 %f_s8 to i8
    %f_s16 = lshr i32 %f_val, 16
    %f_b2 = trunc i32 %f_s16 to i8
    %f_s24 = lshr i32 %f_val, 24
    %f_b3 = trunc i32 %f_s24 to i8

    %df0 = gep i8, *%digest, 20
    store i8 %f_b3, *%df0
    %df1 = gep i8, *%digest, 21
    store i8 %f_b2, *%df1
    %df2 = gep i8, *%digest, 22
    store i8 %f_b1, *%df2
    %df3 = gep i8, *%digest, 23
    store i8 %f_b0, *%df3

    // G bytes 24-27 (big-endian)
    %g_b0 = trunc i32 %g_val to i8
    %g_s8 = lshr i32 %g_val, 8
    %g_b1 = trunc i32 %g_s8 to i8
    %g_s16 = lshr i32 %g_val, 16
    %g_b2 = trunc i32 %g_s16 to i8
    %g_s24 = lshr i32 %g_val, 24
    %g_b3 = trunc i32 %g_s24 to i8

    %dg0 = gep i8, *%digest, 24
    store i8 %g_b3, *%dg0
    %dg1 = gep i8, *%digest, 25
    store i8 %g_b2, *%dg1
    %dg2 = gep i8, *%digest, 26
    store i8 %g_b1, *%dg2
    %dg3 = gep i8, *%digest, 27
    store i8 %g_b0, *%dg3

    // H bytes 28-31 (big-endian)
    %h_b0 = trunc i32 %h_val to i8
    %h_s8 = lshr i32 %h_val, 8
    %h_b1 = trunc i32 %h_s8 to i8
    %h_s16 = lshr i32 %h_val, 16
    %h_b2 = trunc i32 %h_s16 to i8
    %h_s24 = lshr i32 %h_val, 24
    %h_b3 = trunc i32 %h_s24 to i8

    %dh0 = gep i8, *%digest, 28
    store i8 %h_b3, *%dh0
    %dh1 = gep i8, *%digest, 29
    store i8 %h_b2, *%dh1
    %dh2 = gep i8, *%digest, 30
    store i8 %h_b1, *%dh2
    %dh3 = gep i8, *%digest, 31
    store i8 %h_b0, *%dh3

    ret void
}


// ============================================================
// SHA-1 message digest implementation
// 80 rounds, 160-bit (20 byte) output, 64-byte blocks, big-endian
// ============================================================

// SHA-1 round constants (per 20-round groups)
const @_sha1_k: [i32, 4] = [ 0x5A827999, 0x6ED9EBA1, 0x8F1BBCDC, 0xCA62C1D6 ]

// Transform: process one 64-byte block (SHA-1)
fun @std_crypto_sha1_transform(aptr: *i32, bptr: *i32, cptr: *i32, dptr: *i32,
                                 eptr: *i32, block: *i8) -> void {
  @entry:
    %a0 = load i32, *%aptr
    %b0 = load i32, *%bptr
    %c0 = load i32, *%cptr
    %d0 = load i32, *%dptr
    %e0 = load i32, *%eptr

    // Word 0: bytes 0-3 (big-endian)
    %w0_p0 = gep i8, *%block, 0
    %w0_b0 = load i8, *%w0_p0
    %w0_z0 = zext i8 %w0_b0 to i32
    %w0_s24 = shl i32 %w0_z0, 24
    %w0_p1 = gep i8, *%block, 1
    %w0_b1 = load i8, *%w0_p1
    %w0_z1 = zext i8 %w0_b1 to i32
    %w0_s16 = shl i32 %w0_z1, 16
    %w0_p2 = gep i8, *%block, 2
    %w0_b2 = load i8, *%w0_p2
    %w0_z2 = zext i8 %w0_b2 to i32
    %w0_s8 = shl i32 %w0_z2, 8
    %w0_p3 = gep i8, *%block, 3
    %w0_b3 = load i8, *%w0_p3
    %w0_z3 = zext i8 %w0_b3 to i32
    %w0_o1 = or i32 %w0_s24, %w0_s16
    %w0_o2 = or i32 %w0_o1, %w0_s8
    %w0 = or i32 %w0_o2, %w0_z3

    // Word 1: bytes 4-7 (big-endian)
    %w1_p0 = gep i8, *%block, 4
    %w1_b0 = load i8, *%w1_p0
    %w1_z0 = zext i8 %w1_b0 to i32
    %w1_s24 = shl i32 %w1_z0, 24
    %w1_p1 = gep i8, *%block, 5
    %w1_b1 = load i8, *%w1_p1
    %w1_z1 = zext i8 %w1_b1 to i32
    %w1_s16 = shl i32 %w1_z1, 16
    %w1_p2 = gep i8, *%block, 6
    %w1_b2 = load i8, *%w1_p2
    %w1_z2 = zext i8 %w1_b2 to i32
    %w1_s8 = shl i32 %w1_z2, 8
    %w1_p3 = gep i8, *%block, 7
    %w1_b3 = load i8, *%w1_p3
    %w1_z3 = zext i8 %w1_b3 to i32
    %w1_o1 = or i32 %w1_s24, %w1_s16
    %w1_o2 = or i32 %w1_o1, %w1_s8
    %w1 = or i32 %w1_o2, %w1_z3

    // Word 2: bytes 8-11 (big-endian)
    %w2_p0 = gep i8, *%block, 8
    %w2_b0 = load i8, *%w2_p0
    %w2_z0 = zext i8 %w2_b0 to i32
    %w2_s24 = shl i32 %w2_z0, 24
    %w2_p1 = gep i8, *%block, 9
    %w2_b1 = load i8, *%w2_p1
    %w2_z1 = zext i8 %w2_b1 to i32
    %w2_s16 = shl i32 %w2_z1, 16
    %w2_p2 = gep i8, *%block, 10
    %w2_b2 = load i8, *%w2_p2
    %w2_z2 = zext i8 %w2_b2 to i32
    %w2_s8 = shl i32 %w2_z2, 8
    %w2_p3 = gep i8, *%block, 11
    %w2_b3 = load i8, *%w2_p3
    %w2_z3 = zext i8 %w2_b3 to i32
    %w2_o1 = or i32 %w2_s24, %w2_s16
    %w2_o2 = or i32 %w2_o1, %w2_s8
    %w2 = or i32 %w2_o2, %w2_z3

    // Word 3: bytes 12-15 (big-endian)
    %w3_p0 = gep i8, *%block, 12
    %w3_b0 = load i8, *%w3_p0
    %w3_z0 = zext i8 %w3_b0 to i32
    %w3_s24 = shl i32 %w3_z0, 24
    %w3_p1 = gep i8, *%block, 13
    %w3_b1 = load i8, *%w3_p1
    %w3_z1 = zext i8 %w3_b1 to i32
    %w3_s16 = shl i32 %w3_z1, 16
    %w3_p2 = gep i8, *%block, 14
    %w3_b2 = load i8, *%w3_p2
    %w3_z2 = zext i8 %w3_b2 to i32
    %w3_s8 = shl i32 %w3_z2, 8
    %w3_p3 = gep i8, *%block, 15
    %w3_b3 = load i8, *%w3_p3
    %w3_z3 = zext i8 %w3_b3 to i32
    %w3_o1 = or i32 %w3_s24, %w3_s16
    %w3_o2 = or i32 %w3_o1, %w3_s8
    %w3 = or i32 %w3_o2, %w3_z3

    // Word 4: bytes 16-19 (big-endian)
    %w4_p0 = gep i8, *%block, 16
    %w4_b0 = load i8, *%w4_p0
    %w4_z0 = zext i8 %w4_b0 to i32
    %w4_s24 = shl i32 %w4_z0, 24
    %w4_p1 = gep i8, *%block, 17
    %w4_b1 = load i8, *%w4_p1
    %w4_z1 = zext i8 %w4_b1 to i32
    %w4_s16 = shl i32 %w4_z1, 16
    %w4_p2 = gep i8, *%block, 18
    %w4_b2 = load i8, *%w4_p2
    %w4_z2 = zext i8 %w4_b2 to i32
    %w4_s8 = shl i32 %w4_z2, 8
    %w4_p3 = gep i8, *%block, 19
    %w4_b3 = load i8, *%w4_p3
    %w4_z3 = zext i8 %w4_b3 to i32
    %w4_o1 = or i32 %w4_s24, %w4_s16
    %w4_o2 = or i32 %w4_o1, %w4_s8
    %w4 = or i32 %w4_o2, %w4_z3

    // Word 5: bytes 20-23 (big-endian)
    %w5_p0 = gep i8, *%block, 20
    %w5_b0 = load i8, *%w5_p0
    %w5_z0 = zext i8 %w5_b0 to i32
    %w5_s24 = shl i32 %w5_z0, 24
    %w5_p1 = gep i8, *%block, 21
    %w5_b1 = load i8, *%w5_p1
    %w5_z1 = zext i8 %w5_b1 to i32
    %w5_s16 = shl i32 %w5_z1, 16
    %w5_p2 = gep i8, *%block, 22
    %w5_b2 = load i8, *%w5_p2
    %w5_z2 = zext i8 %w5_b2 to i32
    %w5_s8 = shl i32 %w5_z2, 8
    %w5_p3 = gep i8, *%block, 23
    %w5_b3 = load i8, *%w5_p3
    %w5_z3 = zext i8 %w5_b3 to i32
    %w5_o1 = or i32 %w5_s24, %w5_s16
    %w5_o2 = or i32 %w5_o1, %w5_s8
    %w5 = or i32 %w5_o2, %w5_z3

    // Word 6: bytes 24-27 (big-endian)
    %w6_p0 = gep i8, *%block, 24
    %w6_b0 = load i8, *%w6_p0
    %w6_z0 = zext i8 %w6_b0 to i32
    %w6_s24 = shl i32 %w6_z0, 24
    %w6_p1 = gep i8, *%block, 25
    %w6_b1 = load i8, *%w6_p1
    %w6_z1 = zext i8 %w6_b1 to i32
    %w6_s16 = shl i32 %w6_z1, 16
    %w6_p2 = gep i8, *%block, 26
    %w6_b2 = load i8, *%w6_p2
    %w6_z2 = zext i8 %w6_b2 to i32
    %w6_s8 = shl i32 %w6_z2, 8
    %w6_p3 = gep i8, *%block, 27
    %w6_b3 = load i8, *%w6_p3
    %w6_z3 = zext i8 %w6_b3 to i32
    %w6_o1 = or i32 %w6_s24, %w6_s16
    %w6_o2 = or i32 %w6_o1, %w6_s8
    %w6 = or i32 %w6_o2, %w6_z3

    // Word 7: bytes 28-31 (big-endian)
    %w7_p0 = gep i8, *%block, 28
    %w7_b0 = load i8, *%w7_p0
    %w7_z0 = zext i8 %w7_b0 to i32
    %w7_s24 = shl i32 %w7_z0, 24
    %w7_p1 = gep i8, *%block, 29
    %w7_b1 = load i8, *%w7_p1
    %w7_z1 = zext i8 %w7_b1 to i32
    %w7_s16 = shl i32 %w7_z1, 16
    %w7_p2 = gep i8, *%block, 30
    %w7_b2 = load i8, *%w7_p2
    %w7_z2 = zext i8 %w7_b2 to i32
    %w7_s8 = shl i32 %w7_z2, 8
    %w7_p3 = gep i8, *%block, 31
    %w7_b3 = load i8, *%w7_p3
    %w7_z3 = zext i8 %w7_b3 to i32
    %w7_o1 = or i32 %w7_s24, %w7_s16
    %w7_o2 = or i32 %w7_o1, %w7_s8
    %w7 = or i32 %w7_o2, %w7_z3

    // Word 8: bytes 32-35 (big-endian)
    %w8_p0 = gep i8, *%block, 32
    %w8_b0 = load i8, *%w8_p0
    %w8_z0 = zext i8 %w8_b0 to i32
    %w8_s24 = shl i32 %w8_z0, 24
    %w8_p1 = gep i8, *%block, 33
    %w8_b1 = load i8, *%w8_p1
