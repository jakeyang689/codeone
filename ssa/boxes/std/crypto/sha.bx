// SHA-256 message digest implementation
// Processes input data in 64-byte blocks using the SHA-256 compression function.
// Outputs 32 bytes (256 bits) of digest in big-endian byte order.






// Platform dependencies
extern @memset(s: *i8, c: i32, n: i64) -> *i8
extern @c1_cpu_features() -> i64
extern @c1_sha256_transform(a: *i32, b: *i32, c: *i32, d: *i32, e: *i32, f: *i32, g: *i32, h: *i32, block: *i8) -> void

// Internal: process one 64-byte block and update the hash state.
fun @_sha256_transform_sw(aptr: *i32, bptr: *i32, cptr: *i32, dptr: *i32,
                                  eptr: *i32, fptr: *i32, gptr: *i32, hptr: *i32,
                                  block: *i8) -> void {
  @entry:
    // Load current hash state
    %a0 = load i32, *%aptr
    %b0 = load i32, *%bptr
    %c0 = load i32, *%cptr
    %d0 = load i32, *%dptr
    %e0 = load i32, *%eptr
    %f0 = load i32, *%fptr
    %g0 = load i32, *%gptr
    %h0 = load i32, *%hptr

    // Word 0: bytes 0-3 (big-endian)
    %w0_p0 = gep i8, *%block, 0
    %w0_b0 = load i8, *%w0_p0
    %w0_z0 = zext i8 %w0_b0 to i32
    %w0_s24 = shl i32 %w0_z0, 24
    %w0_p1 = gep i8, *%block, 1
    %w0_b1 = load i8, *%w0_p1
    %w0_z1 = zext i8 %w0_b1 to i32
    %w0_s16 = shl i32 %w0_z1, 16
    %w0_p2 = gep i8, *%block, 2
    %w0_b2 = load i8, *%w0_p2
    %w0_z2 = zext i8 %w0_b2 to i32
    %w0_s8 = shl i32 %w0_z2, 8
    %w0_p3 = gep i8, *%block, 3
    %w0_b3 = load i8, *%w0_p3
    %w0_z3 = zext i8 %w0_b3 to i32
    %w0_o1 = or i32 %w0_s24, %w0_s16
    %w0_o2 = or i32 %w0_o1, %w0_s8
    %w0 = or i32 %w0_o2, %w0_z3

    // Word 1: bytes 4-7 (big-endian)
    %w1_p0 = gep i8, *%block, 4
    %w1_b0 = load i8, *%w1_p0
    %w1_z0 = zext i8 %w1_b0 to i32
    %w1_s24 = shl i32 %w1_z0, 24
    %w1_p1 = gep i8, *%block, 5
    %w1_b1 = load i8, *%w1_p1
    %w1_z1 = zext i8 %w1_b1 to i32
    %w1_s16 = shl i32 %w1_z1, 16
    %w1_p2 = gep i8, *%block, 6
    %w1_b2 = load i8, *%w1_p2
    %w1_z2 = zext i8 %w1_b2 to i32
    %w1_s8 = shl i32 %w1_z2, 8
    %w1_p3 = gep i8, *%block, 7
    %w1_b3 = load i8, *%w1_p3
    %w1_z3 = zext i8 %w1_b3 to i32
    %w1_o1 = or i32 %w1_s24, %w1_s16
    %w1_o2 = or i32 %w1_o1, %w1_s8
    %w1 = or i32 %w1_o2, %w1_z3

    // Word 2: bytes 8-11 (big-endian)
    %w2_p0 = gep i8, *%block, 8
    %w2_b0 = load i8, *%w2_p0
    %w2_z0 = zext i8 %w2_b0 to i32
    %w2_s24 = shl i32 %w2_z0, 24
    %w2_p1 = gep i8, *%block, 9
    %w2_b1 = load i8, *%w2_p1
    %w2_z1 = zext i8 %w2_b1 to i32
    %w2_s16 = shl i32 %w2_z1, 16
    %w2_p2 = gep i8, *%block, 10
    %w2_b2 = load i8, *%w2_p2
    %w2_z2 = zext i8 %w2_b2 to i32
    %w2_s8 = shl i32 %w2_z2, 8
    %w2_p3 = gep i8, *%block, 11
    %w2_b3 = load i8, *%w2_p3
    %w2_z3 = zext i8 %w2_b3 to i32
    %w2_o1 = or i32 %w2_s24, %w2_s16
    %w2_o2 = or i32 %w2_o1, %w2_s8
    %w2 = or i32 %w2_o2, %w2_z3

    // Word 3: bytes 12-15 (big-endian)
    %w3_p0 = gep i8, *%block, 12
    %w3_b0 = load i8, *%w3_p0
    %w3_z0 = zext i8 %w3_b0 to i32
    %w3_s24 = shl i32 %w3_z0, 24
    %w3_p1 = gep i8, *%block, 13
    %w3_b1 = load i8, *%w3_p1
    %w3_z1 = zext i8 %w3_b1 to i32
    %w3_s16 = shl i32 %w3_z1, 16
    %w3_p2 = gep i8, *%block, 14
    %w3_b2 = load i8, *%w3_p2
    %w3_z2 = zext i8 %w3_b2 to i32
    %w3_s8 = shl i32 %w3_z2, 8
    %w3_p3 = gep i8, *%block, 15
    %w3_b3 = load i8, *%w3_p3
    %w3_z3 = zext i8 %w3_b3 to i32
    %w3_o1 = or i32 %w3_s24, %w3_s16
    %w3_o2 = or i32 %w3_o1, %w3_s8
    %w3 = or i32 %w3_o2, %w3_z3

    // Word 4: bytes 16-19 (big-endian)
    %w4_p0 = gep i8, *%block, 16
    %w4_b0 = load i8, *%w4_p0
    %w4_z0 = zext i8 %w4_b0 to i32
    %w4_s24 = shl i32 %w4_z0, 24
    %w4_p1 = gep i8, *%block, 17
    %w4_b1 = load i8, *%w4_p1
    %w4_z1 = zext i8 %w4_b1 to i32
    %w4_s16 = shl i32 %w4_z1, 16
    %w4_p2 = gep i8, *%block, 18
    %w4_b2 = load i8, *%w4_p2
    %w4_z2 = zext i8 %w4_b2 to i32
    %w4_s8 = shl i32 %w4_z2, 8
    %w4_p3 = gep i8, *%block, 19
    %w4_b3 = load i8, *%w4_p3
    %w4_z3 = zext i8 %w4_b3 to i32
    %w4_o1 = or i32 %w4_s24, %w4_s16
    %w4_o2 = or i32 %w4_o1, %w4_s8
    %w4 = or i32 %w4_o2, %w4_z3

    // Word 5: bytes 20-23 (big-endian)
    %w5_p0 = gep i8, *%block, 20
    %w5_b0 = load i8, *%w5_p0
    %w5_z0 = zext i8 %w5_b0 to i32
    %w5_s24 = shl i32 %w5_z0, 24
    %w5_p1 = gep i8, *%block, 21
    %w5_b1 = load i8, *%w5_p1
    %w5_z1 = zext i8 %w5_b1 to i32
    %w5_s16 = shl i32 %w5_z1, 16
    %w5_p2 = gep i8, *%block, 22
    %w5_b2 = load i8, *%w5_p2
    %w5_z2 = zext i8 %w5_b2 to i32
    %w5_s8 = shl i32 %w5_z2, 8
    %w5_p3 = gep i8, *%block, 23
    %w5_b3 = load i8, *%w5_p3
    %w5_z3 = zext i8 %w5_b3 to i32
    %w5_o1 = or i32 %w5_s24, %w5_s16
    %w5_o2 = or i32 %w5_o1, %w5_s8
    %w5 = or i32 %w5_o2, %w5_z3

    // Word 6: bytes 24-27 (big-endian)
    %w6_p0 = gep i8, *%block, 24
    %w6_b0 = load i8, *%w6_p0
    %w6_z0 = zext i8 %w6_b0 to i32
    %w6_s24 = shl i32 %w6_z0, 24
    %w6_p1 = gep i8, *%block, 25
    %w6_b1 = load i8, *%w6_p1
    %w6_z1 = zext i8 %w6_b1 to i32
    %w6_s16 = shl i32 %w6_z1, 16
    %w6_p2 = gep i8, *%block, 26
    %w6_b2 = load i8, *%w6_p2
    %w6_z2 = zext i8 %w6_b2 to i32
    %w6_s8 = shl i32 %w6_z2, 8
    %w6_p3 = gep i8, *%block, 27
    %w6_b3 = load i8, *%w6_p3
    %w6_z3 = zext i8 %w6_b3 to i32
    %w6_o1 = or i32 %w6_s24, %w6_s16
    %w6_o2 = or i32 %w6_o1, %w6_s8
    %w6 = or i32 %w6_o2, %w6_z3

    // Word 7: bytes 28-31 (big-endian)
    %w7_p0 = gep i8, *%block, 28
    %w7_b0 = load i8, *%w7_p0
    %w7_z0 = zext i8 %w7_b0 to i32
    %w7_s24 = shl i32 %w7_z0, 24
    %w7_p1 = gep i8, *%block, 29
    %w7_b1 = load i8, *%w7_p1
    %w7_z1 = zext i8 %w7_b1 to i32
    %w7_s16 = shl i32 %w7_z1, 16
    %w7_p2 = gep i8, *%block, 30
    %w7_b2 = load i8, *%w7_p2
    %w7_z2 = zext i8 %w7_b2 to i32
    %w7_s8 = shl i32 %w7_z2, 8
    %w7_p3 = gep i8, *%block, 31
    %w7_b3 = load i8, *%w7_p3
    %w7_z3 = zext i8 %w7_b3 to i32
    %w7_o1 = or i32 %w7_s24, %w7_s16
    %w7_o2 = or i32 %w7_o1, %w7_s8
    %w7 = or i32 %w7_o2, %w7_z3

    // Word 8: bytes 32-35 (big-endian)
    %w8_p0 = gep i8, *%block, 32
    %w8_b0 = load i8, *%w8_p0
    %w8_z0 = zext i8 %w8_b0 to i32
    %w8_s24 = shl i32 %w8_z0, 24
    %w8_p1 = gep i8, *%block, 33
    %w8_b1 = load i8, *%w8_p1
    %w8_z1 = zext i8 %w8_b1 to i32
    %w8_s16 = shl i32 %w8_z1, 16
    %w8_p2 = gep i8, *%block, 34
    %w8_b2 = load i8, *%w8_p2
    %w8_z2 = zext i8 %w8_b2 to i32
    %w8_s8 = shl i32 %w8_z2, 8
    %w8_p3 = gep i8, *%block, 35
    %w8_b3 = load i8, *%w8_p3
    %w8_z3 = zext i8 %w8_b3 to i32
    %w8_o1 = or i32 %w8_s24, %w8_s16
    %w8_o2 = or i32 %w8_o1, %w8_s8
    %w8 = or i32 %w8_o2, %w8_z3

    // Word 9: bytes 36-39 (big-endian)
    %w9_p0 = gep i8, *%block, 36
    %w9_b0 = load i8, *%w9_p0
    %w9_z0 = zext i8 %w9_b0 to i32
    %w9_s24 = shl i32 %w9_z0, 24
    %w9_p1 = gep i8, *%block, 37
    %w9_b1 = load i8, *%w9_p1
    %w9_z1 = zext i8 %w9_b1 to i32
    %w9_s16 = shl i32 %w9_z1, 16
    %w9_p2 = gep i8, *%block, 38
    %w9_b2 = load i8, *%w9_p2
    %w9_z2 = zext i8 %w9_b2 to i32
    %w9_s8 = shl i32 %w9_z2, 8
    %w9_p3 = gep i8, *%block, 39
    %w9_b3 = load i8, *%w9_p3
    %w9_z3 = zext i8 %w9_b3 to i32
    %w9_o1 = or i32 %w9_s24, %w9_s16
    %w9_o2 = or i32 %w9_o1, %w9_s8
    %w9 = or i32 %w9_o2, %w9_z3

    // Word 10: bytes 40-43 (big-endian)
    %w10_p0 = gep i8, *%block, 40
    %w10_b0 = load i8, *%w10_p0
    %w10_z0 = zext i8 %w10_b0 to i32
    %w10_s24 = shl i32 %w10_z0, 24
    %w10_p1 = gep i8, *%block, 41
    %w10_b1 = load i8, *%w10_p1
    %w10_z1 = zext i8 %w10_b1 to i32
    %w10_s16 = shl i32 %w10_z1, 16
    %w10_p2 = gep i8, *%block, 42
    %w10_b2 = load i8, *%w10_p2
    %w10_z2 = zext i8 %w10_b2 to i32
    %w10_s8 = shl i32 %w10_z2, 8
    %w10_p3 = gep i8, *%block, 43
    %w10_b3 = load i8, *%w10_p3
    %w10_z3 = zext i8 %w10_b3 to i32
    %w10_o1 = or i32 %w10_s24, %w10_s16
    %w10_o2 = or i32 %w10_o1, %w10_s8
    %w10 = or i32 %w10_o2, %w10_z3

    // Word 11: bytes 44-47 (big-endian)
    %w11_p0 = gep i8, *%block, 44
    %w11_b0 = load i8, *%w11_p0
    %w11_z0 = zext i8 %w11_b0 to i32
    %w11_s24 = shl i32 %w11_z0, 24
    %w11_p1 = gep i8, *%block, 45
    %w11_b1 = load i8, *%w11_p1
    %w11_z1 = zext i8 %w11_b1 to i32
    %w11_s16 = shl i32 %w11_z1, 16
    %w11_p2 = gep i8, *%block, 46
    %w11_b2 = load i8, *%w11_p2
    %w11_z2 = zext i8 %w11_b2 to i32
    %w11_s8 = shl i32 %w11_z2, 8
    %w11_p3 = gep i8, *%block, 47
    %w11_b3 = load i8, *%w11_p3
    %w11_z3 = zext i8 %w11_b3 to i32
    %w11_o1 = or i32 %w11_s24, %w11_s16
    %w11_o2 = or i32 %w11_o1, %w11_s8
    %w11 = or i32 %w11_o2, %w11_z3

    // Word 12: bytes 48-51 (big-endian)
    %w12_p0 = gep i8, *%block, 48
    %w12_b0 = load i8, *%w12_p0
    %w12_z0 = zext i8 %w12_b0 to i32
    %w12_s24 = shl i32 %w12_z0, 24
    %w12_p1 = gep i8, *%block, 49
    %w12_b1 = load i8, *%w12_p1
    %w12_z1 = zext i8 %w12_b1 to i32
    %w12_s16 = shl i32 %w12_z1, 16
    %w12_p2 = gep i8, *%block, 50
    %w12_b2 = load i8, *%w12_p2
    %w12_z2 = zext i8 %w12_b2 to i32
    %w12_s8 = shl i32 %w12_z2, 8
    %w12_p3 = gep i8, *%block, 51
    %w12_b3 = load i8, *%w12_p3
    %w12_z3 = zext i8 %w12_b3 to i32
    %w12_o1 = or i32 %w12_s24, %w12_s16
    %w12_o2 = or i32 %w12_o1, %w12_s8
    %w12 = or i32 %w12_o2, %w12_z3

    // Word 13: bytes 52-55 (big-endian)
    %w13_p0 = gep i8, *%block, 52
    %w13_b0 = load i8, *%w13_p0
    %w13_z0 = zext i8 %w13_b0 to i32
    %w13_s24 = shl i32 %w13_z0, 24
    %w13_p1 = gep i8, *%block, 53
    %w13_b1 = load i8, *%w13_p1
    %w13_z1 = zext i8 %w13_b1 to i32
    %w13_s16 = shl i32 %w13_z1, 16
    %w13_p2 = gep i8, *%block, 54
    %w13_b2 = load i8, *%w13_p2
    %w13_z2 = zext i8 %w13_b2 to i32
    %w13_s8 = shl i32 %w13_z2, 8
    %w13_p3 = gep i8, *%block, 55
    %w13_b3 = load i8, *%w13_p3
    %w13_z3 = zext i8 %w13_b3 to i32
    %w13_o1 = or i32 %w13_s24, %w13_s16
    %w13_o2 = or i32 %w13_o1, %w13_s8
    %w13 = or i32 %w13_o2, %w13_z3

    // Word 14: bytes 56-59 (big-endian)
    %w14_p0 = gep i8, *%block, 56
    %w14_b0 = load i8, *%w14_p0
    %w14_z0 = zext i8 %w14_b0 to i32
    %w14_s24 = shl i32 %w14_z0, 24
    %w14_p1 = gep i8, *%block, 57
    %w14_b1 = load i8, *%w14_p1
    %w14_z1 = zext i8 %w14_b1 to i32
    %w14_s16 = shl i32 %w14_z1, 16
    %w14_p2 = gep i8, *%block, 58
    %w14_b2 = load i8, *%w14_p2
    %w14_z2 = zext i8 %w14_b2 to i32
    %w14_s8 = shl i32 %w14_z2, 8
    %w14_p3 = gep i8, *%block, 59
    %w14_b3 = load i8, *%w14_p3
    %w14_z3 = zext i8 %w14_b3 to i32
    %w14_o1 = or i32 %w14_s24, %w14_s16
    %w14_o2 = or i32 %w14_o1, %w14_s8
    %w14 = or i32 %w14_o2, %w14_z3

    // Word 15: bytes 60-63 (big-endian)
    %w15_p0 = gep i8, *%block, 60
    %w15_b0 = load i8, *%w15_p0
    %w15_z0 = zext i8 %w15_b0 to i32
    %w15_s24 = shl i32 %w15_z0, 24
    %w15_p1 = gep i8, *%block, 61
    %w15_b1 = load i8, *%w15_p1
    %w15_z1 = zext i8 %w15_b1 to i32
    %w15_s16 = shl i32 %w15_z1, 16
    %w15_p2 = gep i8, *%block, 62
    %w15_b2 = load i8, *%w15_p2
    %w15_z2 = zext i8 %w15_b2 to i32
    %w15_s8 = shl i32 %w15_z2, 8
    %w15_p3 = gep i8, *%block, 63
    %w15_b3 = load i8, *%w15_p3
    %w15_z3 = zext i8 %w15_b3 to i32
    %w15_o1 = or i32 %w15_s24, %w15_s16
    %w15_o2 = or i32 %w15_o1, %w15_s8
    %w15 = or i32 %w15_o2, %w15_z3

    // σ1(W[14]) — ROTR_17 ^ ROTR_19 ^ SHR_10
    %w16_s1_r17a = lshr i32 %w14, 17
    %w16_s1_r17b = shl i32 %w14, 15
    %w16_s1_r17 = or i32 %w16_s1_r17a, %w16_s1_r17b
    %w16_s1_r19a = lshr i32 %w14, 19
    %w16_s1_r19b = shl i32 %w14, 13
    %w16_s1_r19 = or i32 %w16_s1_r19a, %w16_s1_r19b
    %w16_s1_s10 = lshr i32 %w14, 10
    %w16_s1_x1 = xor i32 %w16_s1_r17, %w16_s1_r19
    %w16_s1 = xor i32 %w16_s1_x1, %w16_s1_s10

    // σ0(W[1]) — ROTR_7 ^ ROTR_18 ^ SHR_3
    %w16_s0_r7a = lshr i32 %w1, 7
    %w16_s0_r7b = shl i32 %w1, 25
    %w16_s0_r7 = or i32 %w16_s0_r7a, %w16_s0_r7b
    %w16_s0_r18a = lshr i32 %w1, 18
    %w16_s0_r18b = shl i32 %w1, 14
    %w16_s0_r18 = or i32 %w16_s0_r18a, %w16_s0_r18b
    %w16_s0_s3 = lshr i32 %w1, 3
    %w16_s0_x1 = xor i32 %w16_s0_r7, %w16_s0_r18
    %w16_s0 = xor i32 %w16_s0_x1, %w16_s0_s3

    // W[16] = σ1 + W[9] + σ0 + W[0]
    %w16_a = add i32 %w16_s1, %w9
    %w16_b = add i32 %w16_a, %w16_s0
    %w16 = add i32 %w16_b, %w0

    // σ1(W[15]) — ROTR_17 ^ ROTR_19 ^ SHR_10
    %w17_s1_r17a = lshr i32 %w15, 17
    %w17_s1_r17b = shl i32 %w15, 15
    %w17_s1_r17 = or i32 %w17_s1_r17a, %w17_s1_r17b
    %w17_s1_r19a = lshr i32 %w15, 19
    %w17_s1_r19b = shl i32 %w15, 13
    %w17_s1_r19 = or i32 %w17_s1_r19a, %w17_s1_r19b
    %w17_s1_s10 = lshr i32 %w15, 10
    %w17_s1_x1 = xor i32 %w17_s1_r17, %w17_s1_r19
    %w17_s1 = xor i32 %w17_s1_x1, %w17_s1_s10

    // σ0(W[2]) — ROTR_7 ^ ROTR_18 ^ SHR_3
    %w17_s0_r7a = lshr i32 %w2, 7
    %w17_s0_r7b = shl i32 %w2, 25
    %w17_s0_r7 = or i32 %w17_s0_r7a, %w17_s0_r7b
    %w17_s0_r18a = lshr i32 %w2, 18
    %w17_s0_r18b = shl i32 %w2, 14
