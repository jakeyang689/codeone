        %c74 = or i32 %r73_rot30, 0
        %b74 = or i32 %a73, 0
        %a74 = or i32 %r73_T, 0
    // Round 74: f = Parity(B,C,D), K = 0xCA62C1D6
    %r74_x1 = xor i32 %b74, %c74
    %r74_f = xor i32 %r74_x1, %d74   // f
    %r74_l5 = shl i32 %a74, 5
    %r74_r27 = lshr i32 %a74, 27
    %r74_rot5 = or i32 %r74_l5, %r74_r27  // ROTL5(A)
    %r74_t1 = add i32 %r74_rot5, %r74_f
    %r74_kp = gep i32, *@_sha1_k, 3
    %r74_kv = load i32, *%r74_kp
    %r74_t2 = add i32 %r74_t1, %e74
    %r74_t3 = add i32 %r74_t2, %r74_kv
    %r74_T = add i32 %r74_t3, %w74
    %r74_l30 = shl i32 %b74, 30
    %r74_r2 = lshr i32 %b74, 2
    %r74_rot30 = or i32 %r74_l30, %r74_r2  // ROTL30(B)
        %e75 = or i32 %d74, 0
        %d75 = or i32 %c74, 0
        %c75 = or i32 %r74_rot30, 0
        %b75 = or i32 %a74, 0
        %a75 = or i32 %r74_T, 0
    // Round 75: f = Parity(B,C,D), K = 0xCA62C1D6
    %r75_x1 = xor i32 %b75, %c75
    %r75_f = xor i32 %r75_x1, %d75   // f
    %r75_l5 = shl i32 %a75, 5
    %r75_r27 = lshr i32 %a75, 27
    %r75_rot5 = or i32 %r75_l5, %r75_r27  // ROTL5(A)
    %r75_t1 = add i32 %r75_rot5, %r75_f
    %r75_kp = gep i32, *@_sha1_k, 3
    %r75_kv = load i32, *%r75_kp
    %r75_t2 = add i32 %r75_t1, %e75
    %r75_t3 = add i32 %r75_t2, %r75_kv
    %r75_T = add i32 %r75_t3, %w75
    %r75_l30 = shl i32 %b75, 30
    %r75_r2 = lshr i32 %b75, 2
    %r75_rot30 = or i32 %r75_l30, %r75_r2  // ROTL30(B)
        %e76 = or i32 %d75, 0
        %d76 = or i32 %c75, 0
        %c76 = or i32 %r75_rot30, 0
        %b76 = or i32 %a75, 0
        %a76 = or i32 %r75_T, 0
    // Round 76: f = Parity(B,C,D), K = 0xCA62C1D6
    %r76_x1 = xor i32 %b76, %c76
    %r76_f = xor i32 %r76_x1, %d76   // f
    %r76_l5 = shl i32 %a76, 5
    %r76_r27 = lshr i32 %a76, 27
    %r76_rot5 = or i32 %r76_l5, %r76_r27  // ROTL5(A)
    %r76_t1 = add i32 %r76_rot5, %r76_f
    %r76_kp = gep i32, *@_sha1_k, 3
    %r76_kv = load i32, *%r76_kp
    %r76_t2 = add i32 %r76_t1, %e76
    %r76_t3 = add i32 %r76_t2, %r76_kv
    %r76_T = add i32 %r76_t3, %w76
    %r76_l30 = shl i32 %b76, 30
    %r76_r2 = lshr i32 %b76, 2
    %r76_rot30 = or i32 %r76_l30, %r76_r2  // ROTL30(B)
        %e77 = or i32 %d76, 0
        %d77 = or i32 %c76, 0
        %c77 = or i32 %r76_rot30, 0
        %b77 = or i32 %a76, 0
        %a77 = or i32 %r76_T, 0
    // Round 77: f = Parity(B,C,D), K = 0xCA62C1D6
    %r77_x1 = xor i32 %b77, %c77
    %r77_f = xor i32 %r77_x1, %d77   // f
    %r77_l5 = shl i32 %a77, 5
    %r77_r27 = lshr i32 %a77, 27
    %r77_rot5 = or i32 %r77_l5, %r77_r27  // ROTL5(A)
    %r77_t1 = add i32 %r77_rot5, %r77_f
    %r77_kp = gep i32, *@_sha1_k, 3
    %r77_kv = load i32, *%r77_kp
    %r77_t2 = add i32 %r77_t1, %e77
    %r77_t3 = add i32 %r77_t2, %r77_kv
    %r77_T = add i32 %r77_t3, %w77
    %r77_l30 = shl i32 %b77, 30
    %r77_r2 = lshr i32 %b77, 2
    %r77_rot30 = or i32 %r77_l30, %r77_r2  // ROTL30(B)
        %e78 = or i32 %d77, 0
        %d78 = or i32 %c77, 0
        %c78 = or i32 %r77_rot30, 0
        %b78 = or i32 %a77, 0
        %a78 = or i32 %r77_T, 0
    // Round 78: f = Parity(B,C,D), K = 0xCA62C1D6
    %r78_x1 = xor i32 %b78, %c78
    %r78_f = xor i32 %r78_x1, %d78   // f
    %r78_l5 = shl i32 %a78, 5
    %r78_r27 = lshr i32 %a78, 27
    %r78_rot5 = or i32 %r78_l5, %r78_r27  // ROTL5(A)
    %r78_t1 = add i32 %r78_rot5, %r78_f
    %r78_kp = gep i32, *@_sha1_k, 3
    %r78_kv = load i32, *%r78_kp
    %r78_t2 = add i32 %r78_t1, %e78
    %r78_t3 = add i32 %r78_t2, %r78_kv
    %r78_T = add i32 %r78_t3, %w78
    %r78_l30 = shl i32 %b78, 30
    %r78_r2 = lshr i32 %b78, 2
    %r78_rot30 = or i32 %r78_l30, %r78_r2  // ROTL30(B)
        %e79 = or i32 %d78, 0
        %d79 = or i32 %c78, 0
        %c79 = or i32 %r78_rot30, 0
        %b79 = or i32 %a78, 0
        %a79 = or i32 %r78_T, 0
    // Round 79: f = Parity(B,C,D), K = 0xCA62C1D6
    %r79_x1 = xor i32 %b79, %c79
    %r79_f = xor i32 %r79_x1, %d79   // f
    %r79_l5 = shl i32 %a79, 5
    %r79_r27 = lshr i32 %a79, 27
    %r79_rot5 = or i32 %r79_l5, %r79_r27  // ROTL5(A)
    %r79_t1 = add i32 %r79_rot5, %r79_f
    %r79_kp = gep i32, *@_sha1_k, 3
    %r79_kv = load i32, *%r79_kp
    %r79_t2 = add i32 %r79_t1, %e79
    %r79_t3 = add i32 %r79_t2, %r79_kv
    %r79_T = add i32 %r79_t3, %w79
    %r79_l30 = shl i32 %b79, 30
    %r79_r2 = lshr i32 %b79, 2
    %r79_rot30 = or i32 %r79_l30, %r79_r2  // ROTL30(B)
        %e80 = or i32 %d79, 0
        %d80 = or i32 %c79, 0
        %c80 = or i32 %r79_rot30, 0
        %b80 = or i32 %a79, 0
        %a80 = or i32 %r79_T, 0

    // Add to state and store
    %fa = add i32 %a80, %a0
    %fb = add i32 %b80, %b0
    %fc = add i32 %c80, %c0
    %fd = add i32 %d80, %d0
    %fe = add i32 %e80, %e0
    store i32 %fa, *%aptr
    store i32 %fb, *%bptr
    store i32 %fc, *%cptr
    store i32 %fd, *%dptr
    store i32 %fe, *%eptr
    ret void
}

// ============================================================
// SHA-1 compute — 20-byte digest, 64-byte blocks
// ============================================================

// Public API: compute SHA-1 digest of input data.
// data: input byte array, len: length in bytes, digest: 20-byte output buffer
fun @std_crypto_sha1_compute(data: *i8, len: i32, digest: *i8) -> void {
  @entry:
    // Allocate hash state (5 i32)
    %aptr = let i32
    %bptr = let i32
    %cptr = let i32
    %dptr = let i32
    %eptr = let i32

    // Initialize state (SHA-1 magic constants)
    store i32 0x67452301, *%aptr
    store i32 0xEFCDAB89, *%bptr
    store i32 0x98BADCFE, *%cptr
    store i32 0x10325476, *%dptr
    store i32 0xC3D2E1F0, *%eptr

    // Allocate scratch buffers for padding
    %buf1 = let [i8, 64]
    %buf2 = let [i8, 64]
    %bp1m = gep i8, *%buf1, 0
    %bp2m = gep i8, *%buf2, 0
    %nm64 = let i64
    store i64 64, *%nm64
    %nm64v = load i64, *%nm64
    call @memset(%bp1m, 0, %nm64v)
    call @memset(%bp2m, 0, %nm64v)

    %offset = let i32
    %iptr = let i32
    store i32 0, *%offset
    jmp @s1_block_cond

  @s1_block_cond:
    %off = load i32, *%offset
    %next_off = add i32 %off, 64
    %has_block = sle i32 %next_off, %len
    br %has_block, @s1_process_block, @s1_pad_start

  @s1_process_block:
    %bp = gep i8, *%data, %off
    call @std_crypto_sha1_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %bp)
    store i32 %next_off, *%offset
    jmp @s1_block_cond

  @s1_pad_start:
    %off_val = load i32, *%offset
    %rem = sub i32 %len, %off_val
    %needs_two = sge i32 %rem, 56
    br %needs_two, @s1_pad_two, @s1_pad_one

  @s1_pad_one:
    store i32 0, *%iptr
    jmp @s1_copy_cond

  @s1_pad_two:
    store i32 0, *%iptr
    jmp @s1_copy_cond

  @s1_copy_cond:
    %ci = load i32, *%iptr
    %copy_done = slt i32 %ci, %rem
    br %copy_done, @s1_copy_body, @s1_copy_done

  @s1_copy_body:
    %src_off = add i32 %off_val, %ci
    %src_p = gep i8, *%data, %src_off
    %byte = load i8, *%src_p
    %dst_p = gep i8, *%buf1, %ci
    store i8 %byte, *%dst_p
    %ci_next = add i32 %ci, 1
    store i32 %ci_next, *%iptr
    jmp @s1_copy_cond

  @s1_copy_done:
    %pad80_p = gep i8, *%buf1, %rem
    store i8 0x80, *%pad80_p

    %is_one_block = slt i32 %rem, 56
    br %is_one_block, @s1_one_block, @s1_two_block_a

  @s1_one_block:
    %bl = mul i32 %len, 8
    %bl_s24 = lshr i32 %bl, 24
    %bl_b0 = trunc i32 %bl_s24 to i8
    %bl_s16 = lshr i32 %bl, 16
    %bl_b1 = trunc i32 %bl_s16 to i8
    %bl_s8 = lshr i32 %bl, 8
    %bl_b2 = trunc i32 %bl_s8 to i8
    %bl_b3 = trunc i32 %bl to i8

    %p56 = gep i8, *%buf1, 56
    store i8 0, *%p56
    %p57 = gep i8, *%buf1, 57
    store i8 0, *%p57
    %p58 = gep i8, *%buf1, 58
    store i8 0, *%p58
    %p59 = gep i8, *%buf1, 59
    store i8 0, *%p59
    %p60 = gep i8, *%buf1, 60
    store i8 %bl_b0, *%p60
    %p61 = gep i8, *%buf1, 61
    store i8 %bl_b1, *%p61
    %p62 = gep i8, *%buf1, 62
    store i8 %bl_b2, *%p62
    %p63 = gep i8, *%buf1, 63
    store i8 %bl_b3, *%p63

    %buf1_p = gep i8, *%buf1, 0
    call @std_crypto_sha1_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %buf1_p)
    jmp @s1_write_digest

  @s1_two_block_a:
    %buf1_p2 = gep i8, *%buf1, 0
    call @std_crypto_sha1_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %buf1_p2)

    %bl2 = mul i32 %len, 8
    %bl2_s24 = lshr i32 %bl2, 24
    %bl2_b0 = trunc i32 %bl2_s24 to i8
    %bl2_s16 = lshr i32 %bl2, 16
    %bl2_b1 = trunc i32 %bl2_s16 to i8
    %bl2_s8 = lshr i32 %bl2, 8
    %bl2_b2 = trunc i32 %bl2_s8 to i8
    %bl2_b3 = trunc i32 %bl2 to i8

    %p56_2 = gep i8, *%buf2, 56
    store i8 0, *%p56_2
    %p57_2 = gep i8, *%buf2, 57
    store i8 0, *%p57_2
    %p58_2 = gep i8, *%buf2, 58
    store i8 0, *%p58_2
    %p59_2 = gep i8, *%buf2, 59
    store i8 0, *%p59_2
    %p60_2 = gep i8, *%buf2, 60
    store i8 %bl2_b0, *%p60_2
    %p61_2 = gep i8, *%buf2, 61
    store i8 %bl2_b1, *%p61_2
    %p62_2 = gep i8, *%buf2, 62
    store i8 %bl2_b2, *%p62_2
    %p63_2 = gep i8, *%buf2, 63
    store i8 %bl2_b3, *%p63_2

    %buf2_p = gep i8, *%buf2, 0
    call @std_crypto_sha1_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %buf2_p)
    jmp @s1_write_digest

  @s1_write_digest:
    %a_val = load i32, *%aptr
    %b_val = load i32, *%bptr
    %c_val = load i32, *%cptr
    %d_val = load i32, *%dptr
    %e_val = load i32, *%eptr

    // A bytes 0-3
    %a_b0 = lshr i32 %a_val, 24
    %a_v0 = trunc i32 %a_b0 to i8
    %a_b1 = lshr i32 %a_val, 16
    %a_v1 = trunc i32 %a_b1 to i8
    %a_b2 = lshr i32 %a_val, 8
    %a_v2 = trunc i32 %a_b2 to i8
    %a_v3 = trunc i32 %a_val to i8
    %d0 = gep i8, *%digest, 0
    store i8 %a_v0, *%d0
    %d1 = gep i8, *%digest, 1
    store i8 %a_v1, *%d1
    %d2 = gep i8, *%digest, 2
    store i8 %a_v2, *%d2
    %d3 = gep i8, *%digest, 3
    store i8 %a_v3, *%d3

    // B bytes 4-7
    %b_b0 = lshr i32 %b_val, 24
    %b_v0 = trunc i32 %b_b0 to i8
    %b_b1 = lshr i32 %b_val, 16
    %b_v1 = trunc i32 %b_b1 to i8
    %b_b2 = lshr i32 %b_val, 8
    %b_v2 = trunc i32 %b_b2 to i8
    %b_v3 = trunc i32 %b_val to i8
    %d4 = gep i8, *%digest, 4
    store i8 %b_v0, *%d4
    %d5 = gep i8, *%digest, 5
    store i8 %b_v1, *%d5
    %d6 = gep i8, *%digest, 6
    store i8 %b_v2, *%d6
    %d7 = gep i8, *%digest, 7
    store i8 %b_v3, *%d7

    // C bytes 8-11
    %c_b0 = lshr i32 %c_val, 24
    %c_v0 = trunc i32 %c_b0 to i8
    %c_b1 = lshr i32 %c_val, 16
    %c_v1 = trunc i32 %c_b1 to i8
    %c_b2 = lshr i32 %c_val, 8
    %c_v2 = trunc i32 %c_b2 to i8
    %c_v3 = trunc i32 %c_val to i8
    %d8 = gep i8, *%digest, 8
    store i8 %c_v0, *%d8
    %d9 = gep i8, *%digest, 9
    store i8 %c_v1, *%d9
    %d10 = gep i8, *%digest, 10
    store i8 %c_v2, *%d10
    %d11 = gep i8, *%digest, 11
    store i8 %c_v3, *%d11

    // D bytes 12-15
    %d_b0 = lshr i32 %d_val, 24
    %d_v0 = trunc i32 %d_b0 to i8
    %d_b1 = lshr i32 %d_val, 16
    %d_v1 = trunc i32 %d_b1 to i8
    %d_b2 = lshr i32 %d_val, 8
    %d_v2 = trunc i32 %d_b2 to i8
    %d_v3 = trunc i32 %d_val to i8
    %d12 = gep i8, *%digest, 12
    store i8 %d_v0, *%d12
    %d13 = gep i8, *%digest, 13
    store i8 %d_v1, *%d13
    %d14 = gep i8, *%digest, 14
    store i8 %d_v2, *%d14
    %d15 = gep i8, *%digest, 15
    store i8 %d_v3, *%d15

    // E bytes 16-19
    %e_b0 = lshr i32 %e_val, 24
    %e_v0 = trunc i32 %e_b0 to i8
    %e_b1 = lshr i32 %e_val, 16
    %e_v1 = trunc i32 %e_b1 to i8
    %e_b2 = lshr i32 %e_val, 8
    %e_v2 = trunc i32 %e_b2 to i8
    %e_v3 = trunc i32 %e_val to i8
    %d16 = gep i8, *%digest, 16
    store i8 %e_v0, *%d16
    %d17 = gep i8, *%digest, 17
    store i8 %e_v1, *%d17
    %d18 = gep i8, *%digest, 18
    store i8 %e_v2, *%d18
    %d19 = gep i8, *%digest, 19
    store i8 %e_v3, *%d19
    ret void
}

// ============================================================
// SHA-512 message digest implementation
// 80 rounds, 512-bit (64 byte) output, 128-byte blocks, big-endian
// ============================================================

// SHA-512 round constants
const @_sha512_k: [i64, 80] = [
  0x428A2F98D728AE22, 0x7137449123EF65CD, -5349999486874862801, -1606136188198331460,
  0x3956C25BF348B538, 0x59F111F1B605D019, -7908458776815382629, -6116909921290321640,
  -2880145864133508542, 0x12835B0145706FBE, 0x243185BE4EE4B28C, 0x550C7DC3D5FFB4E2,
  0x72BE5D74F27B896F, -9160688886553864527, -7215885187991268811, -4495734319001033068,
  -1973867731355612462, -1171420211273849373, 0x0FC19DC68B8CD5B5, 0x240CA1CC77AC9C65,
  0x2DE92C6F592B0275, 0x4A7484AA6EA6E483, 0x5CB0A9DCBD41FBD4, 0x76F988DA831153B5,
  -7476448914759557205, -6327057829258317296, -5763719355590565569, -4658551843659510044,
  -4116276920077217854, -3051310485924567259, 0x06CA6351E003826F, 0x142929670A0E6E70,
  0x27B70A8546D22FFC, 0x2E1B21385C26C926, 0x4D2C6DFC5AC42AED, 0x53380D139D95B3DF,
  0x650A73548BAF63DE, 0x766A0ABB3C77B2A8, -9096487096722542874, -7894198246740708037,
  -6719396339535248540, -6333637450476146687, -4446306890439682159, -4076793802049405392,
  -3345356375505022440, -2983346525034927856, -860691631967231958, 0x106AA07032BBD1B8,
  0x19A4C116B8D2D0C8, 0x1E376C085141AB53, 0x2748774CDF8EEB99, 0x34B0BCB5E19B48A8,
  0x391C0CB3C5C95A63, 0x4ED8AA4AE3418ACB, 0x5B9CCA4F7763E373, 0x682E6FF3D6B2B8A3,
  0x748F82EE5DEFB2FC, 0x78A5636F43172F60, -8878714635349349518, -8302665154208450068,
  -8016688836872298968, -6606660893046293015, -4685533653050689259, -4147400797238176981,
  -3880063495543823972, -3348786107499101689, -1523767162380948706, -757361751448694408,
  0x06F067AA72176FBA, 0x0A637DC5A2C898A6, 0x113F9804BEF90DAE, 0x1B710B35131C471B,
  0x28DB77F523047D84, 0x32CAAB7B40C72493, 0x3C9EBE0A15C9BEBC, 0x431D67C49C100D4C,
  0x4CC5D4BECB3E42B6, 0x597F299CFC657E2A, 0x5FCB6FAB3AD6FAEC, 0x6C44198C4A475817
]

// Transform: process one 128-byte block (SHA-512)
fun @std_crypto_sha512_transform(aptr: *i64, bptr: *i64, cptr: *i64, dptr: *i64,
                                 eptr: *i64, fptr: *i64, gptr: *i64, hptr: *i64,
                                 block: *i8) -> void {
  @entry:
    %a0 = load i64, *%aptr
    %b0 = load i64, *%bptr
    %c0 = load i64, *%cptr
    %d0 = load i64, *%dptr
    %e0 = load i64, *%eptr
    %f0 = load i64, *%fptr
    %g0 = load i64, *%gptr
    %h0 = load i64, *%hptr

    // Word 0: bytes 0-7 (big-endian 64-bit)
    %w0_p0 = gep i8, *%block, 0
    %w0_b0 = load i8, *%w0_p0
    %w0_z0 = zext i8 %w0_b0 to i64
    %w0_s56 = shl i64 %w0_z0, 56
    %w0_p1 = gep i8, *%block, 1
    %w0_b1 = load i8, *%w0_p1
    %w0_z1 = zext i8 %w0_b1 to i64
    %w0_s48 = shl i64 %w0_z1, 48
    %w0_p2 = gep i8, *%block, 2
    %w0_b2 = load i8, *%w0_p2
    %w0_z2 = zext i8 %w0_b2 to i64
    %w0_s40 = shl i64 %w0_z2, 40
    %w0_p3 = gep i8, *%block, 3
    %w0_b3 = load i8, *%w0_p3
    %w0_z3 = zext i8 %w0_b3 to i64
