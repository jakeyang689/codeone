    %r79_t1c = add i64 %r79_t1b, %r79_kv
    %r79_T1 = add i64 %r79_t1c, %w79
    %r79_s0_r28a = lshr i64 %a79, 28
    %r79_s0_r28b = shl i64 %a79, 36
    %r79_s0_r28 = or i64 %r79_s0_r28a, %r79_s0_r28b
    %r79_s0_r34a = lshr i64 %a79, 34
    %r79_s0_r34b = shl i64 %a79, 30
    %r79_s0_r34 = or i64 %r79_s0_r34a, %r79_s0_r34b
    %r79_s0_r39a = lshr i64 %a79, 39
    %r79_s0_r39b = shl i64 %a79, 25
    %r79_s0_r39 = or i64 %r79_s0_r39a, %r79_s0_r39b
    %r79_s0_x1 = xor i64 %r79_s0_r28, %r79_s0_r34
    %r79_s0 = xor i64 %r79_s0_x1, %r79_s0_r39
    %r79_m_a1 = and i64 %a79, %b79
    %r79_m_a2 = and i64 %a79, %c79
    %r79_m_a3 = and i64 %b79, %c79
    %r79_m_x1 = xor i64 %r79_m_a1, %r79_m_a2
    %r79_Maj = xor i64 %r79_m_x1, %r79_m_a3
    %r79_T2 = add i64 %r79_s0, %r79_Maj
    %h80 = or i64 %g79, 0
    %g80 = or i64 %f79, 0
    %f80 = or i64 %e79, 0
    %e80 = add i64 %d79, %r79_T1
    %d80 = or i64 %c79, 0
    %c80 = or i64 %b79, 0
    %b80 = or i64 %a79, 0
    %a80 = add i64 %r79_T1, %r79_T2

    // Add to saved state and store
    %fa = add i64 %a80, %a0
    %fb = add i64 %b80, %b0
    %fc = add i64 %c80, %c0
    %fd = add i64 %d80, %d0
    %fe = add i64 %e80, %e0
    %ff = add i64 %f80, %f0
    %fg = add i64 %g80, %g0
    %fh = add i64 %h80, %h0
    store i64 %fa, *%aptr
    store i64 %fb, *%bptr
    store i64 %fc, *%cptr
    store i64 %fd, *%dptr
    store i64 %fe, *%eptr
    store i64 %ff, *%fptr
    store i64 %fg, *%gptr
    store i64 %fh, *%hptr
    ret void
}

// ============================================================
// SHA-512 compute — 64-byte digest, 128-byte blocks
// ============================================================

// Public API: compute SHA-512 digest of input data.
// data: input byte array, len: length in bytes, digest: 64-byte output buffer
fun @std_crypto_sha512_compute(data: *i8, len: i32, digest: *i8) -> void {
  @entry:
    // Allocate hash state (8 i64)
    %aptr = let i64
    %bptr = let i64
    %cptr = let i64
    %dptr = let i64
    %eptr = let i64
    %fptr = let i64
    %gptr = let i64
    %hptr = let i64

    // Initialize state (SHA-512 magic constants)
    store i64 0x6A09E667F3BCC908, *%aptr
    store i64 -4942790177534073029, *%bptr
    store i64 0x3C6EF372FE94F82B, *%cptr
    store i64 -6534734903238641935, *%dptr
    store i64 0x510E527FADE682D1, *%eptr
    store i64 -7276294671716946913, *%fptr
    store i64 0x1F83D9ABFB41BD6B, *%gptr
    store i64 0x5BE0CD19137E2179, *%hptr

    // Buffers for padding (128 bytes each)
    %buf1 = let [i8, 128]
    %buf2 = let [i8, 128]
    %bp1m = gep i8, *%buf1, 0
    %bp2m = gep i8, *%buf2, 0
    %nm128 = let i64
    store i64 128, *%nm128
    %nm128v = load i64, *%nm128
    call @memset(%bp1m, 0, %nm128v)
    call @memset(%bp2m, 0, %nm128v)

    %offset = let i32
    %iptr = let i32
    store i32 0, *%offset
    jmp @s512_block_cond

  @s512_block_cond:
    %off = load i32, *%offset
    %next_off = add i32 %off, 128
    %has_block = sle i32 %next_off, %len
    br %has_block, @s512_process_block, @s512_pad_start

  @s512_process_block:
    %bp = gep i8, *%data, %off
    call @std_crypto_sha512_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %bp)
    store i32 %next_off, *%offset
    jmp @s512_block_cond

  @s512_pad_start:
    %off_val = load i32, *%offset
    %rem = sub i32 %len, %off_val
    %needs_two = sge i32 %rem, 112
    br %needs_two, @s512_pad_two, @s512_pad_one

  @s512_pad_one:
    store i32 0, *%iptr
    jmp @s512_copy_cond

  @s512_pad_two:
    store i32 0, *%iptr
    jmp @s512_copy_cond

  @s512_copy_cond:
    %ci = load i32, *%iptr
    %copy_done = slt i32 %ci, %rem
    br %copy_done, @s512_copy_body, @s512_copy_done

  @s512_copy_body:
    %src_off = add i32 %off_val, %ci
    %src_p = gep i8, *%data, %src_off
    %byte = load i8, *%src_p
    %dst_p = gep i8, *%buf1, %ci
    store i8 %byte, *%dst_p
    %ci_next = add i32 %ci, 1
    store i32 %ci_next, *%iptr
    jmp @s512_copy_cond

  @s512_copy_done:
    %pad80_p = gep i8, *%buf1, %rem
    store i8 0x80, *%pad80_p

    %is_one_block = slt i32 %rem, 112
    br %is_one_block, @s512_one_block, @s512_two_block_a

  @s512_one_block:
    // 128-bit bit length in bytes 112-119 (high) and 120-127 (low)
    // For len fit in i32: high 64 bits = 0
    %len64 = zext i32 %len to i64
    %bl = mul i64 %len64, 8
    %bl_s56 = lshr i64 %bl, 56
    %bl_b56 = trunc i64 %bl_s56 to i8
    %bl_s48 = lshr i64 %bl, 48
    %bl_b48 = trunc i64 %bl_s48 to i8
    %bl_s40 = lshr i64 %bl, 40
    %bl_b40 = trunc i64 %bl_s40 to i8
    %bl_s32 = lshr i64 %bl, 32
    %bl_b32 = trunc i64 %bl_s32 to i8
    %bl_s24 = lshr i64 %bl, 24
    %bl_b24 = trunc i64 %bl_s24 to i8
    %bl_s16 = lshr i64 %bl, 16
    %bl_b16 = trunc i64 %bl_s16 to i8
    %bl_s8 = lshr i64 %bl, 8
    %bl_b8 = trunc i64 %bl_s8 to i8
    %bl_b0 = trunc i64 %bl to i8

    // Bytes 112-119 = 0 (high 64 bits of 128-bit length)
    %p112 = gep i8, *%buf1, 112
    store i8 0, *%p112
    %p113 = gep i8, *%buf1, 113
    store i8 0, *%p113
    %p114 = gep i8, *%buf1, 114
    store i8 0, *%p114
    %p115 = gep i8, *%buf1, 115
    store i8 0, *%p115
    %p116 = gep i8, *%buf1, 116
    store i8 0, *%p116
    %p117 = gep i8, *%buf1, 117
    store i8 0, *%p117
    %p118 = gep i8, *%buf1, 118
    store i8 0, *%p118
    %p119 = gep i8, *%buf1, 119
    store i8 0, *%p119
    // Bytes 120-127 = bit length (big-endian 64-bit)
    %p120 = gep i8, *%buf1, 120
    store i8 %bl_b56, *%p120
    %p121 = gep i8, *%buf1, 121
    store i8 %bl_b48, *%p121
    %p122 = gep i8, *%buf1, 122
    store i8 %bl_b40, *%p122
    %p123 = gep i8, *%buf1, 123
    store i8 %bl_b32, *%p123
    %p124 = gep i8, *%buf1, 124
    store i8 %bl_b24, *%p124
    %p125 = gep i8, *%buf1, 125
    store i8 %bl_b16, *%p125
    %p126 = gep i8, *%buf1, 126
    store i8 %bl_b8, *%p126
    %p127 = gep i8, *%buf1, 127
    store i8 %bl_b0, *%p127

    %buf1_p = gep i8, *%buf1, 0
    call @std_crypto_sha512_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf1_p)
    jmp @s512_write_digest

  @s512_two_block_a:
    %buf1_p2 = gep i8, *%buf1, 0
    call @std_crypto_sha512_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf1_p2)

    %len64b = zext i32 %len to i64
    %bl2 = mul i64 %len64b, 8
    %bl2_s56 = lshr i64 %bl2, 56
    %bl2_b56 = trunc i64 %bl2_s56 to i8
    %bl2_s48 = lshr i64 %bl2, 48
    %bl2_b48 = trunc i64 %bl2_s48 to i8
    %bl2_s40 = lshr i64 %bl2, 40
    %bl2_b40 = trunc i64 %bl2_s40 to i8
    %bl2_s32 = lshr i64 %bl2, 32
    %bl2_b32 = trunc i64 %bl2_s32 to i8
    %bl2_s24 = lshr i64 %bl2, 24
    %bl2_b24 = trunc i64 %bl2_s24 to i8
    %bl2_s16 = lshr i64 %bl2, 16
    %bl2_b16 = trunc i64 %bl2_s16 to i8
    %bl2_s8 = lshr i64 %bl2, 8
    %bl2_b8 = trunc i64 %bl2_s8 to i8
    %bl2_b0 = trunc i64 %bl2 to i8

    %p112_2 = gep i8, *%buf2, 112
    store i8 0, *%p112_2
    %p113_2 = gep i8, *%buf2, 113
    store i8 0, *%p113_2
    %p114_2 = gep i8, *%buf2, 114
    store i8 0, *%p114_2
    %p115_2 = gep i8, *%buf2, 115
    store i8 0, *%p115_2
    %p116_2 = gep i8, *%buf2, 116
    store i8 0, *%p116_2
    %p117_2 = gep i8, *%buf2, 117
    store i8 0, *%p117_2
    %p118_2 = gep i8, *%buf2, 118
    store i8 0, *%p118_2
    %p119_2 = gep i8, *%buf2, 119
    store i8 0, *%p119_2
    %p120_2 = gep i8, *%buf2, 120
    store i8 %bl2_b56, *%p120_2
    %p121_2 = gep i8, *%buf2, 121
    store i8 %bl2_b48, *%p121_2
    %p122_2 = gep i8, *%buf2, 122
    store i8 %bl2_b40, *%p122_2
    %p123_2 = gep i8, *%buf2, 123
    store i8 %bl2_b32, *%p123_2
    %p124_2 = gep i8, *%buf2, 124
    store i8 %bl2_b24, *%p124_2
    %p125_2 = gep i8, *%buf2, 125
    store i8 %bl2_b16, *%p125_2
    %p126_2 = gep i8, *%buf2, 126
    store i8 %bl2_b8, *%p126_2
    %p127_2 = gep i8, *%buf2, 127
    store i8 %bl2_b0, *%p127_2

    %buf2_p = gep i8, *%buf2, 0
    call @std_crypto_sha512_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf2_p)
    jmp @s512_write_digest

  @s512_write_digest:
    %a_val = load i64, *%aptr
    %b_val = load i64, *%bptr
    %c_val = load i64, *%cptr
    %d_val = load i64, *%dptr
    %e_val = load i64, *%eptr
    %f_val = load i64, *%fptr
    %g_val = load i64, *%gptr
    %h_val = load i64, *%hptr

    // A bytes 0-7
    %a_s56 = lshr i64 %a_val, 56
    %a_b0 = trunc i64 %a_s56 to i8
    %d0 = gep i8, *%digest, 0
    store i8 %a_b0, *%d0
    %a_s48 = lshr i64 %a_val, 48
    %a_b1 = trunc i64 %a_s48 to i8
    %d1 = gep i8, *%digest, 1
    store i8 %a_b1, *%d1
    %a_s40 = lshr i64 %a_val, 40
    %a_b2 = trunc i64 %a_s40 to i8
    %d2 = gep i8, *%digest, 2
    store i8 %a_b2, *%d2
    %a_s32 = lshr i64 %a_val, 32
    %a_b3 = trunc i64 %a_s32 to i8
    %d3 = gep i8, *%digest, 3
    store i8 %a_b3, *%d3
    %a_s24 = lshr i64 %a_val, 24
    %a_b4 = trunc i64 %a_s24 to i8
    %d4 = gep i8, *%digest, 4
    store i8 %a_b4, *%d4
    %a_s16 = lshr i64 %a_val, 16
    %a_b5 = trunc i64 %a_s16 to i8
    %d5 = gep i8, *%digest, 5
    store i8 %a_b5, *%d5
    %a_s8 = lshr i64 %a_val, 8
    %a_b6 = trunc i64 %a_s8 to i8
    %d6 = gep i8, *%digest, 6
    store i8 %a_b6, *%d6
    %a_b7 = trunc i64 %a_val to i8
    %d7 = gep i8, *%digest, 7
    store i8 %a_b7, *%d7
    // B bytes 8-15
    %b_s56 = lshr i64 %b_val, 56
    %b_b0 = trunc i64 %b_s56 to i8
    %d8 = gep i8, *%digest, 8
    store i8 %b_b0, *%d8
    %b_s48 = lshr i64 %b_val, 48
    %b_b1 = trunc i64 %b_s48 to i8
    %d9 = gep i8, *%digest, 9
    store i8 %b_b1, *%d9
    %b_s40 = lshr i64 %b_val, 40
    %b_b2 = trunc i64 %b_s40 to i8
    %d10 = gep i8, *%digest, 10
    store i8 %b_b2, *%d10
    %b_s32 = lshr i64 %b_val, 32
    %b_b3 = trunc i64 %b_s32 to i8
    %d11 = gep i8, *%digest, 11
    store i8 %b_b3, *%d11
    %b_s24 = lshr i64 %b_val, 24
    %b_b4 = trunc i64 %b_s24 to i8
    %d12 = gep i8, *%digest, 12
    store i8 %b_b4, *%d12
    %b_s16 = lshr i64 %b_val, 16
    %b_b5 = trunc i64 %b_s16 to i8
    %d13 = gep i8, *%digest, 13
    store i8 %b_b5, *%d13
    %b_s8 = lshr i64 %b_val, 8
    %b_b6 = trunc i64 %b_s8 to i8
    %d14 = gep i8, *%digest, 14
    store i8 %b_b6, *%d14
    %b_b7 = trunc i64 %b_val to i8
    %d15 = gep i8, *%digest, 15
    store i8 %b_b7, *%d15
    // C bytes 16-23
    %c_s56 = lshr i64 %c_val, 56
    %c_b0 = trunc i64 %c_s56 to i8
    %d16 = gep i8, *%digest, 16
    store i8 %c_b0, *%d16
    %c_s48 = lshr i64 %c_val, 48
    %c_b1 = trunc i64 %c_s48 to i8
    %d17 = gep i8, *%digest, 17
    store i8 %c_b1, *%d17
    %c_s40 = lshr i64 %c_val, 40
    %c_b2 = trunc i64 %c_s40 to i8
    %d18 = gep i8, *%digest, 18
    store i8 %c_b2, *%d18
    %c_s32 = lshr i64 %c_val, 32
    %c_b3 = trunc i64 %c_s32 to i8
    %d19 = gep i8, *%digest, 19
    store i8 %c_b3, *%d19
    %c_s24 = lshr i64 %c_val, 24
    %c_b4 = trunc i64 %c_s24 to i8
    %d20 = gep i8, *%digest, 20
    store i8 %c_b4, *%d20
    %c_s16 = lshr i64 %c_val, 16
    %c_b5 = trunc i64 %c_s16 to i8
    %d21 = gep i8, *%digest, 21
    store i8 %c_b5, *%d21
    %c_s8 = lshr i64 %c_val, 8
    %c_b6 = trunc i64 %c_s8 to i8
    %d22 = gep i8, *%digest, 22
    store i8 %c_b6, *%d22
    %c_b7 = trunc i64 %c_val to i8
    %d23 = gep i8, *%digest, 23
    store i8 %c_b7, *%d23
    // D bytes 24-31
    %d_s56 = lshr i64 %d_val, 56
    %d_b0 = trunc i64 %d_s56 to i8
    %d24 = gep i8, *%digest, 24
    store i8 %d_b0, *%d24
    %d_s48 = lshr i64 %d_val, 48
    %d_b1 = trunc i64 %d_s48 to i8
    %d25 = gep i8, *%digest, 25
    store i8 %d_b1, *%d25
    %d_s40 = lshr i64 %d_val, 40
    %d_b2 = trunc i64 %d_s40 to i8
    %d26 = gep i8, *%digest, 26
    store i8 %d_b2, *%d26
    %d_s32 = lshr i64 %d_val, 32
    %d_b3 = trunc i64 %d_s32 to i8
    %d27 = gep i8, *%digest, 27
    store i8 %d_b3, *%d27
    %d_s24 = lshr i64 %d_val, 24
    %d_b4 = trunc i64 %d_s24 to i8
    %d28 = gep i8, *%digest, 28
    store i8 %d_b4, *%d28
    %d_s16 = lshr i64 %d_val, 16
    %d_b5 = trunc i64 %d_s16 to i8
    %d29 = gep i8, *%digest, 29
    store i8 %d_b5, *%d29
    %d_s8 = lshr i64 %d_val, 8
    %d_b6 = trunc i64 %d_s8 to i8
    %d30 = gep i8, *%digest, 30
    store i8 %d_b6, *%d30
    %d_b7 = trunc i64 %d_val to i8
    %d31 = gep i8, *%digest, 31
    store i8 %d_b7, *%d31
    // E bytes 32-39
    %e_s56 = lshr i64 %e_val, 56
    %e_b0 = trunc i64 %e_s56 to i8
    %d32 = gep i8, *%digest, 32
    store i8 %e_b0, *%d32
    %e_s48 = lshr i64 %e_val, 48
    %e_b1 = trunc i64 %e_s48 to i8
    %d33 = gep i8, *%digest, 33
    store i8 %e_b1, *%d33
    %e_s40 = lshr i64 %e_val, 40
    %e_b2 = trunc i64 %e_s40 to i8
    %d34 = gep i8, *%digest, 34
    store i8 %e_b2, *%d34
    %e_s32 = lshr i64 %e_val, 32
    %e_b3 = trunc i64 %e_s32 to i8
    %d35 = gep i8, *%digest, 35
    store i8 %e_b3, *%d35
    %e_s24 = lshr i64 %e_val, 24
    %e_b4 = trunc i64 %e_s24 to i8
    %d36 = gep i8, *%digest, 36
    store i8 %e_b4, *%d36
    %e_s16 = lshr i64 %e_val, 16
    %e_b5 = trunc i64 %e_s16 to i8
    %d37 = gep i8, *%digest, 37
    store i8 %e_b5, *%d37
    %e_s8 = lshr i64 %e_val, 8
    %e_b6 = trunc i64 %e_s8 to i8
    %d38 = gep i8, *%digest, 38
    store i8 %e_b6, *%d38
    %e_b7 = trunc i64 %e_val to i8
    %d39 = gep i8, *%digest, 39
    store i8 %e_b7, *%d39
    // F bytes 40-47
    %f_s56 = lshr i64 %f_val, 56
    %f_b0 = trunc i64 %f_s56 to i8
    %d40 = gep i8, *%digest, 40
    store i8 %f_b0, *%d40
    %f_s48 = lshr i64 %f_val, 48
    %f_b1 = trunc i64 %f_s48 to i8
    %d41 = gep i8, *%digest, 41
    store i8 %f_b1, *%d41
    %f_s40 = lshr i64 %f_val, 40
    %f_b2 = trunc i64 %f_s40 to i8
    %d42 = gep i8, *%digest, 42
    store i8 %f_b2, *%d42
    %f_s32 = lshr i64 %f_val, 32
    %f_b3 = trunc i64 %f_s32 to i8
    %d43 = gep i8, *%digest, 43
    store i8 %f_b3, *%d43
    %f_s24 = lshr i64 %f_val, 24
    %f_b4 = trunc i64 %f_s24 to i8
    %d44 = gep i8, *%digest, 44
    store i8 %f_b4, *%d44
    %f_s16 = lshr i64 %f_val, 16
    %f_b5 = trunc i64 %f_s16 to i8
    %d45 = gep i8, *%digest, 45
    store i8 %f_b5, *%d45
    %f_s8 = lshr i64 %f_val, 8
    %f_b6 = trunc i64 %f_s8 to i8
    %d46 = gep i8, *%digest, 46
    store i8 %f_b6, *%d46
    %f_b7 = trunc i64 %f_val to i8
    %d47 = gep i8, *%digest, 47
    store i8 %f_b7, *%d47
    // G bytes 48-55
    %g_s56 = lshr i64 %g_val, 56
    %g_b0 = trunc i64 %g_s56 to i8
    %d48 = gep i8, *%digest, 48
    store i8 %g_b0, *%d48
    %g_s48 = lshr i64 %g_val, 48
    %g_b1 = trunc i64 %g_s48 to i8
    %d49 = gep i8, *%digest, 49
    store i8 %g_b1, *%d49
    %g_s40 = lshr i64 %g_val, 40
    %g_b2 = trunc i64 %g_s40 to i8
    %d50 = gep i8, *%digest, 50
    store i8 %g_b2, *%d50
    %g_s32 = lshr i64 %g_val, 32
    %g_b3 = trunc i64 %g_s32 to i8
    %d51 = gep i8, *%digest, 51
    store i8 %g_b3, *%d51
    %g_s24 = lshr i64 %g_val, 24
    %g_b4 = trunc i64 %g_s24 to i8
    %d52 = gep i8, *%digest, 52
    store i8 %g_b4, *%d52
    %g_s16 = lshr i64 %g_val, 16
    %g_b5 = trunc i64 %g_s16 to i8
    %d53 = gep i8, *%digest, 53
    store i8 %g_b5, *%d53
    %g_s8 = lshr i64 %g_val, 8
    %g_b6 = trunc i64 %g_s8 to i8
    %d54 = gep i8, *%digest, 54
    store i8 %g_b6, *%d54
    %g_b7 = trunc i64 %g_val to i8
    %d55 = gep i8, *%digest, 55
    store i8 %g_b7, *%d55
    // H bytes 56-63
    %h_s56 = lshr i64 %h_val, 56
    %h_b0 = trunc i64 %h_s56 to i8
    %d56 = gep i8, *%digest, 56
    store i8 %h_b0, *%d56
    %h_s48 = lshr i64 %h_val, 48
    %h_b1 = trunc i64 %h_s48 to i8
    %d57 = gep i8, *%digest, 57
    store i8 %h_b1, *%d57
    %h_s40 = lshr i64 %h_val, 40
    %h_b2 = trunc i64 %h_s40 to i8
    %d58 = gep i8, *%digest, 58
    store i8 %h_b2, *%d58
    %h_s32 = lshr i64 %h_val, 32
    %h_b3 = trunc i64 %h_s32 to i8
    %d59 = gep i8, *%digest, 59
    store i8 %h_b3, *%d59
    %h_s24 = lshr i64 %h_val, 24
    %h_b4 = trunc i64 %h_s24 to i8
    %d60 = gep i8, *%digest, 60
    store i8 %h_b4, *%d60
    %h_s16 = lshr i64 %h_val, 16
    %h_b5 = trunc i64 %h_s16 to i8
    %d61 = gep i8, *%digest, 61
    store i8 %h_b5, *%d61
    %h_s8 = lshr i64 %h_val, 8
    %h_b6 = trunc i64 %h_s8 to i8
    %d62 = gep i8, *%digest, 62
    store i8 %h_b6, *%d62
    %h_b7 = trunc i64 %h_val to i8
    %d63 = gep i8, *%digest, 63
    store i8 %h_b7, *%d63
    ret void
}


// ============================================================
// SHA-384 compute — 48-byte digest, 128-byte blocks (SHA-512 with different IV + truncation)
// ============================================================

// Public API: compute SHA-384 digest of input data.
// data: input byte array, len: length in bytes, digest: 48-byte output buffer
fun @std_crypto_sha384_compute(data: *i8, len: i32, digest: *i8) -> void {
  @entry:
    %aptr = let i64
    %bptr = let i64
    %cptr = let i64
    %dptr = let i64
    %eptr = let i64
    %fptr = let i64
    %gptr = let i64
    %hptr = let i64

    // Initialize state (SHA-384 magic constants)
    store i64 -3766243637369397544, *%aptr
    store i64 0x629A292A367CD507, *%bptr
    store i64 -7973340178411365097, *%cptr
    store i64 0x152FECD8F70E5939, *%dptr
    store i64 0x67332667FFC00B31, *%eptr
    store i64 -8163818279084223215, *%fptr
    store i64 -2662702644619276377, *%gptr
    store i64 0x47B5481DBEFA4FA4, *%hptr

    // Buffers (128 bytes each)
    %buf1 = let [i8, 128]
    %buf2 = let [i8, 128]
    %bp1m = gep i8, *%buf1, 0
    %bp2m = gep i8, *%buf2, 0
    %nm128 = let i64
    store i64 128, *%nm128
    %nm128v = load i64, *%nm128
    call @memset(%bp1m, 0, %nm128v)
    call @memset(%bp2m, 0, %nm128v)

    %offset = let i32
    %iptr = let i32
    store i32 0, *%offset
    jmp @s384_block_cond

  @s384_block_cond:
    %off = load i32, *%offset
    %next_off = add i32 %off, 128
    %has_block = sle i32 %next_off, %len
    br %has_block, @s384_process_block, @s384_pad_start

  @s384_process_block:
    %bp = gep i8, *%data, %off
    call @std_crypto_sha512_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %bp)
    store i32 %next_off, *%offset
    jmp @s384_block_cond

  @s384_pad_start:
    %off_val = load i32, *%offset
    %rem = sub i32 %len, %off_val
    %needs_two = sge i32 %rem, 112
    br %needs_two, @s384_pad_two, @s384_pad_one

  @s384_pad_one:
    store i32 0, *%iptr
    jmp @s384_copy_cond

  @s384_pad_two:
    store i32 0, *%iptr
    jmp @s384_copy_cond

  @s384_copy_cond:
    %ci = load i32, *%iptr
    %copy_done = slt i32 %ci, %rem
    br %copy_done, @s384_copy_body, @s384_copy_done

  @s384_copy_body:
    %src_off = add i32 %off_val, %ci
    %src_p = gep i8, *%data, %src_off
    %byte = load i8, *%src_p
    %dst_p = gep i8, *%buf1, %ci
    store i8 %byte, *%dst_p
    %ci_next = add i32 %ci, 1
    store i32 %ci_next, *%iptr
    jmp @s384_copy_cond

  @s384_copy_done:
    %pad80_p = gep i8, *%buf1, %rem
    store i8 0x80, *%pad80_p

    %is_one_block = slt i32 %rem, 112
    br %is_one_block, @s384_one_block, @s384_two_block_a

  @s384_one_block:
    %len64 = zext i32 %len to i64
    %bl = mul i64 %len64, 8
    %bl_s56 = lshr i64 %bl, 56
    %bl_b56 = trunc i64 %bl_s56 to i8
    %bl_s48 = lshr i64 %bl, 48
    %bl_b48 = trunc i64 %bl_s48 to i8
    %bl_s40 = lshr i64 %bl, 40
    %bl_b40 = trunc i64 %bl_s40 to i8
    %bl_s32 = lshr i64 %bl, 32
    %bl_b32 = trunc i64 %bl_s32 to i8
    %bl_s24 = lshr i64 %bl, 24
    %bl_b24 = trunc i64 %bl_s24 to i8
    %bl_s16 = lshr i64 %bl, 16
    %bl_b16 = trunc i64 %bl_s16 to i8
    %bl_s8 = lshr i64 %bl, 8
    %bl_b8 = trunc i64 %bl_s8 to i8
    %bl_b0 = trunc i64 %bl to i8

    %p112 = gep i8, *%buf1, 112
    store i8 0, *%p112
    %p113 = gep i8, *%buf1, 113
    store i8 0, *%p113
    %p114 = gep i8, *%buf1, 114
    store i8 0, *%p114
    %p115 = gep i8, *%buf1, 115
    store i8 0, *%p115
    %p116 = gep i8, *%buf1, 116
    store i8 0, *%p116
    %p117 = gep i8, *%buf1, 117
    store i8 0, *%p117
    %p118 = gep i8, *%buf1, 118
    store i8 0, *%p118
    %p119 = gep i8, *%buf1, 119
    store i8 0, *%p119
    %p120 = gep i8, *%buf1, 120
    store i8 %bl_b56, *%p120
    %p121 = gep i8, *%buf1, 121
    store i8 %bl_b48, *%p121
    %p122 = gep i8, *%buf1, 122
    store i8 %bl_b40, *%p122
    %p123 = gep i8, *%buf1, 123
    store i8 %bl_b32, *%p123
    %p124 = gep i8, *%buf1, 124
    store i8 %bl_b24, *%p124
    %p125 = gep i8, *%buf1, 125
    store i8 %bl_b16, *%p125
    %p126 = gep i8, *%buf1, 126
    store i8 %bl_b8, *%p126
    %p127 = gep i8, *%buf1, 127
    store i8 %bl_b0, *%p127

    call @std_crypto_sha512_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf1)
    jmp @s384_write_digest

  @s384_two_block_a:
    call @std_crypto_sha512_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf1)

    %len64c = zext i32 %len to i64
    %bl2 = mul i64 %len64c, 8
    %bl2_s56 = lshr i64 %bl2, 56
    %bl2_b56 = trunc i64 %bl2_s56 to i8
    %bl2_s48 = lshr i64 %bl2, 48
    %bl2_b48 = trunc i64 %bl2_s48 to i8
    %bl2_s40 = lshr i64 %bl2, 40
    %bl2_b40 = trunc i64 %bl2_s40 to i8
    %bl2_s32 = lshr i64 %bl2, 32
    %bl2_b32 = trunc i64 %bl2_s32 to i8
    %bl2_s24 = lshr i64 %bl2, 24
    %bl2_b24 = trunc i64 %bl2_s24 to i8
    %bl2_s16 = lshr i64 %bl2, 16
    %bl2_b16 = trunc i64 %bl2_s16 to i8
    %bl2_s8 = lshr i64 %bl2, 8
    %bl2_b8 = trunc i64 %bl2_s8 to i8
    %bl2_b0 = trunc i64 %bl2 to i8

    %p112_2 = gep i8, *%buf2, 112
    store i8 0, *%p112_2
    %p113_2 = gep i8, *%buf2, 113
    store i8 0, *%p113_2
    %p114_2 = gep i8, *%buf2, 114
    store i8 0, *%p114_2
    %p115_2 = gep i8, *%buf2, 115
    store i8 0, *%p115_2
    %p116_2 = gep i8, *%buf2, 116
    store i8 0, *%p116_2
    %p117_2 = gep i8, *%buf2, 117
    store i8 0, *%p117_2
    %p118_2 = gep i8, *%buf2, 118
    store i8 0, *%p118_2
    %p119_2 = gep i8, *%buf2, 119
    store i8 0, *%p119_2
    %p120_2 = gep i8, *%buf2, 120
    store i8 %bl2_b56, *%p120_2
    %p121_2 = gep i8, *%buf2, 121
    store i8 %bl2_b48, *%p121_2
    %p122_2 = gep i8, *%buf2, 122
    store i8 %bl2_b40, *%p122_2
    %p123_2 = gep i8, *%buf2, 123
    store i8 %bl2_b32, *%p123_2
    %p124_2 = gep i8, *%buf2, 124
    store i8 %bl2_b24, *%p124_2
    %p125_2 = gep i8, *%buf2, 125
    store i8 %bl2_b16, *%p125_2
    %p126_2 = gep i8, *%buf2, 126
    store i8 %bl2_b8, *%p126_2
    %p127_2 = gep i8, *%buf2, 127
    store i8 %bl2_b0, *%p127_2

    call @std_crypto_sha512_transform(%aptr, %bptr, %cptr, %dptr, %eptr, %fptr, %gptr, %hptr, %buf2)
    jmp @s384_write_digest

  @s384_write_digest:
    // First 6 i64s (48 bytes) out of 8
    %a_val = load i64, *%aptr
    %b_val = load i64, *%bptr
    %c_val = load i64, *%cptr
    %d_val = load i64, *%dptr
    %e_val = load i64, *%eptr
    %f_val = load i64, *%fptr

    // A bytes 0-7
    %a_s56 = lshr i64 %a_val, 56
    %a_b0 = trunc i64 %a_s56 to i8
    %d0 = gep i8, *%digest, 0
    store i8 %a_b0, *%d0
    %a_s48 = lshr i64 %a_val, 48
    %a_b1 = trunc i64 %a_s48 to i8
    %d1 = gep i8, *%digest, 1
    store i8 %a_b1, *%d1
    %a_s40 = lshr i64 %a_val, 40
    %a_b2 = trunc i64 %a_s40 to i8
    %d2 = gep i8, *%digest, 2
    store i8 %a_b2, *%d2
    %a_s32 = lshr i64 %a_val, 32
    %a_b3 = trunc i64 %a_s32 to i8
    %d3 = gep i8, *%digest, 3
    store i8 %a_b3, *%d3
    %a_s24 = lshr i64 %a_val, 24
    %a_b4 = trunc i64 %a_s24 to i8
    %d4 = gep i8, *%digest, 4
    store i8 %a_b4, *%d4
    %a_s16 = lshr i64 %a_val, 16
    %a_b5 = trunc i64 %a_s16 to i8
    %d5 = gep i8, *%digest, 5
    store i8 %a_b5, *%d5
    %a_s8 = lshr i64 %a_val, 8
    %a_b6 = trunc i64 %a_s8 to i8
    %d6 = gep i8, *%digest, 6
    store i8 %a_b6, *%d6
    %a_b7 = trunc i64 %a_val to i8
    %d7 = gep i8, *%digest, 7
    store i8 %a_b7, *%d7
    // B bytes 8-15
    %b_s56 = lshr i64 %b_val, 56
    %b_b0 = trunc i64 %b_s56 to i8
    %d8 = gep i8, *%digest, 8
    store i8 %b_b0, *%d8
    %b_s48 = lshr i64 %b_val, 48
    %b_b1 = trunc i64 %b_s48 to i8
    %d9 = gep i8, *%digest, 9
    store i8 %b_b1, *%d9
    %b_s40 = lshr i64 %b_val, 40
    %b_b2 = trunc i64 %b_s40 to i8
    %d10 = gep i8, *%digest, 10
    store i8 %b_b2, *%d10
    %b_s32 = lshr i64 %b_val, 32
    %b_b3 = trunc i64 %b_s32 to i8
    %d11 = gep i8, *%digest, 11
    store i8 %b_b3, *%d11
    %b_s24 = lshr i64 %b_val, 24
    %b_b4 = trunc i64 %b_s24 to i8
    %d12 = gep i8, *%digest, 12
    store i8 %b_b4, *%d12
    %b_s16 = lshr i64 %b_val, 16
    %b_b5 = trunc i64 %b_s16 to i8
    %d13 = gep i8, *%digest, 13
    store i8 %b_b5, *%d13
    %b_s8 = lshr i64 %b_val, 8
    %b_b6 = trunc i64 %b_s8 to i8
    %d14 = gep i8, *%digest, 14
    store i8 %b_b6, *%d14
    %b_b7 = trunc i64 %b_val to i8
    %d15 = gep i8, *%digest, 15
    store i8 %b_b7, *%d15
    // C bytes 16-23
    %c_s56 = lshr i64 %c_val, 56
    %c_b0 = trunc i64 %c_s56 to i8
    %d16 = gep i8, *%digest, 16
    store i8 %c_b0, *%d16
    %c_s48 = lshr i64 %c_val, 48
    %c_b1 = trunc i64 %c_s48 to i8
    %d17 = gep i8, *%digest, 17
    store i8 %c_b1, *%d17
    %c_s40 = lshr i64 %c_val, 40
    %c_b2 = trunc i64 %c_s40 to i8
    %d18 = gep i8, *%digest, 18
    store i8 %c_b2, *%d18
    %c_s32 = lshr i64 %c_val, 32
    %c_b3 = trunc i64 %c_s32 to i8
    %d19 = gep i8, *%digest, 19
    store i8 %c_b3, *%d19
    %c_s24 = lshr i64 %c_val, 24
    %c_b4 = trunc i64 %c_s24 to i8
    %d20 = gep i8, *%digest, 20
    store i8 %c_b4, *%d20
    %c_s16 = lshr i64 %c_val, 16
    %c_b5 = trunc i64 %c_s16 to i8
    %d21 = gep i8, *%digest, 21
    store i8 %c_b5, *%d21
    %c_s8 = lshr i64 %c_val, 8
    %c_b6 = trunc i64 %c_s8 to i8
    %d22 = gep i8, *%digest, 22
    store i8 %c_b6, *%d22
    %c_b7 = trunc i64 %c_val to i8
    %d23 = gep i8, *%digest, 23
    store i8 %c_b7, *%d23
    // D bytes 24-31
    %d_s56 = lshr i64 %d_val, 56
    %d_b0 = trunc i64 %d_s56 to i8
    %d24 = gep i8, *%digest, 24
    store i8 %d_b0, *%d24
    %d_s48 = lshr i64 %d_val, 48
    %d_b1 = trunc i64 %d_s48 to i8
    %d25 = gep i8, *%digest, 25
    store i8 %d_b1, *%d25
    %d_s40 = lshr i64 %d_val, 40
    %d_b2 = trunc i64 %d_s40 to i8
    %d26 = gep i8, *%digest, 26
    store i8 %d_b2, *%d26
    %d_s32 = lshr i64 %d_val, 32
    %d_b3 = trunc i64 %d_s32 to i8
    %d27 = gep i8, *%digest, 27
    store i8 %d_b3, *%d27
    %d_s24 = lshr i64 %d_val, 24
    %d_b4 = trunc i64 %d_s24 to i8
    %d28 = gep i8, *%digest, 28
    store i8 %d_b4, *%d28
    %d_s16 = lshr i64 %d_val, 16
    %d_b5 = trunc i64 %d_s16 to i8
    %d29 = gep i8, *%digest, 29
    store i8 %d_b5, *%d29
    %d_s8 = lshr i64 %d_val, 8
    %d_b6 = trunc i64 %d_s8 to i8
    %d30 = gep i8, *%digest, 30
    store i8 %d_b6, *%d30
    %d_b7 = trunc i64 %d_val to i8
    %d31 = gep i8, *%digest, 31
    store i8 %d_b7, *%d31
    // E bytes 32-39
    %e_s56 = lshr i64 %e_val, 56
    %e_b0 = trunc i64 %e_s56 to i8
    %d32 = gep i8, *%digest, 32
    store i8 %e_b0, *%d32
    %e_s48 = lshr i64 %e_val, 48
    %e_b1 = trunc i64 %e_s48 to i8
    %d33 = gep i8, *%digest, 33
    store i8 %e_b1, *%d33
    %e_s40 = lshr i64 %e_val, 40
    %e_b2 = trunc i64 %e_s40 to i8
    %d34 = gep i8, *%digest, 34
    store i8 %e_b2, *%d34
    %e_s32 = lshr i64 %e_val, 32
    %e_b3 = trunc i64 %e_s32 to i8
    %d35 = gep i8, *%digest, 35
    store i8 %e_b3, *%d35
    %e_s24 = lshr i64 %e_val, 24
    %e_b4 = trunc i64 %e_s24 to i8
    %d36 = gep i8, *%digest, 36
    store i8 %e_b4, *%d36
    %e_s16 = lshr i64 %e_val, 16
    %e_b5 = trunc i64 %e_s16 to i8
    %d37 = gep i8, *%digest, 37
    store i8 %e_b5, *%d37
    %e_s8 = lshr i64 %e_val, 8
    %e_b6 = trunc i64 %e_s8 to i8
    %d38 = gep i8, *%digest, 38
    store i8 %e_b6, *%d38
    %e_b7 = trunc i64 %e_val to i8
    %d39 = gep i8, *%digest, 39
    store i8 %e_b7, *%d39
    // F bytes 40-47
    %f_s56 = lshr i64 %f_val, 56
    %f_b0 = trunc i64 %f_s56 to i8
    %d40 = gep i8, *%digest, 40
    store i8 %f_b0, *%d40
    %f_s48 = lshr i64 %f_val, 48
    %f_b1 = trunc i64 %f_s48 to i8
    %d41 = gep i8, *%digest, 41
    store i8 %f_b1, *%d41
    %f_s40 = lshr i64 %f_val, 40
    %f_b2 = trunc i64 %f_s40 to i8
    %d42 = gep i8, *%digest, 42
    store i8 %f_b2, *%d42
    %f_s32 = lshr i64 %f_val, 32
    %f_b3 = trunc i64 %f_s32 to i8
    %d43 = gep i8, *%digest, 43
    store i8 %f_b3, *%d43
    %f_s24 = lshr i64 %f_val, 24
    %f_b4 = trunc i64 %f_s24 to i8
    %d44 = gep i8, *%digest, 44
    store i8 %f_b4, *%d44
    %f_s16 = lshr i64 %f_val, 16
    %f_b5 = trunc i64 %f_s16 to i8
    %d45 = gep i8, *%digest, 45
    store i8 %f_b5, *%d45
    %f_s8 = lshr i64 %f_val, 8
    %f_b6 = trunc i64 %f_s8 to i8
    %d46 = gep i8, *%digest, 46
    store i8 %f_b6, *%d46
    %f_b7 = trunc i64 %f_val to i8
    %d47 = gep i8, *%digest, 47
    store i8 %f_b7, *%d47
    ret void
}