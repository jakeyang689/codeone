// RSASSA-PSS verification (RFC 8017 §8.1 / §9.1) with SHA-256 and
// salt length equal to the digest length (32), as required by TLS 1.3.
//
// All digests go through std_crypto_sha256_compute(), which dispatches to the
// platform's hardware SHA-256 transform when available. The RSA operation uses
// the Montgomery modular exponentiation in rsa.bx.

extern @memcpy(dst: *i8, src: *i8, n: i64) -> *i8
extern @memset(s: *i8, c: i32, n: i64) -> *i8
extern @memcmp(a: *i8, b: *i8, n: i64) -> i32

extern @std_crypto_sha256_compute(data: *i8, len: i32, digest: *i8) -> void
extern @c1_random_buf(buf: *i8, len: i64) -> void
extern @std_crypto_rsa_bn_from_bytes(r: *i32, bytes: *i8, byte_len: i32,
                                     limbs: i32) -> void
extern @std_crypto_rsa_bn_to_bytes(bytes: *i8, a: *i32, byte_len: i32,
                                   limbs: i32) -> void
extern @std_crypto_rsa_bn_mod_pow_mont(r: *i32, base: *i32, exp: *i32,
                                       exp_limbs: i32, n: *i32,
                                       limbs: i32) -> void

// Bit length of a little-endian limb array.
fun @_rsa_bn_bitlen(a: *i32, limbs: i32) -> i32 {
  @entry:
    %i = let i32
    %top = sub i32 %limbs, 1
    store i32 %top, *%i
    jmp @find
  @find:
    %iv = load i32, *%i
    %neg = slt i32 %iv, 0
    br %neg, @zero, @check
  @check:
    %iv2 = load i32, *%i
    %p = gep i32, *%a, %iv2
    %v = load i32, *%p
    %vz = eq i32 %v, 0
    br %vz, @next, @count
  @next:
    %iv3 = load i32, *%i
    %n = sub i32 %iv3, 1
    store i32 %n, *%i
    jmp @find
  @count:
    %iv4 = load i32, *%i
    %p2 = gep i32, *%a, %iv4
    %v2 = load i32, *%p2
    %b = let i32
    store i32 0, *%b
    jmp @cnt_cond
  @cnt_cond:
    %bv = load i32, *%b
    %lim = sge i32 %bv, 32
    br %lim, @cnt_done, @cnt_shift
  @cnt_shift:
    %sh = lshr i32 %v2, %bv
    %shz = eq i32 %sh, 0
    br %shz, @cnt_done, @cnt_inc
  @cnt_inc:
    %bv2 = load i32, *%b
    %bn = add i32 %bv2, 1
    store i32 %bn, *%b
    jmp @cnt_cond
  @cnt_done:
    %iv5 = load i32, *%i
    %base = shl i32 %iv5, 5
    %bits = load i32, *%b
    %r = add i32 %base, %bits
    ret i32 %r
  @zero:
    ret i32 0
}

// MGF1 with SHA-256: out = Hash(seed || counter_be32) repeated.
fun @_rsa_mgf1_sha256(seed: *i8, seed_len: i32, out: *i8, out_len: i32) -> void {
  @entry:
    %inbuf = let [i8, 96]
    %inp = gep i8, *%inbuf, 0
    %hbuf = let [i8, 32]
    %hp = gep i8, *%hbuf, 0
    %counter = let i32
    store i32 0, *%counter
    %written = let i32
    store i32 0, *%written
    jmp @loop
  @loop:
    %w = load i32, *%written
    %done = sge i32 %w, %out_len
    br %done, @finished, @iter
  @iter:
    %sl64 = sext i32 %seed_len to i64
    call @memcpy(%inp, %seed, %sl64)
    %c = load i32, *%counter
    %cp = gep i8, *%inbuf, %seed_len
    %c0 = lshr i32 %c, 24
    %c0b = trunc i32 %c0 to i8
    store i8 %c0b, *%cp
    %cp1 = gep i8, *%cp, 1
    %c1 = lshr i32 %c, 16
    %c1b = trunc i32 %c1 to i8
    store i8 %c1b, *%cp1
    %cp2 = gep i8, *%cp, 2
    %c2 = lshr i32 %c, 8
    %c2b = trunc i32 %c2 to i8
    store i8 %c2b, *%cp2
    %cp3 = gep i8, *%cp, 3
    %c3b = trunc i32 %c to i8
    store i8 %c3b, *%cp3
    %tot = add i32 %seed_len, 4
    call @std_crypto_sha256_compute(%inp, %tot, %hp)
    // take = min(32, out_len - written)
    %w2 = load i32, *%written
    %rem = sub i32 %out_len, %w2
    %big = sgt i32 %rem, 32
    br %big, @take32, @take_rem
  @take32:
    jmp @have_take
  @take_rem:
    jmp @have_take
  @have_take:
    %take = phi i32 [ 32, @take32 ], [ %rem, @take_rem ]
    %dst = gep i8, *%out, %w2
    %t64 = sext i32 %take to i64
    call @memcpy(%dst, %hp, %t64)
    %nw = add i32 %w2, %take
    store i32 %nw, *%written
    %nc = load i32, *%counter
    %ncn = add i32 %nc, 1
    store i32 %ncn, *%counter
    jmp @loop
  @finished:
    ret void
}

// Verify RSASSA-PSS over a SHA-256 digest.
//
//   hash     - 32-byte SHA-256 digest of the signed message
//   sig      - signature, sig_len bytes, big-endian
//   e/n      - RSA public exponent (e_limbs) and modulus (limbs)
//
// Returns 1 when the signature is valid, 0 otherwise.
fun @std_crypto_rsa_verify_pss_sha256(hash: *i8, sig: *i8, sig_len: i32,
                                      e: *i32, e_limbs: i32,
                                      n: *i32, limbs: i32) -> i1 {
  @entry:
    %limbs_ok = sle i32 %limbs, 128
    br %limbs_ok, @modbits, @bad
  @modbits:
    %mbits = call @_rsa_bn_bitlen(%n, %limbs)
    %mb_ok = sgt i32 %mbits, 0
    br %mb_ok, @sizes, @bad
  @sizes:
    %k0 = add i32 %mbits, 7
    %k = lshr i32 %k0, 3
    %k_ok = sle i32 %k, 512
    br %k_ok, @emlen, @bad
  @emlen:
    %emb = sub i32 %mbits, 1
    %em0 = add i32 %emb, 7
    %emlen = lshr i32 %em0, 3
    %len_ok = eq i32 %sig_len, %k
    br %len_ok, @minlen, @bad
  @minlen:
    %min_ok = sge i32 %emlen, 66
    br %min_ok, @rsavp1, @bad
  @rsavp1:
    // m = sig^e mod n
    %sbn = let [i32, 128]
    %sbnp = gep i32, *%sbn, 0
    call @std_crypto_rsa_bn_from_bytes(%sbnp, %sig, %sig_len, %limbs)
    %m = let [i32, 128]
    %mp = gep i32, *%m, 0
    call @std_crypto_rsa_bn_mod_pow_mont(%mp, %sbnp, %e, %e_limbs, %n, %limbs)
    %kbuf = let [i8, 512]
    %kbp = gep i8, *%kbuf, 0
    call @std_crypto_rsa_bn_to_bytes(%kbp, %mp, %k, %limbs)
    %emoff = let i32
    store i32 0, *%emoff
    %shorter = slt i32 %emlen, %k
    br %shorter, @lead, @em_ready
  @lead:
    // I2OSP to k bytes; when emLen < k the leading byte must be zero.
    %lead_v = load i8, *%kbp
    %lead_z = eq i8 %lead_v, 0
    br %lead_z, @lead_ok, @bad
  @lead_ok:
    store i32 1, *%emoff
    jmp @em_ready
  @em_ready:
    %eov = load i32, *%emoff
    %em = gep i8, *%kbp, %eov
    %last_off = sub i32 %emlen, 1
    %last_p = gep i8, *%em, %last_off
    %last_v = load i8, *%last_p
    %is_bc = eq i8 %last_v, 0xBC
    br %is_bc, @split, @bad
  @split:
    // maskedDB = EM[0 .. emLen-33], H = EM[emLen-33 .. emLen-1]
    %dblen = sub i32 %emlen, 33
    %hpss = gep i8, *%em, %dblen
    %e8 = shl i32 %emlen, 3
    %unused = sub i32 %e8, %emb
    %unused_z = eq i32 %unused, 0
    br %unused_z, @mask, @check_top
  @check_top:
    // The top 8*emLen - emBits bits of maskedDB must be zero.
    %sh = sub i32 8, %unused
    %b0 = load i8, *%em
    %b0z = zext i8 %b0 to i32
    %shr = lshr i32 %b0z, %sh
    %top_ok = eq i32 %shr, 0
    br %top_ok, @mask, @bad
  @mask:
    %dbmask = let [i8, 512]
    %dbmp = gep i8, *%dbmask, 0
    call @_rsa_mgf1_sha256(%hpss, 32, %dbmp, %dblen)
    %db = let [i8, 512]
    %dbp = gep i8, *%db, 0
    %x = let i32
    store i32 0, *%x
    jmp @xor_cond
  @xor_cond:
    %xv = load i32, *%x
    %xd = sge i32 %xv, %dblen
    br %xd, @xor_done, @xor_body
  @xor_body:
    %xv2 = load i32, *%x
    %ep = gep i8, *%em, %xv2
    %ev = load i8, *%ep
    %dmp = gep i8, *%dbmp, %xv2
    %dmv = load i8, *%dmp
    %xo = xor i8 %ev, %dmv
    %dp = gep i8, *%dbp, %xv2
    store i8 %xo, *%dp
    %xn = add i32 %xv2, 1
    store i32 %xn, *%x
    jmp @xor_cond
  @xor_done:
    br %unused_z, @ps, @clear_top
  @clear_top:
    // Zero the top `unused` bits of DB[0].
    %sh2 = sub i32 8, %unused
    %one = shl i32 1, %sh2
    %maskv = sub i32 %one, 1
    %b0d = load i8, *%dbp
    %b0dz = zext i8 %b0d to i32
    %andv = and i32 %b0dz, %maskv
    %andb = trunc i32 %andv to i8
    store i8 %andb, *%dbp
    jmp @ps
  @ps:
    // DB = PS (zeros) || 0x01 || salt, with 32-byte salt.
    %pslen = sub i32 %emlen, 66
    %z = let i32
    store i32 0, *%z
    jmp @ps_cond
  @ps_cond:
    %zv = load i32, *%z
    %zdone = sge i32 %zv, %pslen
    br %zdone, @sep, @ps_body
  @ps_body:
    %zv2 = load i32, *%z
    %zp = gep i8, *%dbp, %zv2
    %zvv = load i8, *%zp
    %z_iszero = eq i8 %zvv, 0
    br %z_iszero, @ps_next, @bad
  @ps_next:
    %zv3 = load i32, *%z
    %zn = add i32 %zv3, 1
    store i32 %zn, *%z
    jmp @ps_cond
  @sep:
    %sep_p = gep i8, *%dbp, %pslen
    %sep_v = load i8, *%sep_p
    %sep_ok = eq i8 %sep_v, 1
    br %sep_ok, @salt, @bad
  @salt:
    %salt_off = add i32 %pslen, 1
    %salt = gep i8, *%dbp, %salt_off
    // m' = 0x00 * 8 || mHash || salt
    %mprime = let [i8, 72]
    %mpp = gep i8, *%mprime, 0
    call @memset(%mpp, 0, 8)
    %h2p = gep i8, *%mprime, 8
    call @memcpy(%h2p, %hash, 32)
    %s2p = gep i8, *%mprime, 40
    call @memcpy(%s2p, %salt, 32)
    %hprime = let [i8, 32]
    %hpp = gep i8, *%hprime, 0
    call @std_crypto_sha256_compute(%mpp, 72, %hpp)
    %cmp = call @memcmp(%hpp, %hpss, 32)
    %same = eq i32 %cmp, 0
    ret i1 %same
  @bad:
    ret i1 0
}

// Sign a SHA-256 digest with RSASSA-PSS using a 32-byte random salt.
// Returns 0 on success, -1 on unsupported sizes.
fun @std_crypto_rsa_sign_pss_sha256(hash: *i8, d: *i32, n: *i32,
                                    limbs: i32, signature: *i8) -> i32 {
  @entry:
    %limbs_ok = sle i32 %limbs, 128
    br %limbs_ok, @modbits, @bad
  @modbits:
    %mbits = call @_rsa_bn_bitlen(%n, %limbs)
    %mb_ok = sgt i32 %mbits, 0
    br %mb_ok, @sizes, @bad
  @sizes:
    %k0 = add i32 %mbits, 7
    %k = lshr i32 %k0, 3
    %k_ok = sle i32 %k, 512
    br %k_ok, @emlen, @bad
  @emlen:
    %emb = sub i32 %mbits, 1
    %em0 = add i32 %emb, 7
    %emlen = lshr i32 %em0, 3
    %min_ok = sge i32 %emlen, 66
    br %min_ok, @build, @bad
  @build:
    %dblen = sub i32 %emlen, 33
    %pslen = sub i32 %emlen, 66
    %em = let [i8, 512]
    %emp = gep i8, *%em, 0
    %dbl64 = sext i32 %dblen to i64
    call @memset(%emp, 0, %dbl64)
    %sep = gep i8, *%emp, %pslen
    store i8 1, *%sep
    %sep1 = add i32 %pslen, 1
    %saltp = gep i8, *%emp, %sep1
    call @c1_random_buf(%saltp, 32)
    // H = SHA256(0x00 * 8 || mHash || salt)
    %mprime = let [i8, 72]
    %mpp = gep i8, *%mprime, 0
    call @memset(%mpp, 0, 8)
    %h2p = gep i8, *%mpp, 8
    call @memcpy(%h2p, %hash, 32)
    %s2p = gep i8, *%mpp, 40
    call @memcpy(%s2p, %saltp, 32)
    %hpss = gep i8, *%emp, %dblen
    call @std_crypto_sha256_compute(%mpp, 72, %hpss)
    // maskedDB = DB xor MGF1(H, dbLen)
    %dbmask = let [i8, 512]
    %dbmp = gep i8, *%dbmask, 0
    call @_rsa_mgf1_sha256(%hpss, 32, %dbmp, %dblen)
    %xi = let i32
    store i32 0, *%xi
    jmp @xor_cond
  @xor_cond:
    %xv = load i32, *%xi
    %xd = sge i32 %xv, %dblen
    br %xd, @xor_done, @xor_body
  @xor_body:
    %xv2 = load i32, *%xi
    %ep = gep i8, *%emp, %xv2
    %ev = load i8, *%ep
    %mp2 = gep i8, *%dbmp, %xv2
    %mv = load i8, *%mp2
    %xo = xor i8 %ev, %mv
    store i8 %xo, *%ep
    %xn = add i32 %xv2, 1
    store i32 %xn, *%xi
    jmp @xor_cond
  @xor_done:
    // Clear the top 8*emLen - emBits bits.
    %e8 = shl i32 %emlen, 3
    %unused = sub i32 %e8, %emb
    %uz = eq i32 %unused, 0
    br %uz, @tail, @clear
  @clear:
    %sh = sub i32 8, %unused
    %one = shl i32 1, %sh
    %maskv = sub i32 %one, 1
    %b0 = load i8, *%emp
    %b0z = zext i8 %b0 to i32
    %andv = and i32 %b0z, %maskv
    %andb = trunc i32 %andv to i8
    store i8 %andb, *%emp
    jmp @tail
  @tail:
    %last_off = sub i32 %emlen, 1
    %last_p = gep i8, *%emp, %last_off
    store i8 0xBC, *%last_p
    // I2OSP to k bytes; pad with a leading zero when emLen == k-1.
    %embuf = let [i8, 512]
    %ebufp = gep i8, *%embuf, 0
    %shorter = slt i32 %emlen, %k
    br %shorter, @lead, @copy_em
  @lead:
    store i8 0, *%ebufp
    %dst = gep i8, *%ebufp, 1
    %em64 = sext i32 %emlen to i64
    call @memcpy(%dst, %emp, %em64)
    jmp @rsa
  @copy_em:
    %k64 = sext i32 %k to i64
    call @memcpy(%ebufp, %emp, %k64)
    jmp @rsa
  @rsa:
    %m_bn = let [i32, 128]
    %c_bn = let [i32, 128]
    %mbp = gep i32, *%m_bn, 0
    %cbp = gep i32, *%c_bn, 0
    call @std_crypto_rsa_bn_from_bytes(%mbp, %ebufp, %k, %limbs)
    call @std_crypto_rsa_bn_mod_pow_mont(%cbp, %mbp, %d, %limbs, %n, %limbs)
    call @std_crypto_rsa_bn_to_bytes(%signature, %cbp, %k, %limbs)
    ret i32 0
  @bad:
    ret i32 -1
}
