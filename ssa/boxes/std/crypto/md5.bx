    %i59_r = lshr i32 %i59_4, 11
    %i59_o = or i32 %i59_l, %i59_r
    %r59 = add i32 %i59_o, %r58

    // Step 60: g=4, s=6, K=0xf7537e82, first=a
    // I(%r59,%r58,%r57) = %r58 ^ (%r59 | ~%r57); a = %r59 + ROL(%r56 + I + M[4] + K[60], 6)
    %i60_nz = xor i32 %r57, 0xFFFFFFFF
    %i60_0 = or i32 %r59, %i60_nz
    %i60_1 = xor i32 %r58, %i60_0
    %i60_2 = add i32 %r56, %i60_1
    %i60_3 = add i32 %i60_2, %w4
    %i60_4 = add i32 %i60_3, 0xF7537E82
    %i60_l = shl i32 %i60_4, 6
    %i60_r = lshr i32 %i60_4, 26
    %i60_o = or i32 %i60_l, %i60_r
    %r60 = add i32 %i60_o, %r59

    // Step 61: g=11, s=10, K=0xbd3af235, first=d
    // I(%r60,%r59,%r58) = %r59 ^ (%r60 | ~%r58); d = %r60 + ROL(%r57 + I + M[11] + K[61], 10)
    %i61_nz = xor i32 %r58, 0xFFFFFFFF
    %i61_0 = or i32 %r60, %i61_nz
    %i61_1 = xor i32 %r59, %i61_0
    %i61_2 = add i32 %r57, %i61_1
    %i61_3 = add i32 %i61_2, %w11
    %i61_4 = add i32 %i61_3, 0xBD3AF235
    %i61_l = shl i32 %i61_4, 10
    %i61_r = lshr i32 %i61_4, 22
    %i61_o = or i32 %i61_l, %i61_r
    %r61 = add i32 %i61_o, %r60

    // Step 62: g=2, s=15, K=0x2ad7d2bb, first=c
    // I(%r61,%r60,%r59) = %r60 ^ (%r61 | ~%r59); c = %r61 + ROL(%r58 + I + M[2] + K[62], 15)
    %i62_nz = xor i32 %r59, 0xFFFFFFFF
    %i62_0 = or i32 %r61, %i62_nz
    %i62_1 = xor i32 %r60, %i62_0
    %i62_2 = add i32 %r58, %i62_1
    %i62_3 = add i32 %i62_2, %w2
    %i62_4 = add i32 %i62_3, 0x2AD7D2BB
    %i62_l = shl i32 %i62_4, 15
    %i62_r = lshr i32 %i62_4, 17
    %i62_o = or i32 %i62_l, %i62_r
    %r62 = add i32 %i62_o, %r61

    // Step 63: g=9, s=21, K=0xeb86d391, first=b
    // I(%r62,%r61,%r60) = %r61 ^ (%r62 | ~%r60); b = %r62 + ROL(%r59 + I + M[9] + K[63], 21)
    %i63_nz = xor i32 %r60, 0xFFFFFFFF
    %i63_0 = or i32 %r62, %i63_nz
    %i63_1 = xor i32 %r61, %i63_0
    %i63_2 = add i32 %r59, %i63_1
    %i63_3 = add i32 %i63_2, %w9
    %i63_4 = add i32 %i63_3, 0xEB86D391
    %i63_l = shl i32 %i63_4, 21
    %i63_r = lshr i32 %i63_4, 11
    %i63_o = or i32 %i63_l, %i63_r
    %r63 = add i32 %i63_o, %r62

    // Add original state back
    %fa = add i32 %r60, %a0
    %fb = add i32 %r63, %b0
    %fc = add i32 %r62, %c0
    %fd = add i32 %r61, %d0

    // Store updated state
    store i32 %fa, *%aptr
    store i32 %fb, *%bptr
    store i32 %fc, *%cptr
    store i32 %fd, *%dptr
    ret void
}

// Public API: compute MD5 digest of input data.
// data: input byte array, len: length in bytes, digest: 16-byte output buffer
fun @std_crypto_md5_compute(data: *i8, len: i32, digest: *i8) -> void {
  @entry:
    // Allocate hash state
    %aptr = let i32
    %bptr = let i32
    %cptr = let i32
    %dptr = let i32

    // Initialize state (MD5 magic constants)
    store i32 0x67452301, *%aptr
    store i32 0xEFCDAB89, *%bptr
    store i32 0x98BADCFE, *%cptr
    store i32 0x10325476, *%dptr

    // Allocate scratch buffers for padding
    %buf1 = let [i8, 64]
    %buf2 = let [i8, 64]

    // Zero the buffers (let does NOT zero-initialize)
    %bp1m = gep i8, *%buf1, 0
    %bp2m = gep i8, *%buf2, 0
    %nm64 = let i64
    store i64 64, *%nm64
    %nm64v = load i64, *%nm64
    call @memset(%bp1m, 0, %nm64v)
    call @memset(%bp2m, 0, %nm64v)

    // Loop counter and offset tracking
    %offset = let i32
    %iptr = let i32
    store i32 0, *%offset
    jmp @block_cond

    // Process all full 64-byte blocks
  @block_cond:
    %off = load i32, *%offset
    %next_off = add i32 %off, 64
    %has_block = sle i32 %next_off, %len
    br %has_block, @process_block, @pad_start

  @process_block:
    %bp = gep i8, *%data, %off
    call @std_crypto_md5_transform(%aptr, %bptr, %cptr, %dptr, %bp)
    store i32 %next_off, *%offset
    jmp @block_cond

    // Handle padding (tail bytes + 0x80 + length)
  @pad_start:
    %off_val = load i32, *%offset
    %rem = sub i32 %len, %off_val
    %needs_two = sge i32 %rem, 56
    br %needs_two, @pad_two_setup, @pad_one_setup

    // One block case: rem < 56, all padding fits in one block
  @pad_one_setup:
    store i32 0, *%iptr
    jmp @copy_cond

    // Two block case: rem >= 56, need two padding blocks
  @pad_two_setup:
    store i32 0, *%iptr
    jmp @copy_cond

    // Copy loop: copy remaining data bytes into buf1
  @copy_cond:
    %ci = load i32, *%iptr
    %copy_done = slt i32 %ci, %rem
    br %copy_done, @copy_body, @copy_done_label

  @copy_body:
    %src_off = add i32 %off_val, %ci
    %src_p = gep i8, *%data, %src_off
    %byte = load i8, *%src_p
    %dst_p = gep i8, *%buf1, %ci
    store i8 %byte, *%dst_p
    %ci_next = add i32 %ci, 1
    store i32 %ci_next, *%iptr
    jmp @copy_cond

  @copy_done_label:
    // Add 0x80 padding byte at position rem
    %pad80_p = gep i8, *%buf1, %rem
    store i8 0x80, *%pad80_p

    // Check one-block vs two-block
    %is_one_block = slt i32 %rem, 56
    br %is_one_block, @process_one_block, @process_two_block_a

    // One block: set length and transform
  @process_one_block:
    // Set bit length (len * 8) at bytes 56-63 in buf1 (little-endian)
    %bl = mul i32 %len, 8
    %bl_b0 = trunc i32 %bl to i8
    %bl_s8 = lshr i32 %bl, 8
    %bl_b1 = trunc i32 %bl_s8 to i8
    %bl_s16 = lshr i32 %bl, 16
    %bl_b2 = trunc i32 %bl_s16 to i8
    %bl_s24 = lshr i32 %bl, 24
    %bl_b3 = trunc i32 %bl_s24 to i8

    %p56 = gep i8, *%buf1, 56
    store i8 %bl_b0, *%p56
    %p57 = gep i8, *%buf1, 57
    store i8 %bl_b1, *%p57
    %p58 = gep i8, *%buf1, 58
    store i8 %bl_b2, *%p58
    %p59 = gep i8, *%buf1, 59
    store i8 %bl_b3, *%p59
    // Bytes 60-63 are zero from memset above

    %buf1_p = gep i8, *%buf1, 0
    call @std_crypto_md5_transform(%aptr, %bptr, %cptr, %dptr, %buf1_p)
    jmp @write_digest

    // Two blocks: first block (data + 0x80, no length yet)
  @process_two_block_a:
    %buf1_p2 = gep i8, *%buf1, 0
    call @std_crypto_md5_transform(%aptr, %bptr, %cptr, %dptr, %buf1_p2)

    // Second block: zeros + length in buf2
    %bl2 = mul i32 %len, 8
    %bl2_b0 = trunc i32 %bl2 to i8
    %bl2_s8 = lshr i32 %bl2, 8
    %bl2_b1 = trunc i32 %bl2_s8 to i8
    %bl2_s16 = lshr i32 %bl2, 16
    %bl2_b2 = trunc i32 %bl2_s16 to i8
    %bl2_s24 = lshr i32 %bl2, 24
    %bl2_b3 = trunc i32 %bl2_s24 to i8

    %p56_2 = gep i8, *%buf2, 56
    store i8 %bl2_b0, *%p56_2
    %p57_2 = gep i8, *%buf2, 57
    store i8 %bl2_b1, *%p57_2
    %p58_2 = gep i8, *%buf2, 58
    store i8 %bl2_b2, *%p58_2
    %p59_2 = gep i8, *%buf2, 59
    store i8 %bl2_b3, *%p59_2
    // Bytes 0-55 and 60-63 are zero from memset above

    %buf2_p = gep i8, *%buf2, 0
    call @std_crypto_md5_transform(%aptr, %bptr, %cptr, %dptr, %buf2_p)
    jmp @write_digest

    // Write final digest bytes (A, B, C, D in little-endian)
  @write_digest:
    %a_val = load i32, *%aptr
    %b_val = load i32, *%bptr
    %c_val = load i32, *%cptr
    %d_val = load i32, *%dptr

    // A bytes 0-3
    %a_b0 = trunc i32 %a_val to i8
    %a_s8 = lshr i32 %a_val, 8
    %a_b1 = trunc i32 %a_s8 to i8
    %a_s16 = lshr i32 %a_val, 16
    %a_b2 = trunc i32 %a_s16 to i8
    %a_s24 = lshr i32 %a_val, 24
    %a_b3 = trunc i32 %a_s24 to i8

    %da0 = gep i8, *%digest, 0
    store i8 %a_b0, *%da0
    %da1 = gep i8, *%digest, 1
    store i8 %a_b1, *%da1
    %da2 = gep i8, *%digest, 2
    store i8 %a_b2, *%da2
    %da3 = gep i8, *%digest, 3
    store i8 %a_b3, *%da3

    // B bytes 4-7
    %b_b0 = trunc i32 %b_val to i8
    %b_s8 = lshr i32 %b_val, 8
    %b_b1 = trunc i32 %b_s8 to i8
    %b_s16 = lshr i32 %b_val, 16
    %b_b2 = trunc i32 %b_s16 to i8
    %b_s24 = lshr i32 %b_val, 24
    %b_b3 = trunc i32 %b_s24 to i8

    %db0 = gep i8, *%digest, 4
    store i8 %b_b0, *%db0
    %db1 = gep i8, *%digest, 5
    store i8 %b_b1, *%db1
    %db2 = gep i8, *%digest, 6
    store i8 %b_b2, *%db2
    %db3 = gep i8, *%digest, 7
    store i8 %b_b3, *%db3

    // C bytes 8-11
    %c_b0 = trunc i32 %c_val to i8
    %c_s8 = lshr i32 %c_val, 8
    %c_b1 = trunc i32 %c_s8 to i8
    %c_s16 = lshr i32 %c_val, 16
    %c_b2 = trunc i32 %c_s16 to i8
    %c_s24 = lshr i32 %c_val, 24
    %c_b3 = trunc i32 %c_s24 to i8

    %dc0 = gep i8, *%digest, 8
    store i8 %c_b0, *%dc0
    %dc1 = gep i8, *%digest, 9
    store i8 %c_b1, *%dc1
    %dc2 = gep i8, *%digest, 10
    store i8 %c_b2, *%dc2
    %dc3 = gep i8, *%digest, 11
    store i8 %c_b3, *%dc3

    // D bytes 12-15
    %d_b0 = trunc i32 %d_val to i8
    %d_s8 = lshr i32 %d_val, 8
    %d_b1 = trunc i32 %d_s8 to i8
    %d_s16 = lshr i32 %d_val, 16
    %d_b2 = trunc i32 %d_s16 to i8
    %d_s24 = lshr i32 %d_val, 24
    %d_b3 = trunc i32 %d_s24 to i8

    %dd0 = gep i8, *%digest, 12
    store i8 %d_b0, *%dd0
    %dd1 = gep i8, *%digest, 13
    store i8 %d_b1, *%dd1
    %dd2 = gep i8, *%digest, 14
    store i8 %d_b2, *%dd2
    %dd3 = gep i8, *%digest, 15
    store i8 %d_b3, *%dd3
    ret void
}
