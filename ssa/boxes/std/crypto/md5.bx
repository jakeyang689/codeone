// MD5 message digest implementation
// Processes input data in 64-byte blocks using the MD5 compression function.
// Outputs 16 bytes (128 bits) of digest in little-endian byte order.

extern @memset(s: *i8, c: i32, n: i64) -> *i8

// Internal: process one 64-byte block and update the hash state.
fun @std_crypto_md5_transform(aptr: *i32, bptr: *i32, cptr: *i32, dptr: *i32, block: *i8) -> void {
  @entry:
    // Load current hash state
    %a0 = load i32, *%aptr
    %b0 = load i32, *%bptr
    %c0 = load i32, *%cptr
    %d0 = load i32, *%dptr

    // Load 16 words from block (little-endian)
    // Word 0: bytes 0-3
    %w0p0 = gep i8, *%block, 0
    %w0b0 = load i8, *%w0p0
    %w0z0 = zext i8 %w0b0 to i32
    %w0p1 = gep i8, *%block, 1
    %w0b1 = load i8, *%w0p1
    %w0z1 = zext i8 %w0b1 to i32
    %w0s1 = shl i32 %w0z1, 8
    %w0p2 = gep i8, *%block, 2
    %w0b2 = load i8, *%w0p2
    %w0z2 = zext i8 %w0b2 to i32
    %w0s2 = shl i32 %w0z2, 16
    %w0p3 = gep i8, *%block, 3
    %w0b3 = load i8, *%w0p3
    %w0z3 = zext i8 %w0b3 to i32
    %w0s3 = shl i32 %w0z3, 24
    %w0t0 = or i32 %w0z0, %w0s1
    %w0t1 = or i32 %w0t0, %w0s2
    %w0 = or i32 %w0t1, %w0s3

    // Word 1: bytes 4-7
    %w1p0 = gep i8, *%block, 4
    %w1b0 = load i8, *%w1p0
    %w1z0 = zext i8 %w1b0 to i32
    %w1p1 = gep i8, *%block, 5
    %w1b1 = load i8, *%w1p1
    %w1z1 = zext i8 %w1b1 to i32
    %w1s1 = shl i32 %w1z1, 8
    %w1p2 = gep i8, *%block, 6
    %w1b2 = load i8, *%w1p2
    %w1z2 = zext i8 %w1b2 to i32
    %w1s2 = shl i32 %w1z2, 16
    %w1p3 = gep i8, *%block, 7
    %w1b3 = load i8, *%w1p3
    %w1z3 = zext i8 %w1b3 to i32
    %w1s3 = shl i32 %w1z3, 24
    %w1t0 = or i32 %w1z0, %w1s1
    %w1t1 = or i32 %w1t0, %w1s2
    %w1 = or i32 %w1t1, %w1s3

    // Word 2: bytes 8-11
    %w2p0 = gep i8, *%block, 8
    %w2b0 = load i8, *%w2p0
    %w2z0 = zext i8 %w2b0 to i32
    %w2p1 = gep i8, *%block, 9
    %w2b1 = load i8, *%w2p1
    %w2z1 = zext i8 %w2b1 to i32
    %w2s1 = shl i32 %w2z1, 8
    %w2p2 = gep i8, *%block, 10
    %w2b2 = load i8, *%w2p2
    %w2z2 = zext i8 %w2b2 to i32
    %w2s2 = shl i32 %w2z2, 16
    %w2p3 = gep i8, *%block, 11
    %w2b3 = load i8, *%w2p3
    %w2z3 = zext i8 %w2b3 to i32
    %w2s3 = shl i32 %w2z3, 24
    %w2t0 = or i32 %w2z0, %w2s1
    %w2t1 = or i32 %w2t0, %w2s2
    %w2 = or i32 %w2t1, %w2s3

    // Word 3: bytes 12-15
    %w3p0 = gep i8, *%block, 12
    %w3b0 = load i8, *%w3p0
    %w3z0 = zext i8 %w3b0 to i32
    %w3p1 = gep i8, *%block, 13
    %w3b1 = load i8, *%w3p1
    %w3z1 = zext i8 %w3b1 to i32
    %w3s1 = shl i32 %w3z1, 8
    %w3p2 = gep i8, *%block, 14
    %w3b2 = load i8, *%w3p2
    %w3z2 = zext i8 %w3b2 to i32
    %w3s2 = shl i32 %w3z2, 16
    %w3p3 = gep i8, *%block, 15
    %w3b3 = load i8, *%w3p3
    %w3z3 = zext i8 %w3b3 to i32
    %w3s3 = shl i32 %w3z3, 24
    %w3t0 = or i32 %w3z0, %w3s1
    %w3t1 = or i32 %w3t0, %w3s2
    %w3 = or i32 %w3t1, %w3s3

    // Word 4: bytes 16-19
    %w4p0 = gep i8, *%block, 16
    %w4b0 = load i8, *%w4p0
    %w4z0 = zext i8 %w4b0 to i32
    %w4p1 = gep i8, *%block, 17
    %w4b1 = load i8, *%w4p1
    %w4z1 = zext i8 %w4b1 to i32
    %w4s1 = shl i32 %w4z1, 8
    %w4p2 = gep i8, *%block, 18
    %w4b2 = load i8, *%w4p2
    %w4z2 = zext i8 %w4b2 to i32
    %w4s2 = shl i32 %w4z2, 16
    %w4p3 = gep i8, *%block, 19
    %w4b3 = load i8, *%w4p3
    %w4z3 = zext i8 %w4b3 to i32
    %w4s3 = shl i32 %w4z3, 24
    %w4t0 = or i32 %w4z0, %w4s1
    %w4t1 = or i32 %w4t0, %w4s2
    %w4 = or i32 %w4t1, %w4s3

    // Word 5: bytes 20-23
    %w5p0 = gep i8, *%block, 20
    %w5b0 = load i8, *%w5p0
    %w5z0 = zext i8 %w5b0 to i32
    %w5p1 = gep i8, *%block, 21
    %w5b1 = load i8, *%w5p1
    %w5z1 = zext i8 %w5b1 to i32
    %w5s1 = shl i32 %w5z1, 8
    %w5p2 = gep i8, *%block, 22
    %w5b2 = load i8, *%w5p2
    %w5z2 = zext i8 %w5b2 to i32
    %w5s2 = shl i32 %w5z2, 16
    %w5p3 = gep i8, *%block, 23
    %w5b3 = load i8, *%w5p3
    %w5z3 = zext i8 %w5b3 to i32
    %w5s3 = shl i32 %w5z3, 24
    %w5t0 = or i32 %w5z0, %w5s1
    %w5t1 = or i32 %w5t0, %w5s2
    %w5 = or i32 %w5t1, %w5s3

    // Word 6: bytes 24-27
    %w6p0 = gep i8, *%block, 24
    %w6b0 = load i8, *%w6p0
    %w6z0 = zext i8 %w6b0 to i32
    %w6p1 = gep i8, *%block, 25
    %w6b1 = load i8, *%w6p1
    %w6z1 = zext i8 %w6b1 to i32
    %w6s1 = shl i32 %w6z1, 8
    %w6p2 = gep i8, *%block, 26
    %w6b2 = load i8, *%w6p2
    %w6z2 = zext i8 %w6b2 to i32
    %w6s2 = shl i32 %w6z2, 16
    %w6p3 = gep i8, *%block, 27
    %w6b3 = load i8, *%w6p3
    %w6z3 = zext i8 %w6b3 to i32
    %w6s3 = shl i32 %w6z3, 24
    %w6t0 = or i32 %w6z0, %w6s1
    %w6t1 = or i32 %w6t0, %w6s2
    %w6 = or i32 %w6t1, %w6s3

    // Word 7: bytes 28-31
    %w7p0 = gep i8, *%block, 28
    %w7b0 = load i8, *%w7p0
    %w7z0 = zext i8 %w7b0 to i32
    %w7p1 = gep i8, *%block, 29
    %w7b1 = load i8, *%w7p1
    %w7z1 = zext i8 %w7b1 to i32
    %w7s1 = shl i32 %w7z1, 8
    %w7p2 = gep i8, *%block, 30
    %w7b2 = load i8, *%w7p2
    %w7z2 = zext i8 %w7b2 to i32
    %w7s2 = shl i32 %w7z2, 16
    %w7p3 = gep i8, *%block, 31
    %w7b3 = load i8, *%w7p3
    %w7z3 = zext i8 %w7b3 to i32
    %w7s3 = shl i32 %w7z3, 24
    %w7t0 = or i32 %w7z0, %w7s1
    %w7t1 = or i32 %w7t0, %w7s2
    %w7 = or i32 %w7t1, %w7s3

    // Word 8: bytes 32-35
    %w8p0 = gep i8, *%block, 32
    %w8b0 = load i8, *%w8p0
    %w8z0 = zext i8 %w8b0 to i32
    %w8p1 = gep i8, *%block, 33
    %w8b1 = load i8, *%w8p1
    %w8z1 = zext i8 %w8b1 to i32
    %w8s1 = shl i32 %w8z1, 8
    %w8p2 = gep i8, *%block, 34
    %w8b2 = load i8, *%w8p2
    %w8z2 = zext i8 %w8b2 to i32
    %w8s2 = shl i32 %w8z2, 16
    %w8p3 = gep i8, *%block, 35
    %w8b3 = load i8, *%w8p3
    %w8z3 = zext i8 %w8b3 to i32
    %w8s3 = shl i32 %w8z3, 24
    %w8t0 = or i32 %w8z0, %w8s1
    %w8t1 = or i32 %w8t0, %w8s2
    %w8 = or i32 %w8t1, %w8s3

    // Word 9: bytes 36-39
    %w9p0 = gep i8, *%block, 36
    %w9b0 = load i8, *%w9p0
    %w9z0 = zext i8 %w9b0 to i32
    %w9p1 = gep i8, *%block, 37
    %w9b1 = load i8, *%w9p1
    %w9z1 = zext i8 %w9b1 to i32
    %w9s1 = shl i32 %w9z1, 8
    %w9p2 = gep i8, *%block, 38
    %w9b2 = load i8, *%w9p2
    %w9z2 = zext i8 %w9b2 to i32
    %w9s2 = shl i32 %w9z2, 16
    %w9p3 = gep i8, *%block, 39
    %w9b3 = load i8, *%w9p3
    %w9z3 = zext i8 %w9b3 to i32
    %w9s3 = shl i32 %w9z3, 24
    %w9t0 = or i32 %w9z0, %w9s1
    %w9t1 = or i32 %w9t0, %w9s2
    %w9 = or i32 %w9t1, %w9s3

    // Word 10: bytes 40-43
    %w10p0 = gep i8, *%block, 40
    %w10b0 = load i8, *%w10p0
    %w10z0 = zext i8 %w10b0 to i32
    %w10p1 = gep i8, *%block, 41
    %w10b1 = load i8, *%w10p1
    %w10z1 = zext i8 %w10b1 to i32
    %w10s1 = shl i32 %w10z1, 8
    %w10p2 = gep i8, *%block, 42
    %w10b2 = load i8, *%w10p2
    %w10z2 = zext i8 %w10b2 to i32
    %w10s2 = shl i32 %w10z2, 16
    %w10p3 = gep i8, *%block, 43
    %w10b3 = load i8, *%w10p3
    %w10z3 = zext i8 %w10b3 to i32
    %w10s3 = shl i32 %w10z3, 24
    %w10t0 = or i32 %w10z0, %w10s1
    %w10t1 = or i32 %w10t0, %w10s2
    %w10 = or i32 %w10t1, %w10s3

    // Word 11: bytes 44-47
    %w11p0 = gep i8, *%block, 44
    %w11b0 = load i8, *%w11p0
    %w11z0 = zext i8 %w11b0 to i32
    %w11p1 = gep i8, *%block, 45
    %w11b1 = load i8, *%w11p1
    %w11z1 = zext i8 %w11b1 to i32
    %w11s1 = shl i32 %w11z1, 8
    %w11p2 = gep i8, *%block, 46
    %w11b2 = load i8, *%w11p2
    %w11z2 = zext i8 %w11b2 to i32
    %w11s2 = shl i32 %w11z2, 16
    %w11p3 = gep i8, *%block, 47
    %w11b3 = load i8, *%w11p3
    %w11z3 = zext i8 %w11b3 to i32
    %w11s3 = shl i32 %w11z3, 24
    %w11t0 = or i32 %w11z0, %w11s1
    %w11t1 = or i32 %w11t0, %w11s2
    %w11 = or i32 %w11t1, %w11s3

    // Word 12: bytes 48-51
    %w12p0 = gep i8, *%block, 48
    %w12b0 = load i8, *%w12p0
    %w12z0 = zext i8 %w12b0 to i32
    %w12p1 = gep i8, *%block, 49
    %w12b1 = load i8, *%w12p1
    %w12z1 = zext i8 %w12b1 to i32
    %w12s1 = shl i32 %w12z1, 8
    %w12p2 = gep i8, *%block, 50
    %w12b2 = load i8, *%w12p2
    %w12z2 = zext i8 %w12b2 to i32
    %w12s2 = shl i32 %w12z2, 16
    %w12p3 = gep i8, *%block, 51
    %w12b3 = load i8, *%w12p3
    %w12z3 = zext i8 %w12b3 to i32
    %w12s3 = shl i32 %w12z3, 24
    %w12t0 = or i32 %w12z0, %w12s1
    %w12t1 = or i32 %w12t0, %w12s2
    %w12 = or i32 %w12t1, %w12s3

    // Word 13: bytes 52-55
    %w13p0 = gep i8, *%block, 52
    %w13b0 = load i8, *%w13p0
    %w13z0 = zext i8 %w13b0 to i32
    %w13p1 = gep i8, *%block, 53
    %w13b1 = load i8, *%w13p1
    %w13z1 = zext i8 %w13b1 to i32
    %w13s1 = shl i32 %w13z1, 8
    %w13p2 = gep i8, *%block, 54
    %w13b2 = load i8, *%w13p2
    %w13z2 = zext i8 %w13b2 to i32
    %w13s2 = shl i32 %w13z2, 16
    %w13p3 = gep i8, *%block, 55
    %w13b3 = load i8, *%w13p3
    %w13z3 = zext i8 %w13b3 to i32
    %w13s3 = shl i32 %w13z3, 24
    %w13t0 = or i32 %w13z0, %w13s1
    %w13t1 = or i32 %w13t0, %w13s2
    %w13 = or i32 %w13t1, %w13s3

    // Word 14: bytes 56-59
    %w14p0 = gep i8, *%block, 56
    %w14b0 = load i8, *%w14p0
    %w14z0 = zext i8 %w14b0 to i32
    %w14p1 = gep i8, *%block, 57
    %w14b1 = load i8, *%w14p1
    %w14z1 = zext i8 %w14b1 to i32
    %w14s1 = shl i32 %w14z1, 8
    %w14p2 = gep i8, *%block, 58
    %w14b2 = load i8, *%w14p2
    %w14z2 = zext i8 %w14b2 to i32
    %w14s2 = shl i32 %w14z2, 16
    %w14p3 = gep i8, *%block, 59
    %w14b3 = load i8, *%w14p3
    %w14z3 = zext i8 %w14b3 to i32
    %w14s3 = shl i32 %w14z3, 24
    %w14t0 = or i32 %w14z0, %w14s1
    %w14t1 = or i32 %w14t0, %w14s2
    %w14 = or i32 %w14t1, %w14s3

    // Word 15: bytes 60-63
    %w15p0 = gep i8, *%block, 60
    %w15b0 = load i8, *%w15p0
    %w15z0 = zext i8 %w15b0 to i32
    %w15p1 = gep i8, *%block, 61
    %w15b1 = load i8, *%w15p1
    %w15z1 = zext i8 %w15b1 to i32
    %w15s1 = shl i32 %w15z1, 8
    %w15p2 = gep i8, *%block, 62
    %w15b2 = load i8, *%w15p2
    %w15z2 = zext i8 %w15b2 to i32
    %w15s2 = shl i32 %w15z2, 16
    %w15p3 = gep i8, *%block, 63
    %w15b3 = load i8, *%w15p3
    %w15z3 = zext i8 %w15b3 to i32
    %w15s3 = shl i32 %w15z3, 24
    %w15t0 = or i32 %w15z0, %w15s1
    %w15t1 = or i32 %w15t0, %w15s2
    %w15 = or i32 %w15t1, %w15s3

    // Round 1: F function - F(x,y,z) = (x & y) | (~x & z)
    // Step 0: g=0, s=7, K=0xd76aa478, first=a
    // F(b0,c0,d0) = (b0 & c0) | (~b0 & d0); result = b0 + ROL(a0 + F + M[0] + K[0], 7)
    %f0_a1 = and i32 %b0, %c0
    %f0_nb = xor i32 %b0, 0xFFFFFFFF
    %f0_a2 = and i32 %f0_nb, %d0
    %f0_0 = or i32 %f0_a1, %f0_a2
    %f0_1 = add i32 %a0, %f0_0
    %f0_2 = add i32 %f0_1, %w0
    %f0_3 = add i32 %f0_2, 0xD76AA478
    %f0_l = shl i32 %f0_3, 7
    %f0_r = lshr i32 %f0_3, 25
    %f0_o = or i32 %f0_l, %f0_r
    %r0 = add i32 %f0_o, %b0

    // Step 1: g=1, s=12, K=0xe8c7b756, first=d
    // F(%r0,b0,c0) = (%r0 & b0) | (~%r0 & c0); d = %r0 + ROL(d0 + F + M[1] + K[1], 12)
    %f1_a1 = and i32 %r0, %b0
    %f1_nb = xor i32 %r0, 0xFFFFFFFF
    %f1_a2 = and i32 %f1_nb, %c0
    %f1_0 = or i32 %f1_a1, %f1_a2
    %f1_1 = add i32 %d0, %f1_0
    %f1_2 = add i32 %f1_1, %w1
    %f1_3 = add i32 %f1_2, 0xE8C7B756
    %f1_l = shl i32 %f1_3, 12
    %f1_r = lshr i32 %f1_3, 20
    %f1_o = or i32 %f1_l, %f1_r
    %r1 = add i32 %f1_o, %r0

    // Step 2: g=2, s=17, K=0x242070db, first=c
    // F(%r1,%r0,b0) = (%r1 & %r0) | (~%r1 & b0); c = %r1 + ROL(c0 + F + M[2] + K[2], 17)
    %f2_a1 = and i32 %r1, %r0
    %f2_nb = xor i32 %r1, 0xFFFFFFFF
    %f2_a2 = and i32 %f2_nb, %b0
    %f2_0 = or i32 %f2_a1, %f2_a2
    %f2_1 = add i32 %c0, %f2_0
    %f2_2 = add i32 %f2_1, %w2
    %f2_3 = add i32 %f2_2, 0x242070DB
    %f2_l = shl i32 %f2_3, 17
    %f2_r = lshr i32 %f2_3, 15
    %f2_o = or i32 %f2_l, %f2_r
    %r2 = add i32 %f2_o, %r1

    // Step 3: g=3, s=22, K=0xc1bdceee, first=b
    // F(%r2,%r1,%r0) = (%r2 & %r1) | (~%r2 & %r0); b = %r2 + ROL(b0 + F + M[3] + K[3], 22)
    %f3_a1 = and i32 %r2, %r1
    %f3_nb = xor i32 %r2, 0xFFFFFFFF
    %f3_a2 = and i32 %f3_nb, %r0
    %f3_0 = or i32 %f3_a1, %f3_a2
    %f3_1 = add i32 %b0, %f3_0
    %f3_2 = add i32 %f3_1, %w3
    %f3_3 = add i32 %f3_2, 0xC1BDCEEE
    %f3_l = shl i32 %f3_3, 22
    %f3_r = lshr i32 %f3_3, 10
    %f3_o = or i32 %f3_l, %f3_r
    %r3 = add i32 %f3_o, %r2

    // Step 4: g=4, s=7, K=0xf57c0faf, first=a
    // F(%r3,%r2,%r1) = (%r3 & %r2) | (~%r3 & %r1); a = %r3 + ROL(%r0 + F + M[4] + K[4], 7)
    %f4_a1 = and i32 %r3, %r2
    %f4_nb = xor i32 %r3, 0xFFFFFFFF
    %f4_a2 = and i32 %f4_nb, %r1
    %f4_0 = or i32 %f4_a1, %f4_a2
    %f4_1 = add i32 %r0, %f4_0
    %f4_2 = add i32 %f4_1, %w4
    %f4_3 = add i32 %f4_2, 0xF57C0FAF
    %f4_l = shl i32 %f4_3, 7
    %f4_r = lshr i32 %f4_3, 25
    %f4_o = or i32 %f4_l, %f4_r
    %r4 = add i32 %f4_o, %r3

    // Step 5: g=5, s=12, K=0x4787c62a, first=d
    // F(%r4,%r3,%r2) = (%r4 & %r3) | (~%r4 & %r2); d = %r4 + ROL(%r1 + F + M[5] + K[5], 12)
    %f5_a1 = and i32 %r4, %r3
    %f5_nb = xor i32 %r4, 0xFFFFFFFF
    %f5_a2 = and i32 %f5_nb, %r2
    %f5_0 = or i32 %f5_a1, %f5_a2
    %f5_1 = add i32 %r1, %f5_0
    %f5_2 = add i32 %f5_1, %w5
    %f5_3 = add i32 %f5_2, 0x4787C62A
    %f5_l = shl i32 %f5_3, 12
    %f5_r = lshr i32 %f5_3, 20
