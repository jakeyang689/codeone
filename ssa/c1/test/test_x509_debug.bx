// X.509 debug test - trace through parsing

extern @printf(fmt: *i8, ...) -> i32
extern @asn1_read_tag(buf: *i8, off: *i32) -> i8
extern @asn1_read_length(buf: *i8, off: *i32) -> i32
extern @x509_find_tbs_certificate(cert_der: *i8, cert_len: i32,
                                   tbs_val_off: *i32, tbs_val_len: *i32,
                                   tbs_der_off: *i32, tbs_der_len: *i32) -> i1
extern @x509_find_spki(tbs_der: *i8, tbs_len: i32,
                        spki_off: *i32, spki_len: *i32) -> i1
extern @x509_spki_get_rsa_pubkey(spki_val: *i8, spki_len: i32,
                                  n_out: *i32, e_out: *i32,
                                  limbs: i32) -> i1
extern @x509_parse_rsa_pubkey(cert_der: *i8, cert_len: i32,
                               n_out: *i32, e_out: *i32,
                               limbs: i32) -> i1

