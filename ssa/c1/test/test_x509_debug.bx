fun @main() -> i32 {
  @entry:
    %der_p = gep i8, *@_test_cert_der, 0

    // Step 1: Find TBSCertificate
    %tbs_val_off = let i32
    %tbs_val_len = let i32
    %tbs_der_off = let i32
    %tbs_der_len = let i32
    %found_tbs = call @x509_find_tbs_certificate(%der_p, 520, %tbs_val_off, %tbs_val_len, %tbs_der_off, %tbs_der_len)
    %tbs_voff = load i32, *%tbs_val_off
    %tbs_vlen = load i32, *%tbs_val_len
    %tbs_doff = load i32, *%tbs_der_off
    %tbs_dlen = load i32, *%tbs_der_len
    call @printf("TBS: found=%d val_off=%d val_len=%d der_off=%d der_len=%d\n", %found_tbs, %tbs_voff, %tbs_vlen, %tbs_doff, %tbs_dlen)
    br %found_tbs, @check_TBS, @fail

  @check_TBS:
    %tbs_val_p = gep i8, *%der_p, %tbs_voff
    // Check first byte of TBS value should be 0xA0 (version tag)
    %first_byte = load i8, *%tbs_val_p
    %first_i = zext i8 %first_byte to i32
    call @printf("TBS first byte: 0x%02x\n", %first_i)

    // Step 2: Find SPKI
    %spki_off = let i32
    %spki_len = let i32
    %found_spki = call @x509_find_spki(%tbs_val_p, %tbs_vlen, %spki_off, %spki_len)
    %spki_off_v = load i32, *%spki_off
    %spki_len_v = load i32, *%spki_len
    call @printf("SPKI: found=%d off=%d len=%d\n", %found_spki, %spki_off_v, %spki_len_v)
    br %found_spki, @check_SPKI, @fail

  @check_SPKI:
    // spki_off is relative to TBS value buffer, convert to cert-absolute
    %abs_spki_off = add i32 %tbs_voff, %spki_off_v
    %spki_val_p = gep i8, *%der_p, %abs_spki_off
    %spki_first = load i8, *%spki_val_p
    %spki_first_i = zext i8 %spki_first to i32
    call @printf("SPKI first byte: 0x%02x\n", %spki_first_i)

    // Check if it's a SEQUENCE
    %is_seq = eq i8 %spki_first, 0x30
    br %is_seq, @test_key, @fail

  @test_key:
    // Step 3: Extract RSA key
    %n = let [i32, 40]
    %e = let [i32, 40]
    %np = gep i32, *%n, 0
    %ep = gep i32, *%e, 0
    %got = call @x509_spki_get_rsa_pubkey(%spki_val_p, %spki_len_v, %np, %ep, 32)
    br %got, @check_e, @fail

  @check_e:
    %e0 = load i32, *%ep
    %e_ok = eq i32 %e0, 65537
    call @printf("e[0]=%d (expect 65537) ok=%d\n", %e0, %e_ok)
    br %e_ok, @pass, @fail

  @pass:
    call @printf("PASS\n")
    ret i32 0

  @fail:
    call @printf("FAIL\n")
    ret i32 0
}
