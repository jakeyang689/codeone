// Key derivation test using const arrays to avoid init issues
extern @putchar(c: i32) -> i32
extern @memcpy(dst: *i8, src: *i8, n: i64) -> *i8

extern @std_crypto_tls12_prf_sha256(secret: *i8, secret_len: i32,
                                    seed: *i8, seed_len: i32,
                                    out_len: i32, out: *i8) -> void

const @pms: [i8, 48] = [3,3,171,171,171,171,171,171,171,171,171,171,171,171,171,171,
                         171,171,171,171,171,171,171,171,171,171,171,171,171,171,171,171,
                         171,171,171,171,171,171,171,171,171,171,171,171,171,171,171,171]
const @cr: [i8, 32] = [205,205,205,205,205,205,205,205,205,205,205,205,205,205,205,205,
                        205,205,205,205,205,205,205,205,205,205,205,205,205,205,205,205]
const @sr: [i8, 32] = [239,239,239,239,239,239,239,239,239,239,239,239,239,239,239,239,
                        239,239,239,239,239,239,239,239,239,239,239,239,239,239,239,239]
const @ms_label: [i8, 13] = [109,97,115,116,101,114,32,115,101,99,114,101,116]
const @ke_label: [i8, 13] = [107,101,121,32,101,120,112,97,110,115,105,111,110]

fun @hex_byte(b: i8) -> void {
  @e:
    %bi = zext i8 %b to i32
    %hi = lshr i32 %bi, 4
    %lo = and i32 %bi, 15
    %hch = add i32 %hi, 48
    %h_gt9 = sgt i32 %hi, 9
    br %h_gt9, @h_adj, @h_w
  @h_adj:
    %hch2 = add i32 %hch, 39
    jmp @h_w
  @h_w:
    %hch_v = phi [%hch, @e], [%hch2, @h_adj]
    call @putchar(%hch_v)
    %lch = add i32 %lo, 48
    %l_gt9 = sgt i32 %lo, 9
    br %l_gt9, @l_adj, @l_w
  @l_adj:
    %lch2 = add i32 %lch, 39
    jmp @l_w
  @l_w:
    %lch_v = phi [%lch, @h_w], [%lch2, @l_adj]
    call @putchar(%lch_v)
    ret void
}

fun @hex_dump(p: *i8, n: i32) -> void {
  @entry:
    %i = let i32
    store i32 0, *%i
    jmp @hd_cond
  @hd_cond:
    %iv = load i32, *%i
    %more = slt i32 %iv, %n
    br %more, @hd_body, @hd_done
  @hd_body:
    %iv2 = load i32, *%i
    %bp = gep i8, *%p, %iv2
    %b = load i8, *%bp
    call @hex_byte(%b)
    %next = add i32 %iv2, 1
    store i32 %next, *%i
    jmp @hd_cond
  @hd_done:
    ret void
}

fun @main() -> i32 {
  @entry:
    %pp = gep i8, *@pms, 0
    %cp = gep i8, *@cr, 0
    %sp = gep i8, *@sr, 0
    %msp = gep i8, *@ms_label, 0
    %kep = gep i8, *@ke_label, 0
    %n13 = let i64
    store i64 13, *%n13
    %n13v = load i64, *%n13
    %n32 = let i64
    store i64 32, *%n32
    %n32v = load i64, *%n32

    // Build master_seed = "master secret" || CR || SR
    %ms_seed = let [i8, 77]
    %ms_p = gep i8, *%ms_seed, 0
    call @memcpy(%ms_p, %msp, %n13v)
    %ms_cr = gep i8, *%ms_p, 13
    call @memcpy(%ms_cr, %cp, %n32v)
    %ms_sr = gep i8, *%ms_p, 45
    call @memcpy(%ms_sr, %sp, %n32v)

    // Compute MS
    %ms_out = let [i8, 48]
    %ms_out_p = gep i8, *%ms_out, 0
    call @std_crypto_tls12_prf_sha256(%pp, 48, %ms_p, 77, 48, %ms_out_p)
    call @putchar(77)
    call @putchar(83)
    call @putchar(58)
    call @hex_dump(%ms_out_p, 8)
    call @putchar(10)

    // Build key_seed = "key expansion" || SR || CR
    %kb_seed2 = let [i8, 77]
    %ks_p2 = gep i8, *%kb_seed2, 0
    call @memcpy(%ks_p2, %kep, %n13v)
    %ke_sr2 = gep i8, *%ks_p2, 13
    call @memcpy(%ke_sr2, %sp, %n32v)
    %ke_cr2 = gep i8, *%ks_p2, 45
    call @memcpy(%ke_cr2, %cp, %n32v)

    // Compute key_block
    %kb_out = let [i8, 40]
    %kb_out_p = gep i8, *%kb_out, 0
    call @std_crypto_tls12_prf_sha256(%ms_out_p, 48, %ks_p2, 77, 40, %kb_out_p)
    call @putchar(75)
    call @putchar(66)
    call @putchar(58)
    call @hex_dump(%kb_out_p, 8)
    call @putchar(10)

    call @putchar(79)
    call @putchar(75)
    call @putchar(10)
    ret i32 0
}
