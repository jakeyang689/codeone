// X.509 Certificate Parser Test
// Tests: RSA public key extraction, self-signed signature verification

extern @printf(fmt: *i8, ...) -> i32
extern @memset(s: *i8, c: i32, n: i64) -> *i8
extern @memcmp(a: *i8, b: *i8, n: i64) -> i32

extern @x509_parse_rsa_pubkey(cert_der: *i8, cert_len: i32,
                               n_out: *i32, e_out: *i32,
                               limbs: i32) -> i1
extern @x509_verify_self_signed(cert_der: *i8, cert_len: i32,
                                 limbs: i32) -> i1
extern @x509_parse_p256_pubkey(cert_der: *i8, cert_len: i32,
                                pub_x: *i32, pub_y: *i32) -> i1

