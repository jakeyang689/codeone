// ============================================================
// Test 1: Parse RSA public key from certificate
// ============================================================
fun @test_x509_rsa_pubkey() -> void {
  @entry:
    %der_p = gep i8, *@_test_cert_der, 0
    // Use 40 limbs (128 bytes / 4 = 32, plus safety margin)
    %n = let [i32, 40]
    %e = let [i32, 40]
    %np = gep i32, *%n, 0
    %ep = gep i32, *%e, 0

    %got = call @x509_parse_rsa_pubkey(%der_p, 520, %np, %ep, 32)
    br %got, @check_n, @rsa_key_fail

  @check_n:
    // Verify n is non-zero (top limb should be set)
    %n_top = gep i32, *%np, 31
    %n_top_v = load i32, *%n_top
    %n_nz = ne i32 %n_top_v, 0
    br %n_nz, @check_e, @rsa_key_fail

  @check_e:
    // e should be 65537 (0x10001)
    %e0 = load i32, *%ep
    %e_is_65537 = eq i32 %e0, 65537
    %e_rest = gep i32, *%ep, 1
    %e_rest_v = load i32, *%e_rest
    %e_rest_zero = eq i32 %e_rest_v, 0
    %e_ok = and i1 %e_is_65537, %e_rest_zero
    br %e_ok, @rsa_key_pass, @rsa_key_fail

  @rsa_key_pass:
    call @printf("X509-RSA-KEY OK\n")
    ret void

  @rsa_key_fail:
    call @printf("X509-RSA-KEY FAIL\n")
    ret void
}


// ============================================================
// Test 2: Verify self-signed certificate signature
// ============================================================
fun @test_x509_verify_self_signed() -> void {
  @entry:
    %der_p = gep i8, *@_test_cert_der, 0
    %valid = call @x509_verify_self_signed(%der_p, 520, 32)
    br %valid, @vfy_pass, @vfy_fail

  @vfy_pass:
    call @printf("X509-SELF-SIG OK\n")
    ret void

  @vfy_fail:
    call @printf("X509-SELF-SIG FAIL\n")
    ret void
}


// ============================================================
// Main
// ============================================================
fun @main() -> i32 {
  @entry:
    call @test_x509_rsa_pubkey()
    call @test_x509_verify_self_signed()
    call @printf("DONE\n")
    ret i32 0
}
