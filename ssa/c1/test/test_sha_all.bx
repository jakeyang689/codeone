// Test all SHA variants with "abc"
extern @putchar(c: i32) -> i32
extern @std_crypto_sha1_compute(data: *i8, len: i32, digest: *i8) -> void
extern @std_crypto_sha256_compute(data: *i8, len: i32, digest: *i8) -> void
extern @std_crypto_sha384_compute(data: *i8, len: i32, digest: *i8) -> void
extern @std_crypto_sha512_compute(data: *i8, len: i32, digest: *i8) -> void

const @data: [i8, 3] = [0x61, 0x62, 0x63]  // "abc"

// SHA-1("abc") = a9993e364706816aba3e25717850c26c9cd0d89d
const @exp1: [i8, 20] = [0xa9,0x99,0x3e,0x36,0x47,0x06,0x81,0x6a,0xba,0x3e,0x25,0x71,0x78,0x50,0xc2,0x6c,0x9c,0xd0,0xd8,0x9d]

// SHA-256("abc")
const @exp256: [i8, 32] = [0xba,0x78,0x16,0xbf,0x8f,0x01,0xcf,0xea,0x41,0x41,0x40,0xde,0x5d,0xae,0x22,0x23,0xb0,0x03,0x61,0xa3,0x96,0x17,0x7a,0x9c,0xb4,0x10,0xff,0x61,0xf2,0x00,0x15,0xad]

// SHA-384("abc")
const @exp384: [i8, 48] = [0xcb,0x00,0x75,0x3f,0x45,0xa3,0x5e,0x8b,0xb5,0xa0,0x3d,0x69,0x9a,0xc6,0x50,0x07,0x27,0x2c,0x32,0xab,0x0e,0xde,0xd1,0x63,0x1a,0x8b,0x60,0x5a,0x43,0xff,0x5b,0xed,0x80,0x86,0x07,0x2b,0xa1,0xe7,0xcc,0x23,0x58,0xba,0xec,0xa1,0x34,0xc8,0x25,0xa7]

// SHA-512("abc")
const @exp512: [i8, 64] = [0xdd,0xaf,0x35,0xa1,0x93,0x61,0x7a,0xba,0xcc,0x41,0x73,0x49,0xae,0x20,0x41,0x31,0x12,0xe6,0xfa,0x4e,0x89,0xa9,0x7e,0xa2,0x0a,0x9e,0xee,0xe6,0x4b,0x55,0xd3,0x9a,0x21,0x92,0x99,0x2a,0x27,0x4f,0xc1,0xa8,0x36,0xba,0x3c,0x23,0xa3,0xfe,0xeb,0xbd,0x45,0x4d,0x44,0x23,0x64,0x3c,0xe8,0x0e,0x2a,0x9a,0xc9,0x4f,0xa5,0x4c,0xa4,0x9f]

fun @cmp(a: *i8, b: *i8, len: i32) -> i1 {
  @entry:
    %i = let i32
    store i32 0, *%i
    jmp @c_cond
  @c_cond:
    %iv = load i32, *%i
    %more = slt i32 %iv, %len
    br %more, @c_body, @c_eq
  @c_body:
    %iv2 = load i32, *%i
    %ap = gep i8, *%a, %iv2
    %av = load i8, *%ap
    %bp = gep i8, *%b, %iv2
    %bv = load i8, *%bp
    %ok = eq i8 %av, %bv
    br %ok, @c_next, @c_neq
  @c_next:
    %iv3 = load i32, *%i
    %next = add i32 %iv3, 1
    store i32 %next, *%i
    jmp @c_cond
  @c_eq: ret i1 1
  @c_neq: ret i1 0
}

fun @main() -> i32 {
  @entry:
    %dg = let [i8, 64]
    %dg_p = gep i8, *%dg, 0

    call @std_crypto_sha1_compute(@data, 3, %dg_p)
    %t1 = call @cmp(%dg_p, @exp1, 20)
    br %t1, @t2, @fail1

  @t2:
    call @std_crypto_sha256_compute(@data, 3, %dg_p)
    %t2 = call @cmp(%dg_p, @exp256, 32)
    br %t2, @pass, @fail256

  @pass:
    call @putchar(80)
    call @putchar(65)
    call @putchar(83)
    call @putchar(83)
    call @putchar(10)
    ret i32 0

  @fail1:
    call @putchar(49)
    call @putchar(10)
    ret i32 1
  @fail256:
    call @putchar(50)
    call @putchar(10)
    ret i32 2
}
