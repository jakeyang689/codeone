// RSASSA-PSS (SHA-256, salt length 32) verification vectors.
//
// Signatures were generated with OpenSSL-style PSS over the SHA-256 digest of
// a short message for a 2048-bit and a 1024-bit RSA key. The 2048-bit vector
// also exercises the Montgomery reduction spare-limb path.

extern @printf(fmt: *i8, ...) -> i32
extern @memcpy(dst: *i8, src: *i8, n: i64) -> *i8

extern @std_crypto_rsa_verify_pss_sha256(hash: *i8, sig: *i8, sig_len: i32,
                                         e: *i32, e_limbs: i32,
                                         n: *i32, limbs: i32) -> i1

const @E: [i32, 1] = [ 65537 ]

const @N1: [i32, 64] = [
  0xB59C0307, 0x96236945, 0x816107B4, 0xED4C9B9D,
  0x0D09BD29, 0x0711FC5F, 0x58F1F4C8, 0x5428F046,
  0x50C17450, 0xE5EDF813, 0x2A238A50, 0xFA70EF05,
  0xED48194B, 0x6B917BE0, 0x6481A622, 0xF226CFA2,
  0xC787C9EC, 0x570EC377, 0x1C7BF165, 0x6221ED2E,
  0xF454B950, 0x3B8321E1, 0xB0C5F37E, 0x2AE992EC,
  0xE32768D2, 0x370B422F, 0xBA73B63C, 0xA07FD43A,
  0x0070AD1B, 0x82BBE0C3, 0xDE9B2273, 0xD168AA43,
  0xE26AC7A6, 0x51B44800, 0xC9DB33AF, 0xD0229968,
  0x45FD3542, 0x151A5B07, 0x2D534324, 0xAF60D257,
  0xB72C0DF0, 0xB1294F62, 0xECE9789E, 0x270A3EB7,
  0xCCE67877, 0xCB6B1727, 0x453B7201, 0x66DF9C2C,
  0xAE887C70, 0x108E2D97, 0x00C715E8, 0xA466F8B4,
  0x84C069B3, 0x8CB3CE18, 0x2CEF0BEE, 0x65A4E7C3,
  0xA9F35ACD, 0x6C860724, 0x4F7D5600, 0x918A68AA,
  0x94F8D983, 0x4E77C1C3, 0x3A57B3BC, 0xBE646419
]

const @HASH1: [i8, 32] = [
  104, 226, 122, 150, 98, 191, 198, 202, 34, 225, 126, 127, 248, 58, 168, 97,
  62, 239, 114, 211, 26, 44, 37, 246, 228, 141, 96, 5, 52, 75, 67, 23
]

const @SIG1: [i8, 256] = [
  139, 41, 117, 57, 99, 119, 210, 128, 217, 116, 255, 194, 133, 41, 110, 56,
  168, 139, 160, 240, 107, 186, 230, 167, 167, 132, 19, 81, 142, 248, 56, 46,
  101, 207, 145, 191, 59, 38, 202, 122, 230, 242, 50, 37, 254, 69, 79, 188,
  40, 87, 97, 140, 13, 119, 31, 145, 137, 24, 168, 221, 156, 116, 119, 207,
  58, 71, 198, 240, 135, 50, 54, 169, 250, 187, 63, 239, 209, 91, 17, 219,
  214, 70, 202, 53, 200, 109, 10, 211, 193, 135, 110, 240, 12, 59, 160, 83,
  145, 34, 57, 23, 35, 209, 83, 85, 174, 165, 47, 247, 205, 38, 253, 102,
  189, 227, 70, 88, 107, 157, 95, 138, 142, 200, 214, 217, 95, 247, 13, 84,
  203, 143, 74, 7, 141, 179, 5, 218, 246, 194, 213, 119, 60, 241, 14, 69,
  161, 29, 28, 54, 36, 71, 142, 245, 210, 184, 81, 153, 35, 121, 93, 66,
  211, 81, 115, 87, 147, 29, 7, 63, 193, 222, 8, 128, 249, 91, 105, 234,
  150, 248, 89, 219, 106, 147, 130, 33, 181, 219, 252, 191, 11, 204, 46, 58,
  87, 251, 18, 248, 16, 100, 132, 73, 194, 217, 98, 97, 48, 43, 13, 12,
  241, 32, 249, 175, 221, 12, 219, 158, 21, 72, 93, 38, 134, 119, 97, 230,
  211, 247, 230, 166, 240, 8, 59, 237, 92, 206, 64, 84, 129, 198, 163, 95,
  156, 49, 116, 65, 206, 144, 45, 9, 13, 135, 234, 46, 156, 127, 7, 190
]

const @N2: [i32, 32] = [
  0x29677163, 0x99B65C3B, 0xE63BDB8E, 0x948E5B3B,
  0x17031A3D, 0x58C987EF, 0x66EDB914, 0x71EC2F34,
  0xD0723CE1, 0x28F34CCF, 0xC2821566, 0xE3C8C7D9,
  0x60F76E91, 0xC7D4159A, 0xA4660E0A, 0x7ED86395,
  0x0B4F5E4D, 0x86C502F2, 0x53E267BB, 0xAE4BFB26,
  0xE1041E3E, 0xC398F453, 0x559ADFC0, 0x94FA6A08,
  0xA0B3F5C1, 0xFE504CAB, 0x5ADC588E, 0xEFDA3A7D,
  0xF78C1250, 0x3AD474FB, 0xD3175E6F, 0xB50E59C0
]

const @HASH2: [i8, 32] = [
  64, 73, 99, 193, 30, 24, 85, 57, 212, 7, 95, 199, 54, 194, 50, 97,
  236, 36, 129, 17, 92, 209, 129, 38, 86, 166, 155, 92, 96, 86, 45, 204
]

const @SIG2: [i8, 128] = [
  115, 74, 51, 167, 101, 75, 202, 111, 248, 165, 126, 153, 205, 44, 8, 48,
  239, 90, 155, 9, 124, 213, 37, 94, 93, 80, 65, 88, 185, 6, 240, 61,
  216, 207, 28, 4, 179, 34, 103, 24, 6, 229, 148, 177, 224, 110, 44, 143,
  245, 201, 182, 67, 41, 178, 115, 11, 63, 2, 73, 110, 89, 35, 178, 153,
  178, 63, 91, 218, 82, 219, 61, 144, 216, 26, 129, 147, 215, 198, 228, 108,
  189, 224, 127, 140, 66, 120, 251, 243, 53, 227, 24, 152, 217, 55, 185, 140,
  152, 49, 128, 60, 79, 75, 123, 109, 184, 221, 191, 125, 63, 15, 22, 70,
  16, 50, 168, 137, 248, 236, 144, 159, 73, 25, 122, 206, 253, 46, 168, 211
]

fun @main() -> i32 {
  @entry:
    %h1 = gep i8, *@HASH1, 0
    %s1 = gep i8, *@SIG1, 0
    %r1 = call @std_crypto_rsa_verify_pss_sha256(%h1, %s1, 256, @E, 1, @N1, 64)
    %r1i = zext i1 %r1 to i32
    %ok1 = eq i32 %r1i, 1
    br %ok1, @t2, @fail

  // 1024-bit key
  @t2:
    %h2 = gep i8, *@HASH2, 0
    %s2 = gep i8, *@SIG2, 0
    %r2 = call @std_crypto_rsa_verify_pss_sha256(%h2, %s2, 128, @E, 1, @N2, 32)
    %r2i = zext i1 %r2 to i32
    %ok2 = eq i32 %r2i, 1
    br %ok2, @t3, @fail

  // Tampered signature must fail
  @t3:
    %tam = let [i8, 256]
    %tamp = gep i8, *%tam, 0
    call @memcpy(%tamp, %s1, 256)
    %lastp = gep i8, *%tam, 255
    %lastv = load i8, *%lastp
    %lv = zext i8 %lastv to i32
    %lv1 = add i32 %lv, 1
    %lvb = trunc i32 %lv1 to i8
    store i8 %lvb, *%lastp
    %r3 = call @std_crypto_rsa_verify_pss_sha256(%h1, %tamp, 256, @E, 1, @N1, 64)
    %r3i = zext i1 %r3 to i32
    %ok3 = eq i32 %r3i, 0
    br %ok3, @t4, @fail

  // Wrong digest must fail
  @t4:
    %wh = let [i8, 32]
    %whp = gep i8, *%wh, 0
    call @memcpy(%whp, %h1, 32)
    %hb = load i8, *%whp
    %hbz = zext i8 %hb to i32
    %hb1 = add i32 %hbz, 1
    %hbb = trunc i32 %hb1 to i8
    store i8 %hbb, *%whp
    %r4 = call @std_crypto_rsa_verify_pss_sha256(%whp, %s1, 256, @E, 1, @N1, 64)
    %r4i = zext i1 %r4 to i32
    %ok4 = eq i32 %r4i, 0
    br %ok4, @t5, @fail

  // Signature length must match the modulus
  @t5:
    %r5 = call @std_crypto_rsa_verify_pss_sha256(%h1, %s1, 255, @E, 1, @N1, 64)
    %r5i = zext i1 %r5 to i32
    %ok5 = eq i32 %r5i, 0
    br %ok5, @pass, @fail

  @pass:
    call @printf("PASS rsa_pss\n")
    ret i32 0
  @fail:
    call @printf("FAIL rsa_pss\n")
    ret i32 1
}
