    %kq31 = gep i32, *%key_q, 31
    store i32 0xd1356ab8, *%kq31

    // Write public key PEM
    %fpub = call @fopen("rsa.pub", "w")
    call @std_crypto_pem_write_rsa_pub(%fpub, %key_n, %key_e, 64)
    call @fclose(%fpub)

    // Write private key PEM
    %fpriv = call @fopen("rsa.key", "w")
    call @std_crypto_pem_write_rsa_priv(%fpriv, %key_n, %key_e, %key_d, %key_p, %key_q, 64)
    call @fclose(%fpriv)

    call @putchar('O')
    call @putchar('K')
    call @putchar('\n')
    ret i32 0
}