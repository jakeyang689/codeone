// HTTP request building and response parsing tests.

struct @HttpResponse {
  @version: i32,
  @status: i32,
  @reason_off: i32,
  @reason_len: i32,
  @headers_off: i32,
  @headers_len: i32,
  @body_off: i32,
  @body_len: i32,
  @content_length: i32,
  @chunked: i32
}
extern @printf(fmt: *i8, ...) -> i32
extern @memcmp(a: *i8, b: *i8, n: i64) -> i32

extern @net_http_build_get(buf: *i8, cap: i32, host: *i8, path: *i8, version: i32) -> i32
extern @net_http_build_post(buf: *i8, cap: i32, host: *i8, path: *i8,
                             content_type: *i8, body: *i8, body_len: i32,
                             version: i32) -> i32
extern @net_http_parse_response(buf: *i8, len: i32, resp: *@HttpResponse) -> i32
extern @net_http_header_get(buf: *i8, resp: *@HttpResponse, name: *i8,
                            out: *i8, cap: i32) -> i32
extern @net_http_decode_chunked(src: *i8, src_len: i32, dst: *i8, cap: i32) -> i32
extern @net_http_header_add(buf: *i8, cap: i32, off: i32, name: *i8, value: *i8) -> i32
extern @net_http_header_find(buf: *i8, resp: *@HttpResponse, name: *i8, from_off: i32) -> i32
extern @net_http_header_value(buf: *i8, resp: *@HttpResponse, line_off: i32, out: *i8, cap: i32) -> i32
extern @net_http_build_request(buf: *i8, cap: i32, method: *i8, host: *i8, path: *i8, headers: *i8, body: *i8, body_len: i32, version: i32) -> i32


const @HOST: [i8, 12] = "example.com"
const @RAW1: [i8, 70] = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Type: text/plain\r\n\r\nhello"
const @RAW6: [i8, 63] = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
const @RAW7: [i8, 27] = "HTTP/1.0 404 Not Found\r\n\r\n"
const @RAW9: [i8, 73] = "HTTP/1.1 200 OK\r\nSet-Cookie: a=1\r\nSet-Cookie: b=2\r\nContent-Length: 0\r\n\r\n"

fun @main() -> i32 {
  @entry:
    %buf = let [i8, 1024]
    %bp = gep i8, *%buf, 0
    %host_p = gep i8, *@HOST, 0

    // --- GET / HTTP/1.1 ---
    %n1 = call @net_http_build_get(%bp, 1024, %host_p, "/", 11)
    %d1 = call @memcmp(%bp, "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n", 56)
    %ok1a = eq i32 %n1, 56
    %ok1b = eq i32 %d1, 0
    %ok1 = and i1 %ok1a, %ok1b
    br %ok1, @t2, @fail1

  @t2:
    // --- GET with HTTP/1.0 and a path ---
    %n2 = call @net_http_build_get(%bp, 1024, %host_p, "/a/b", 10)
    %d2 = call @memcmp(%bp, "GET /a/b HTTP/1.0\r\nHost: example.com\r\nConnection: close\r\n\r\n", 59)
    %ok2a = eq i32 %n2, 59
    %ok2b = eq i32 %d2, 0
    %ok2 = and i1 %ok2a, %ok2b
    br %ok2, @t3, @fail2

  @t3:
    // --- POST with a 5-byte body ---
    %n3 = call @net_http_build_post(%bp, 1024, %host_p, "/submit",
                                    "text/plain", "hello", 5, 11)
    %d3 = call @memcmp(%bp, "POST /submit HTTP/1.1\r\nHost: example.com\r\nContent-Type: text/plain\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello", 113)
    %ok3a = eq i32 %n3, 113
    %ok3b = eq i32 %d3, 0
    %ok3 = and i1 %ok3a, %ok3b
    br %ok3, @t4, @fail3

  @t4:
    // --- Parse a simple response ---
    %resp = let [i32, 10]
    %rp = gep i32, *%resp, 0
    %raw1 = gep i8, *@RAW1, 0
    %r4 = call @net_http_parse_response(%raw1, 70, %rp)
    %r4_ok = eq i32 %r4, 0
    br %r4_ok, @t4chk, @fail4
  @t4chk:
    %st_p = field @HttpResponse, *%rp, 1
    %st = load i32, *%st_p
    %ver_p = field @HttpResponse, *%rp, 0
    %ver = load i32, *%ver_p
    %cl_p = field @HttpResponse, *%rp, 8
    %cl = load i32, *%cl_p
    %bl_p = field @HttpResponse, *%rp, 7
    %bl = load i32, *%bl_p
    %bo_p = field @HttpResponse, *%rp, 6
    %bo = load i32, *%bo_p
    %ck_p = field @HttpResponse, *%rp, 9
    %ck = load i32, *%ck_p
    %c_st = eq i32 %st, 200
    %c_ver = eq i32 %ver, 11
    %c_cl = eq i32 %cl, 5
    %c_bl = eq i32 %bl, 5
    %c_ck = eq i32 %ck, 0
    %x1 = and i1 %c_st, %c_ver
    %x2 = and i1 %c_cl, %c_bl
    %x3 = and i1 %x1, %x2
    %x4 = and i1 %x3, %c_ck
    br %x4, @t4body, @fail4
  @t4body:
    %bodyp = gep i8, *%raw1, %bo
    %d4 = call @memcmp(%bodyp, "hello", 5)
    %ok4b = eq i32 %d4, 0
    br %ok4b, @t5, @fail4

  @t5:
    // --- Header lookup ---
    %hout = let [i8, 64]
    %hp = gep i8, *%hout, 0
    %hl = call @net_http_header_get(%raw1, %rp, "content-type", %hp, 64)
    %hl_ok = eq i32 %hl, 10
    br %hl_ok, @t5c, @fail5
  @t5c:
    %hd = call @memcmp(%hp, "text/plain", 10)
    %hd_ok = eq i32 %hd, 0
    br %hd_ok, @t6, @fail5

  @t6:
    // --- Chunked response ---
    %raw6 = gep i8, *@RAW6, 0
    %r6 = call @net_http_parse_response(%raw6, 62, %rp)
    %r6_ok = eq i32 %r6, 0
    br %r6_ok, @t6chk, @fail6
  @t6chk:
    %ck6_p = field @HttpResponse, *%rp, 9
    %ck6 = load i32, *%ck6_p
    %ck6_ok = eq i32 %ck6, 1
    br %ck6_ok, @t6dec, @fail6
  @t6dec:
    %bo6_p = field @HttpResponse, *%rp, 6
    %bo6 = load i32, *%bo6_p
    %src6 = gep i8, *%raw6, %bo6
    %rem6 = sub i32 62, %bo6
    %out6 = let [i8, 64]
    %o6 = gep i8, *%out6, 0
    %n6 = call @net_http_decode_chunked(%src6, %rem6, %o6, 64)
    %n6_ok = eq i32 %n6, 5
    br %n6_ok, @t6cmp, @fail6
  @t6cmp:
    %d6 = call @memcmp(%o6, "hello", 5)
    %d6_ok = eq i32 %d6, 0
    br %d6_ok, @t7, @fail6

  @t7:
    // --- HTTP/1.0 404 without body ---
    %raw7 = gep i8, *@RAW7, 0
    %r7 = call @net_http_parse_response(%raw7, 26, %rp)
    %r7_ok = eq i32 %r7, 0
    br %r7_ok, @t7chk, @fail7
  @t7chk:
    %st7_p = field @HttpResponse, *%rp, 1
    %st7 = load i32, *%st7_p
    %ver7_p = field @HttpResponse, *%rp, 0
    %ver7 = load i32, *%ver7_p
    %rl7_p = field @HttpResponse, *%rp, 3
    %rl7 = load i32, *%rl7_p
    %c7a = eq i32 %st7, 404
    %c7b = eq i32 %ver7, 10
    %c7c = eq i32 %rl7, 9
    %x7a = and i1 %c7a, %c7b
    %x7b = and i1 %x7a, %c7c
    br %x7b, @t8, @fail7

  @t8:
    // --- custom headers through build_request ---
    %hbuf = let [i8, 256]
    %hp8 = gep i8, *%hbuf, 0
    %o1 = call @net_http_header_add(%hp8, 256, 0, "User-Agent", "c1")
    %o2 = call @net_http_header_add(%hp8, 256, %o1, "Accept", "*/*")
    %nul = gep i8, *%hp8, %o2
    store i8 0, *%nul
    %n8 = call @net_http_build_request(%bp, 1024, "GET", %host_p, "/x", %hp8, null, 0, 11)
    %d8 = call @memcmp(%bp, "GET /x HTTP/1.1\r\nHost: example.com\r\nUser-Agent: c1\r\nAccept: */*\r\nConnection: close\r\n\r\n", 86)
    %ok8a = eq i32 %n8, 86
    %ok8b = eq i32 %d8, 0
    %ok8 = and i1 %ok8a, %ok8b
    br %ok8, @t9, @fail8

  @t9:
    // --- repeated headers (Set-Cookie) ---
    %raw9 = gep i8, *@RAW9, 0
    %r9 = call @net_http_parse_response(%raw9, 72, %rp)
    %r9_ok = eq i32 %r9, 0
    br %r9_ok, @t9a, @fail9
  @t9a:
    %p1 = call @net_http_header_find(%raw9, %rp, "set-cookie", 0)
    %p1_ok = sgt i32 %p1, 0
    br %p1_ok, @t9b, @fail9
  @t9b:
    %out9 = let [i8, 64]
    %op = gep i8, *%out9, 0
    %v1 = call @net_http_header_value(%raw9, %rp, %p1, %op, 64)
    %v1_ok = eq i32 %v1, 3
    br %v1_ok, @t9c, @fail9
  @t9c:
    %d9a = call @memcmp(%op, "a=1", 3)
    %d9a_ok = eq i32 %d9a, 0
    br %d9a_ok, @t9d, @fail9
  @t9d:
    %p1n = add i32 %p1, 1
    %p2 = call @net_http_header_find(%raw9, %rp, "set-cookie", %p1n)
    %p2_ok = sgt i32 %p2, %p1
    br %p2_ok, @t9e, @fail9
  @t9e:
    %v2 = call @net_http_header_value(%raw9, %rp, %p2, %op, 64)
    %v2_ok = eq i32 %v2, 3
    br %v2_ok, @t9f, @fail9
  @t9f:
    %d9b = call @memcmp(%op, "b=2", 3)
    %d9b_ok = eq i32 %d9b, 0
    br %d9b_ok, @t9g, @fail9
  @t9g:
    %p2n = add i32 %p2, 1
    %p3 = call @net_http_header_find(%raw9, %rp, "set-cookie", %p2n)
    %none = slt i32 %p3, 0
    br %none, @pass, @fail9

  @pass:
    call @printf("PASS http\n")
    ret i32 0

  @fail1:
    call @printf("FAIL get (n=%d)\n", %n1)
    ret i32 1
  @fail2:
    call @printf("FAIL get10 (n=%d)\n", %n2)
    ret i32 2
  @fail3:
    call @printf("FAIL post (n=%d)\n", %n3)
    ret i32 3
  @fail4:
    call @printf("FAIL parse resp\n")
    ret i32 4
  @fail5:
    call @printf("FAIL header get (len=%d)\n", %hl)
    ret i32 5
  @fail6:
    call @printf("FAIL chunked\n")
    ret i32 6
  @fail9:
    call @printf("FAIL repeated headers\n")
    ret i32 9
  @fail8:
    call @printf("FAIL custom headers (n=%d)\n", %n8)
    ret i32 8
  @fail7:
    call @printf("FAIL http10\n")
    ret i32 7
}
