// let / load / store / gep / field semantics.

extern @printf(fmt: *i8, ...) -> i32

struct @Pair {
  @a: i32,
  @b: i64
}

fun @main() -> i32 {
  @entry:
    %id = let i32
    store i32 0, *%id

    // --- array element access ---
    %arr = let [i32, 4]
    %p0 = gep i32, *%arr, 0
    store i32 10, *%p0
    %p1 = gep i32, *%arr, 1
    store i32 20, *%p1
    %p3 = gep i32, *%arr, 3
    store i32 40, *%p3
    %v1 = load i32, *%p1
    %c1 = eq i32 %v1, 20
    br %c1, @t1, @fail

  @t1:
    store i32 1, *%id
    %v3 = load i32, *%p3
    %c2 = eq i32 %v3, 40
    br %c2, @t2, @fail

  @t2:
    store i32 2, *%id
    // --- byte array through a pointer ---
    %bytes = let [i8, 8]
    %bp = gep i8, *%bytes, 0
    store i8 -1, *%bp
    %b2 = gep i8, *%bytes, 2
    store i8 0x41, *%b2
    %bv = load i8, *%b2
    %c3 = eq i8 %bv, 65
    br %c3, @t3, @fail

  @t3:
    store i32 3, *%id
    %bv0 = load i8, *%bp
    %c4 = eq i8 %bv0, -1
    br %c4, @t4, @fail

  @t4:
    store i32 4, *%id
    // --- struct fields ---
    %pair = let @Pair
    %pp = gep @Pair, *%pair, 0
    %ap = field @Pair, *%pp, 0
    store i32 7, *%ap
    %bpf = field @Pair, *%pp, 1
    store i64 9000000000, *%bpf
    %av = load i32, *%ap
    %c5 = eq i32 %av, 7
    br %c5, @t5, @fail

  @t5:
    store i32 5, *%id
    %bv2 = load i64, *%bpf
    %c6 = eq i64 %bv2, 9000000000
    br %c6, @t6, @fail

  @t6:
    store i32 6, *%id
    // --- nested struct ---
    %nest = let [@Pair, 2]
    %n0 = gep @Pair, *%nest, 0
    %n1 = gep @Pair, *%nest, 1
    %n0a = field @Pair, *%n0, 0
    store i32 77, *%n0a              // let memory starts undefined, so seed element 0
    %n1a = field @Pair, *%n1, 0
    store i32 123, *%n1a
    %nv = load i32, *%n0a
    %c7 = eq i32 %nv, 77             // element 0 is untouched by the element 1 store
    br %c7, @t7, @fail

  @t7:
    store i32 7, *%id
    %n1v = load i32, *%n1a
    %c8 = eq i32 %n1v, 123
    br %c8, @t8, @fail

  @t8:
    store i32 8, *%id
    // --- i64 array ---
    %big = let [i64, 2]
    %q0 = gep i64, *%big, 0
    store i64 -5, *%q0
    %q0v = load i64, *%q0
    %c9 = eq i64 %q0v, -5
    br %c9, @pass, @fail

  @pass:
    call @printf("PASS isa/memory\n")
    ret i32 0
  @fail:
    %n = load i32, *%id
    call @printf("FAIL isa/memory at case %d\n", %n)
    ret i32 1
}
