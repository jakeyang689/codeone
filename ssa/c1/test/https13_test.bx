// HTTPS through the high-level HTTP client over TLS 1.3, and the TLS 1.2
// fallback path.
//
//   port 8801: TLS 1.3 only  -> negotiated as 1.3
//   port 8802: TLS 1.2 only  -> net_http_client_open falls back to 1.2

extern @printf(fmt: *i8, ...) -> i32
extern @memcmp(a: *i8, b: *i8, n: i64) -> i32

extern @net_http_request(host: *i8, host_len: i32, port: i32, use_tls: i32,
                         req: *i8, req_len: i32, resp: *i8,
                         resp_cap: i32) -> i32

const @REQ: [i8, 55] = "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"

fun @main() -> i32 {
  @entry:
    %id = let i32
    store i32 0, *%id
    %resp = let [i8, 8192]
    %rp = gep i8, *%resp, 0
    %reqp = gep i8, *@REQ, 0

    // --- TLS 1.3 ---
    %n1 = call @net_http_request("localhost", 9, 8801, 1, %reqp, 54, %rp, 8192)
    %n1_ok = sgt i32 %n1, 0
    br %n1_ok, @c1, @fail
  @c1:
    store i32 1, *%id
    %d1 = call @memcmp(%rp, "HTTP/1.1 200", 12)
    %d1_ok = eq i32 %d1, 0
    br %d1_ok, @t12, @fail

  // --- TLS 1.2 fallback ---
  @t12:
    store i32 2, *%id
    %n2 = call @net_http_request("localhost", 9, 8802, 1, %reqp, 54, %rp, 8192)
    %n2_ok = sgt i32 %n2, 0
    br %n2_ok, @c2, @fail
  @c2:
    store i32 3, *%id
    %d2 = call @memcmp(%rp, "HTTP/1.1 200", 12)
    %d2_ok = eq i32 %d2, 0
    br %d2_ok, @pass, @fail

  @pass:
    call @printf("PASS https13\n")
    ret i32 0
  @fail:
    %cid = load i32, *%id
    call @printf("FAIL https13 at case %d\n", %cid)
    ret i32 1
}
