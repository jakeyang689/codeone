// Selection sort on a 6-element array
// Sorts [64, 25, 12, 22, 11, 9] into ascending order
// main() returns arr[0] which should be 9 after sorting

fun @selection_sort(arr: *i32, n: i32) -> void {
  @entry:
    %i = let i32
    %j = let i32
    %min_idx = let i32
    store i32 0, *%i
    jmp @outer_loop

  @outer_loop:
    %iv = load i32, *%i
    %c1 = slt i32 %iv, %n
    br %c1, @inner_init, @done

  @inner_init:
    %iv2 = load i32, *%i
    store i32 %iv2, *%min_idx
    %j_start = add i32 %iv2, 1
    store i32 %j_start, *%j
    jmp @inner_cond

  @inner_cond:
    %jv = load i32, *%j
    %c2 = slt i32 %jv, %n
    br %c2, @inner_body, @swap_step

  @inner_body:
    %jv2 = load i32, *%j
    %pj = gep i32, *%arr, %jv2
    %vj = load i32, *%pj

    %mv = load i32, *%min_idx
    %pm = gep i32, *%arr, %mv
    %vm = load i32, *%pm

    %lt = slt i32 %vj, %vm
    br %lt, @update_min, @inner_next

  @update_min:
    %jv3 = load i32, *%j
    store i32 %jv3, *%min_idx
    jmp @inner_next

  @inner_next:
    %jv4 = load i32, *%j
    %j_next = add i32 %jv4, 1
    store i32 %j_next, *%j
    jmp @inner_cond

  @swap_step:
    %iv3 = load i32, *%i
    %pi = gep i32, *%arr, %iv3
    %vi = load i32, *%pi

    %mv2 = load i32, *%min_idx
    %pm2 = gep i32, *%arr, %mv2
    %vm2 = load i32, *%pm2

    store i32 %vm2, *%pi
    store i32 %vi, *%pm2

    %i_next = add i32 %iv3, 1
    store i32 %i_next, *%i
    jmp @outer_loop

  @done:
    ret void
}

fun @main() -> i32 {
  @entry:
    %arr = let [i32, 6]

    %p0 = gep i32, *%arr, 0
    store i32 64, *%p0

    %p1 = gep i32, *%arr, 1
    store i32 25, *%p1

    %p2 = gep i32, *%arr, 2
    store i32 12, *%p2

    %p3 = gep i32, *%arr, 3
    store i32 22, *%p3

    %p4 = gep i32, *%arr, 4
    store i32 11, *%p4

    %p5 = gep i32, *%arr, 5
    store i32 9, *%p5

    call @selection_sort(%arr, 6)

    %v0 = load i32, *%p0
    %c0 = eq i32 %v0, 9
    br %c0, @chk1, @fail
  @chk1:
    %v1 = load i32, *%p1
    %c1 = eq i32 %v1, 11
    br %c1, @chk2, @fail
  @chk2:
    %v2 = load i32, *%p2
    %c2 = eq i32 %v2, 12
    br %c2, @chk3, @fail
  @chk3:
    %v3 = load i32, *%p3
    %c3 = eq i32 %v3, 22
    br %c3, @chk4, @fail
  @chk4:
    %v4 = load i32, *%p4
    %c4 = eq i32 %v4, 25
    br %c4, @chk5, @fail
  @chk5:
    %v5 = load i32, *%p5
    %c5 = eq i32 %v5, 64
    br %c5, @pass, @fail
  @pass:
    ret i32 0
  @fail:
    ret i32 1
}
