// TLS trust-store tests against tls13_server.py.
//
//   1. load the trust anchors
//   2. TLS 1.3, trust store = certs/chain_root.pem -> handshake must fail
//   3. TLS 1.3, trust store = certs/tls13.pem      -> HTTP exchange returns "hello"
//   4. TLS 1.2, trust store = certs/chain_root.pem -> handshake must fail
//   5. TLS 1.2, trust store = certs/tls13.pem      -> HTTP exchange returns "hello"
//   6. TLS 1.3, server sends leaf + intermediate, trust = root -> success
//   7. TLS 1.3, same leaf without its intermediate           -> must fail

extern @printf(fmt: *i8, ...) -> i32
extern @memcmp(a: *i8, b: *i8, n: i64) -> i32

extern @std_io_file_open_read(path: *i8) -> *i8
extern @std_io_file_read_all(fp: *i8, buf: *i8, cap: i32) -> i32
extern @std_io_file_close(fp: *i8) -> i32
extern @std_crypto_pem_read_cert(pem: *i8, pem_len: i32, out: *i8, out_cap: i32,
                                 out_len: *i32) -> i32

extern @net_socket_tcp() -> i32
extern @net_socket_connect(fd: i32, port: i32) -> i32
extern @net_socket_close(fd: i32) -> i32

extern @net_tls_set_host(ctx: *i8, host: *i8, len: i32) -> void
extern @net_tls_set_trust(ctx: *i8, pool: *i8, offsets: *i32, lens: *i32,
                          count: i32) -> void
extern @net_tls13_connect(ctx: *i8, fd: i32, limbs: i32) -> i32
extern @net_tls12_connect(ctx: *i8, fd: i32, limbs: i32) -> i32
extern @net_tls_send(ctx: *i8, data: *i8, len: i32) -> i32
extern @net_tls_recv(ctx: *i8, buf: *i8, cap: i32, out_len: *i32) -> i32
extern @net_tls_close(ctx: *i8) -> i32

// Layouts must match net/tls/client_api.bx.
struct @TLS12Context {
  @fd: i32,
  @state: i32,
  @version: i32,
  @key_size: i32,
  @limbs: i32,
  @cipher_suite: i32,
  @client_seq: i64,
  @server_seq: i64,
  @client_random: [i8, 32],
  @server_random: [i8, 32],
  @client_write_key: [i8, 32],
  @server_write_key: [i8, 32],
  @client_write_iv: [i8, 12],
  @server_write_iv: [i8, 12],
  @pre_master_secret: [i8, 48],
  @master_secret: [i8, 48]
}

struct @TLS13Extension {
  @init_client_seq: i64,
  @_pad: [i8, 24],
  @ecdhe_private: [i8, 32],
  @ecdhe_public_x: [i8, 32],
  @ecdhe_public_y: [i8, 32],
  @server_ec_x: [i8, 32],
  @server_ec_y: [i8, 32],
  @handshake_traffic: [i8, 48],
  @application_traffic: [i8, 48],
  @sni_host: [i8, 256],
  @sni_len: i32,
  @role: i32,
  @trust_pool: *i8,
  @trust_offsets: *i32,
  @trust_lens: *i32,
  @trust_count: i32
}

struct @TLSContext {
  @tls12: @TLS12Context,
  @tls13: @TLS13Extension
}

const @REQ: [i8, 55] = "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
const @SERVER_PATH = "certs/tls13.pem"
const @ROOT_PATH = "certs/chain_root.pem"

// Read the first certificate from a PEM file into DER.
fun @read_cert(path: *i8, out: *i8, out_cap: i32, out_len: *i32) -> i32 {
  @entry:
    %pem = let [i8, 16384]
    %pp = gep i8, *%pem, 0
    %fp = call @std_io_file_open_read(%path)
    %fn = eq *i8 %fp, null
    br %fn, @fail, @read
  @read:
    %n = call @std_io_file_read_all(%fp, %pp, 16383)
    call @std_io_file_close(%fp)
    %nok = sgt i32 %n, 0
    br %nok, @dec, @fail
  @dec:
    %r = call @std_crypto_pem_read_cert(%pp, %n, %out, %out_cap, %out_len)
    ret i32 %r
  @fail:
    ret i32 -1
}

// One HTTP request/response over a connected TLS session.
fun @http_exchange(ctx: *i8, fd: i32) -> i32 {
  @entry:
    %reqp = gep i8, *@REQ, 0
    %sr = call @net_tls_send(%ctx, %reqp, 54)
    %sr_ok = eq i32 %sr, 0
    br %sr_ok, @recv, @fail
  @recv:
    %buf = let [i8, 4096]
    %bufp = gep i8, *%buf, 0
    %olen = let i32
    %olenp = gep i32, *%olen, 0
    %rr = call @net_tls_recv(%ctx, %bufp, 4096, %olenp)
    %rr_ok = eq i32 %rr, 0
    br %rr_ok, @check, @fail
  @check:
    %n = load i32, *%olen
    %n_ok = sgt i32 %n, 12
    br %n_ok, @prefix, @fail
  @prefix:
    %pfx = call @memcmp(%bufp, "HTTP/1.1 200", 12)
    %pfx_ok = eq i32 %pfx, 0
    br %pfx_ok, @scan_init, @fail
  @scan_init:
    %i = let i32
    store i32 0, *%i
    jmp @scan_cond
  @scan_cond:
    %iv = load i32, *%i
    %lim = sub i32 %n, 5
    %more = sle i32 %iv, %lim
    br %more, @scan_body, @fail
  @scan_body:
    %iv2 = load i32, *%i
    %spp = gep i8, *%bufp, %iv2
    %c = call @memcmp(%spp, "hello", 5)
    %hit = eq i32 %c, 0
    br %hit, @ok, @scan_next
  @scan_next:
    %iv3 = load i32, *%i
    %nx = add i32 %iv3, 1
    store i32 %nx, *%i
    jmp @scan_cond
  @ok:
    ret i32 0
  @fail:
    ret i32 -1
}

fun @main() -> i32 {
  @entry:
    %id = let i32
    store i32 0, *%id

    %good = let [i8, 4096]
    %wrong = let [i8, 4096]
    %glen = let i32
    %wlen = let i32
    %gp = gep i8, *%good, 0
    %wp = gep i8, *%wrong, 0
    %glp = gep i32, *%glen, 0
    %wlp = gep i32, *%wlen, 0
    %goffs = let [i32, 4]
    %glens = let [i32, 4]
    %woffs = let [i32, 4]
    %wlens = let [i32, 4]
    %goffsp = gep i32, *%goffs, 0
    %glensp = gep i32, *%glens, 0
    %woffsp = gep i32, *%woffs, 0
    %wlensp = gep i32, *%wlens, 0

    // case 1: load the two trust anchors
    store i32 1, *%id
    %sp = gep i8, *@SERVER_PATH, 0
    %rg = call @read_cert(%sp, %gp, 4096, %glp)
    %rg_ok = eq i32 %rg, 0
    br %rg_ok, @load_wrong, @fail
  @load_wrong:
    %rp = gep i8, *@ROOT_PATH, 0
    %rw = call @read_cert(%rp, %wp, 4096, %wlp)
    %rw_ok = eq i32 %rw, 0
    br %rw_ok, @arrays, @fail
  @arrays:
    store i32 0, *%goffsp
    store i32 0, *%woffsp
    %gv = load i32, *%glp
    store i32 %gv, *%glensp
    %wv = load i32, *%wlp
    store i32 %wv, *%wlensp

    // case 2: TLS 1.3 with a trust store that lacks the server cert
    store i32 2, *%id
    %ctx = let @TLSContext
    %cp = gep i8, *%ctx, 0
    call @net_tls_set_host(%cp, "localhost", 9)
    call @net_tls_set_trust(%cp, %wp, %woffsp, %wlensp, 1)
    %fd = call @net_socket_tcp()
    %fd_ok = sge i32 %fd, 0
    br %fd_ok, @wrong_connect, @fail
  @wrong_connect:
    %cr = call @net_socket_connect(%fd, 8803)
    %cr_ok = eq i32 %cr, 0
    br %cr_ok, @wrong_hs, @fail
  @wrong_hs:
    %hr = call @net_tls13_connect(%cp, %fd, 64)
    %hr_bad = ne i32 %hr, 0
    br %hr_bad, @t13_good, @fail

    // case 3: TLS 1.3 trusting the server cert
  @t13_good:
    store i32 3, *%id
    call @net_socket_close(%fd)
    %ctx2 = let @TLSContext
    %cp2 = gep i8, *%ctx2, 0
    call @net_tls_set_host(%cp2, "localhost", 9)
    call @net_tls_set_trust(%cp2, %gp, %goffsp, %glensp, 1)
    %fd2 = call @net_socket_tcp()
    %fd2_ok = sge i32 %fd2, 0
    br %fd2_ok, @good_connect, @fail
  @good_connect:
    %cr2 = call @net_socket_connect(%fd2, 8803)
    %cr2_ok = eq i32 %cr2, 0
    br %cr2_ok, @t13_hs, @fail
  @t13_hs:
    %hr2 = call @net_tls13_connect(%cp2, %fd2, 64)
    %hr2_ok = eq i32 %hr2, 0
    br %hr2_ok, @t13_x, @fail
  @t13_x:
    %x2 = call @http_exchange(%cp2, %fd2)
    %x2_ok = eq i32 %x2, 0
    br %x2_ok, @t12_wrong, @fail

    // case 4: TLS 1.2 with a trust store that lacks the server cert
  @t12_wrong:
    store i32 4, *%id
    call @net_tls_close(%cp2)
    call @net_socket_close(%fd2)
    %ctx3 = let @TLSContext
    %cp3 = gep i8, *%ctx3, 0
    call @net_tls_set_host(%cp3, "localhost", 9)
    call @net_tls_set_trust(%cp3, %wp, %woffsp, %wlensp, 1)
    %fd3 = call @net_socket_tcp()
    %fd3_ok = sge i32 %fd3, 0
    br %fd3_ok, @t12_connect, @fail
  @t12_connect:
    %cr3 = call @net_socket_connect(%fd3, 8802)
    %cr3_ok = eq i32 %cr3, 0
    br %cr3_ok, @t12_hs, @fail
  @t12_hs:
    %hr3 = call @net_tls12_connect(%cp3, %fd3, 64)
    %hr3_bad = ne i32 %hr3, 0
    br %hr3_bad, @t12_good, @fail

    // case 5: TLS 1.2 trusting the server cert
  @t12_good:
    store i32 5, *%id
    call @net_socket_close(%fd3)
    %ctx4 = let @TLSContext
    %cp4 = gep i8, *%ctx4, 0
    call @net_tls_set_host(%cp4, "localhost", 9)
    call @net_tls_set_trust(%cp4, %gp, %goffsp, %glensp, 1)
    %fd4 = call @net_socket_tcp()
    %fd4_ok = sge i32 %fd4, 0
    br %fd4_ok, @t12_good_connect, @fail
  @t12_good_connect:
    %cr4 = call @net_socket_connect(%fd4, 8802)
    %cr4_ok = eq i32 %cr4, 0
    br %cr4_ok, @t12_good_hs, @fail
  @t12_good_hs:
    %hr4 = call @net_tls12_connect(%cp4, %fd4, 64)
    %hr4_ok = eq i32 %hr4, 0
    br %hr4_ok, @t12_x, @fail
  @t12_x:
    %x4 = call @http_exchange(%cp4, %fd4)
    %x4_ok = eq i32 %x4, 0
    br %x4_ok, @chain_good, @fail

    // case 6: TLS 1.3, server sends leaf + intermediate, trust store = root
  @chain_good:
    store i32 6, *%id
    call @net_tls_close(%cp4)
    call @net_socket_close(%fd4)
    %ctx5 = let @TLSContext
    %cp5 = gep i8, *%ctx5, 0
    call @net_tls_set_host(%cp5, "localhost", 9)
    call @net_tls_set_trust(%cp5, %wp, %woffsp, %wlensp, 1)
    %fd5 = call @net_socket_tcp()
    %fd5_ok = sge i32 %fd5, 0
    br %fd5_ok, @chain_connect, @fail
  @chain_connect:
    %cr5 = call @net_socket_connect(%fd5, 8804)
    %cr5_ok = eq i32 %cr5, 0
    br %cr5_ok, @chain_hs, @fail
  @chain_hs:
    %hr5 = call @net_tls13_connect(%cp5, %fd5, 64)
    %hr5_ok = eq i32 %hr5, 0
    br %hr5_ok, @chain_x, @fail
  @chain_x:
    %x5 = call @http_exchange(%cp5, %fd5)
    %x5_ok = eq i32 %x5, 0
    br %x5_ok, @chain_nointer, @fail

    // case 7: the same leaf without its intermediate must be rejected
  @chain_nointer:
    store i32 7, *%id
    call @net_tls_close(%cp5)
    call @net_socket_close(%fd5)
    %ctx6 = let @TLSContext
    %cp6 = gep i8, *%ctx6, 0
    call @net_tls_set_host(%cp6, "localhost", 9)
    call @net_tls_set_trust(%cp6, %wp, %woffsp, %wlensp, 1)
    %fd6 = call @net_socket_tcp()
    %fd6_ok = sge i32 %fd6, 0
    br %fd6_ok, @nointer_connect, @fail
  @nointer_connect:
    %cr6 = call @net_socket_connect(%fd6, 8805)
    %cr6_ok = eq i32 %cr6, 0
    br %cr6_ok, @nointer_hs, @fail
  @nointer_hs:
    %hr6 = call @net_tls13_connect(%cp6, %fd6, 64)
    %hr6_bad = ne i32 %hr6, 0
    br %hr6_bad, @close, @fail

  @close:
    call @net_socket_close(%fd6)
    call @printf("PASS tls_trust\n")
    ret i32 0
  @fail:
    %cid = load i32, *%id
    call @printf("FAIL tls_trust at case %d\n", %cid)
    ret i32 1
}
