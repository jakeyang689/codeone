// Test AES-128-CBC encrypt/decrypt against OpenSSL
extern @printf(fmt: *i8, ...) -> i32
extern @std_crypto_aes128_cbc_encrypt(plaintext: *i8, plaintext_len: i32, key: *i8, iv: *i8, ciphertext: *i8) -> void
extern @std_crypto_aes128_cbc_decrypt(ciphertext: *i8, ciphertext_len: i32, key: *i8, iv: *i8, plaintext: *i8) -> void

// NIST SP 800-38A Test Vector F.2.3 for CBC-AES128
// Key:   2b7e151628aed2a6abf7158809cf4f3c
// IV:    000102030405060708090a0b0c0d0e0f
// Plaintext:  6bc1bee22e409f96e93d7e117393172a
//            ae2d8a571e03ac9c9eb76fac45af8e51
//            30c81c46a35ce411e5fbc1911eaa0194
//            c1b3256a8e5c4a9be5d570fb2d6bf823
// Ciphertext: 7649abac8119b246cee98e9b12e9197d
//            5086cb9b507219ee95db113a917678b2
//            73bed6b8e3c1743b7116e69e22229516
//            3ff1caa1681fac09120eca307586e1a7

const @key: [i8, 16] = [
  0x2b, 0x7e, 0x15, 0x16, 0x28, 0xae, 0xd2, 0xa6,
  0xab, 0xf7, 0x15, 0x88, 0x09, 0xcf, 0x4f, 0x3c
]
const @iv: [i8, 16] = [
  0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
  0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f
]
const @pt: [i8, 64] = [
  0x6b, 0xc1, 0xbe, 0xe2, 0x2e, 0x40, 0x9f, 0x96,
  0xe9, 0x3d, 0x7e, 0x11, 0x73, 0x93, 0x17, 0x2a,
  0xae, 0x2d, 0x8a, 0x57, 0x1e, 0x03, 0xac, 0x9c,
  0x9e, 0xb7, 0x6f, 0xac, 0x45, 0xaf, 0x8e, 0x51,
  0x30, 0xc8, 0x1c, 0x46, 0xa3, 0x5c, 0xe4, 0x11,
  0xe5, 0xfb, 0xc1, 0x91, 0x1e, 0xaa, 0x01, 0x94,
  0xc1, 0xb3, 0x25, 0x6a, 0x8e, 0x5c, 0x4a, 0x9b,
  0xe5, 0xd5, 0x70, 0xfb, 0x2d, 0x6b, 0xf8, 0x23
]
const @expected_ct: [i8, 64] = [
  0x76, 0x49, 0xab, 0xac, 0x81, 0x19, 0xb2, 0x46,
  0xce, 0xe9, 0x8e, 0x9b, 0x12, 0xe9, 0x19, 0x7d,
  0x50, 0x86, 0xcb, 0x9b, 0x50, 0x72, 0x19, 0xee,
  0x95, 0xdb, 0x11, 0x3a, 0x91, 0x76, 0x78, 0xb2,
  0x94, 0x17, 0x2c, 0x86, 0x8c, 0x22, 0xbb, 0x57,
  0x8f, 0xe9, 0xda, 0x75, 0x40, 0xc9, 0xfa, 0xe8,
  0x02, 0xe3, 0x77, 0xb0, 0xf2, 0xb1, 0xb1, 0xff,
  0x3c, 0xd6, 0xd6, 0xc1, 0xc2, 0x33, 0x0a, 0x05
]

fun @print_hex(data: *i8, len: i32) -> void {
  @entry:
    %i = let i32
    store i32 0, *%i
    jmp @loop_cond
  @loop_cond:
    %iv = load i32, *%i
    %done = slt i32 %iv, %len
    br %done, @loop_body, @loop_done
  @loop_body:
    %p = gep i8, *%data, %iv
    %b = load i8, *%p
    %bz = zext i8 %b to i32
    call @printf("%02x", %bz)
    %next = add i32 %iv, 1
    store i32 %next, *%i
    jmp @loop_cond
  @loop_done:
    ret void
}

fun @cmp(a: *i8, b: *i8, len: i32) -> i1 {
  @entry:
    %i = let i32
    store i32 0, *%i
    jmp @cmp_cond
  @cmp_cond:
    %iv = load i32, *%i
    %more = slt i32 %iv, %len
    br %more, @cmp_body, @cmp_eq
  @cmp_body:
    %iv2 = load i32, *%i
    %ap = gep i8, *%a, %iv2
    %av = load i8, *%ap
    %bp = gep i8, *%b, %iv2
    %bv = load i8, *%bp
    %ok = eq i8 %av, %bv
    br %ok, @cmp_next, @cmp_neq
  @cmp_next:
    %iv3 = load i32, *%i
    %next = add i32 %iv3, 1
    store i32 %next, *%i
    jmp @cmp_cond
  @cmp_eq: ret i1 1
  @cmp_neq: ret i1 0
}

fun @main() -> i32 {
  @entry:
    %kp = gep i8, *@key, 0
    %ivp = gep i8, *@iv, 0
    %ptp = gep i8, *@pt, 0
    %exp_p = gep i8, *@expected_ct, 0

    // Encrypt
    %ct = let [i8, 64]
    %ct_p = gep i8, *%ct, 0
    call @std_crypto_aes128_cbc_encrypt(%ptp, 64, %kp, %ivp, %ct_p)
    call @printf("Encrypted:  ")
    call @print_hex(%ct_p, 64)
    call @printf("\nExpected:   ")
    call @print_hex(%exp_p, 64)
    call @printf("\n")

    %enc_ok = call @cmp(%ct_p, %exp_p, 64)
    br %enc_ok, @test_decrypt, @fail_enc

  @test_decrypt:
    // Decrypt back
    %pt2 = let [i8, 64]
    %pt2_p = gep i8, *%pt2, 0
    call @std_crypto_aes128_cbc_decrypt(%ct_p, 64, %kp, %ivp, %pt2_p)
    call @printf("Decrypted:  ")
    call @print_hex(%pt2_p, 64)
    call @printf("\nOriginal:   ")
    call @print_hex(%ptp, 64)
    call @printf("\n")

    %dec_ok = call @cmp(%pt2_p, %ptp, 64)
    br %dec_ok, @pass, @fail_dec

  @pass:
    call @printf("PASS\n")
    ret i32 0

  @fail_enc:
    call @printf("FAIL: encrypt mismatch\n")
    ret i32 1

  @fail_dec:
    call @printf("FAIL: decrypt mismatch\n")
    ret i32 2
}
