// TLS 1.3 record interop vector.
//
// The record below was produced by an independent AES-128-GCM implementation
// (Python cryptography / OpenSSL) with:
//   key = 0x2A * 16, iv = 0x11 * 12, sequence = 1
//   AAD = outer type 23 || 0x0303 || ciphertext length 36
// so it verifies our nonce construction, AAD length, and tag handling
// against a third-party implementation.

extern @printf(fmt: *i8, ...) -> i32
extern @memcmp(a: *i8, b: *i8, n: i64) -> i32
extern @memset(s: *i8, c: i32, n: i64) -> *i8

extern @net_socket_tcp() -> i32
extern @net_socket_bind(fd: i32, port: i32) -> i32
extern @net_socket_listen(fd: i32) -> i32
extern @net_socket_accept(fd: i32) -> i32
extern @net_socket_connect(fd: i32, port: i32) -> i32
extern @net_socket_close(fd: i32) -> i32
extern @net_socket_send(fd: i32, buf: *i8, len: i32) -> i32

extern @tls13_record_decrypt(fd: i32, seq: *i64, k: *i8, iv: *i8, ks: i32,
                             b: *i8, c: i32, ot: *i8, ol: *i32) -> i32

// header(5) || ciphertext(21, including the inner type) || tag(16)
const @REC: [i8, 42] = [
  23, 3, 3, 0, 37, 127, 161, 63, 20, 22, 157, 84, 204, 87, 101, 168,
  145, 99, 125, 13, 117, 221, 71, 85, 86, 93, 187, 166, 35, 129, 135, 190,
  231, 5, 65, 59, 134, 45, 124, 173, 108, 10
]

const @PLAIN: [i8, 20] = [
  105, 110, 116, 101, 114, 111, 112, 32, 116, 101, 115, 116, 32, 112, 97, 121,
  108, 111, 97, 100
]

fun @main() -> i32 {
  @entry:
    %id = let i32
    store i32 0, *%id
    %srv = call @net_socket_tcp()
    %srv_ok = sge i32 %srv, 0
    br %srv_ok, @bind, @fail
  @bind:
    store i32 1, *%id
    %b0 = call @net_socket_bind(%srv, 8835)
    %b_ok = eq i32 %b0, 0
    br %b_ok, @listen, @fail
  @listen:
    store i32 2, *%id
    %l0 = call @net_socket_listen(%srv)
    %l_ok = eq i32 %l0, 0
    br %l_ok, @connect, @fail
  @connect:
    store i32 3, *%id
    %cli = call @net_socket_tcp()
    %c0 = call @net_socket_connect(%cli, 8835)
    %c_ok = eq i32 %c0, 0
    br %c_ok, @accept, @fail
  @accept:
    store i32 4, *%id
    %sock = call @net_socket_accept(%srv)
    %s_ok = sge i32 %sock, 0
    br %s_ok, @send, @fail
  @send:
    store i32 5, *%id
    %rp = gep i8, *@REC, 0
    %sn = call @net_socket_send(%cli, %rp, 42)
    %sn_ok = eq i32 %sn, 42
    br %sn_ok, @recv, @fail
  @recv:
    store i32 6, *%id
    %key = let [i8, 16]
    %keyp = gep i8, *%key, 0
    call @memset(%keyp, 0x2A, 16)
    %iv = let [i8, 12]
    %ivp = gep i8, *%iv, 0
    call @memset(%ivp, 0x11, 12)
    %seq = let i64
    store i64 1, *%seq
    %buf = let [i8, 256]
    %bufp = gep i8, *%buf, 0
    %typ = let i8
    %typp = gep i8, *%typ, 0
    %olen = let i32
    %olenp = gep i32, *%olen, 0
    %r = call @tls13_record_decrypt(%sock, %seq, %keyp, %ivp, 16, %bufp, 256,
                                    %typp, %olenp)
    %r_ok = eq i32 %r, 0
    br %r_ok, @check, @fail
  @check:
    store i32 7, *%id
    %tv = load i8, *%typp
    %t_ok = eq i8 %tv, 23
    %lv = load i32, *%olen
    %len_ok = eq i32 %lv, 20
    %cm = call @memcmp(%bufp, @PLAIN, 20)
    %cm_ok = eq i32 %cm, 0
    %a = and i1 %t_ok, %len_ok
    %b = and i1 %a, %cm_ok
    br %b, @pass, @fail

  @pass:
    call @net_socket_close(%cli)
    call @net_socket_close(%sock)
    call @net_socket_close(%srv)
    call @printf("PASS tls13_record_vector\n")
    ret i32 0
  @fail:
    %cid = load i32, *%id
    call @printf("FAIL tls13_record_vector at case %d\n", %cid)
    ret i32 1
}
