// Echo server — listens on port 8888, echoes back received data

extern @putchar(c: i32) -> i32

// Socket externs — direct C function names from libplatform.a
extern @c1_socket_create(domain: i32, type: i32, protocol: i32) -> i32
extern @c1_socket_bind(fd: i32, port: i32) -> i32
extern @c1_socket_listen(fd: i32, backlog: i32) -> i32
extern @c1_socket_accept(fd: i32) -> i32
extern @c1_socket_send(fd: i32, buf: *i8, len: i32) -> i32
extern @c1_socket_recv(fd: i32, buf: *i8, len: i32) -> i32
extern @c1_socket_close(fd: i32) -> i32

fun @main() -> i32 {
  @entry:
    // Create TCP socket
    %fd = call @c1_socket_create(2, 1, 0)
    %neg = slt i32 %fd, 0
    br %neg, @fail, @do_bind

  @do_bind:
    call @putchar(66)   // 'B' = bind
    %r1 = call @c1_socket_bind(%fd, 8888)
    %bneg = slt i32 %r1, 0
    br %bneg, @fail, @do_listen

  @do_listen:
    call @putchar(76)   // 'L' = listen
    %r2 = call @c1_socket_listen(%fd, 5)
    %lneg = slt i32 %r2, 0
    br %lneg, @fail, @do_accept

  @do_accept:
    call @putchar(65)   // 'A' = accept
    %cfd = call @c1_socket_accept(%fd)
    %aneg = slt i32 %cfd, 0
    br %aneg, @fail, @do_recv

  @do_recv:
    call @putchar(82)   // 'R' = recv
    %buf = let [i8, 256]
    %bp = gep i8, *%buf, 0
    %n = call @c1_socket_recv(%cfd, %bp, 256)
    %nneg = slt i32 %n, 0
    br %nneg, @fail, @do_send

  @do_send:
    call @putchar(69)   // 'E' = echo (send back)
    %buf2 = let [i8, 256]
    %bp2 = gep i8, *%buf2, 0
    // Copy received data to send buffer (this is a simplified echo)
    // We reuse the same buffer via gep
    %buf_r = gep i8, *%buf, 0
    %sent = call @c1_socket_send(%cfd, %buf_r, %n)
    %sneg = slt i32 %sent, 0
    br %sneg, @fail, @do_close

  @do_close:
    call @putchar(67)   // 'C' = close
    call @c1_socket_close(%cfd)
    call @c1_socket_close(%fd)
    call @putchar(10)   // newline
    ret i32 0

  @fail:
    call @putchar(33)   // '!'
    call @putchar(10)   // newline
    ret i32 1
}
